@page
@model MyIdsModel
@{
    ViewData["Title"] = Loc["Ids_Title"];
    ViewData["ActivePage"] = ManageNavPages.MyIds;
}

<header class="mb-4">
    <h2 class="h4 fw-bold text-primary-drmc mb-2">@Loc["Ids_Title"]</h2>
    <p class="text-muted mb-0">@Loc["Ids_Description"]</p>
</header>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Loc[Model.StatusMessage]</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Loc[Model.ErrorMessage]</div>
}

<details class="card rounded-4 p-3 p-md-4 mb-4" open="@(!ViewData.ModelState.IsValid || !string.IsNullOrWhiteSpace(Model.ErrorMessage))">
    <summary class="h5 fw-bold text-primary-drmc mb-0">@Loc["Ids_AddTitle"]</summary>
    <form id="walletUploadForm" method="post" asp-page-handler="SaveId" enctype="multipart/form-data" class="mt-3"
          data-extract-url="@Url.Page("MyIds", "ExtractId")"
          data-scan-error="@Loc["Ids_ScanFailed"]" data-photo-required="@Loc["Ids_PhotoRequired"]"
          data-scan-working="@Loc["Ids_ScanWorking"]" data-scan-complete="@Loc["Ids_ScanComplete"]"
          data-saving="@Loc["Ids_Saving"]" data-select-type="@Loc["IdCamera_SelectType"]"
          data-save-error="@Loc["Ids_SaveError"]" data-uncertain-save="@Loc["Ids_UncertainSave"]">
        <p class="text-muted small">@Loc["Ids_AddDescription"]</p>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input type="hidden" asp-for="Input.TempFrontPhotoToken" id="walletTempFrontToken" />
        <input type="hidden" asp-for="Input.TempBackPhotoToken" id="walletTempBackToken" />
        <input type="hidden" asp-for="Input.ScanReceipt" id="walletScanReceipt" />

        <div class="mb-3">
            <label asp-for="Input.IdType" for="walletIdType" class="form-label fw-semibold">@Loc["Ids_IdType"]</label>
            <select asp-for="Input.IdType" id="walletIdType" class="form-select" required>
                <option value="">@Loc["Ids_ChooseType"]</option>
                @foreach (var id in DrmcPatientPortal.Models.PhilippineIdTypes.All)
                {
                    <option value="@id.Name" data-back="@id.NeedsBackPhoto.ToString().ToLowerInvariant()">@id.Name</option>
                }
            </select>
            <span asp-validation-for="Input.IdType" class="text-danger"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.FrontPhoto" for="walletFrontPhoto" class="form-label fw-semibold">@Loc["Ids_FrontPhoto"]</label>
                <input asp-for="Input.FrontPhoto" id="walletFrontPhoto" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" aria-describedby="walletPhotoHelp" />
                <button type="button" id="walletFrontCamera" class="btn btn-outline-drmc mt-2"><i class="bi bi-camera me-1" aria-hidden="true"></i>@Loc["IdCamera_Scan"]</button>
                <img id="walletFrontPreview" alt="@Loc["Ids_FrontPhoto"]" class="img-fluid rounded-3 border mt-2" style="max-height:180px" hidden />
            </div>
            <div class="col-md-6" id="walletBackCapture" hidden>
                <label asp-for="Input.BackPhoto" for="walletBackPhoto" class="form-label fw-semibold">@Loc["Ids_BackPhoto"]</label>
                <input asp-for="Input.BackPhoto" id="walletBackPhoto" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" aria-describedby="walletPhotoHelp" />
                <button type="button" id="walletBackCamera" class="btn btn-outline-drmc mt-2"><i class="bi bi-camera me-1" aria-hidden="true"></i>@Loc["IdCamera_Scan"]</button>
                <img id="walletBackPreview" alt="@Loc["Ids_BackPhoto"]" class="img-fluid rounded-3 border mt-2" style="max-height:180px" hidden />
            </div>
        </div>
        <p id="walletPhotoHelp" class="form-text">@Loc["Ids_PhotoHelp"]</p>
        <div class="d-flex gap-2 flex-wrap align-items-center mb-2">
            <button type="button" class="btn btn-outline-drmc" id="walletScanButton" disabled>@Loc["Ids_ScanDetails"]</button>
            <button type="button" class="btn btn-outline-secondary" id="walletCancelScan" hidden>@Loc["Ids_CancelScan"]</button>
        </div>
        <p id="walletScanStatus" class="small" role="status" aria-live="polite"></p>
        <p class="small text-muted">@Loc["Ids_ReviewHint"]</p>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.LastName" for="walletLastName" class="form-label">@Loc["Ids_LastName"]</label>
                <input asp-for="Input.LastName" id="walletLastName" class="form-control" maxlength="60" autocomplete="family-name" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.FirstName" for="walletFirstName" class="form-label">@Loc["Ids_FirstName"]</label>
                <input asp-for="Input.FirstName" id="walletFirstName" class="form-control" maxlength="60" autocomplete="given-name" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.MiddleName" for="walletMiddleName" class="form-label">@Loc["Ids_MiddleName"]</label>
                <input asp-for="Input.MiddleName" id="walletMiddleName" class="form-control" maxlength="60" autocomplete="additional-name" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Suffix" for="walletSuffix" class="form-label">@Loc["Ids_Suffix"]</label>
                <input asp-for="Input.Suffix" id="walletSuffix" class="form-control" maxlength="10" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.DateOfBirth" for="walletDateOfBirth" class="form-label">@Loc["Ids_DateOfBirth"]</label>
                <input asp-for="Input.DateOfBirth" id="walletDateOfBirth" class="form-control" type="date" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.IdNumber" for="walletIdNumber" class="form-label">@Loc["Ids_IDNumber"]</label>
                <input asp-for="Input.IdNumber" id="walletIdNumber" class="form-control" maxlength="40" autocomplete="off" />
            </div>
            <div class="col-12">
                <label asp-for="Input.Address" for="walletAddress" class="form-label">@Loc["Ids_Address"]</label>
                <input asp-for="Input.Address" id="walletAddress" class="form-control" maxlength="200" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Sex" for="walletSex" class="form-label">@Loc["Ids_Sex"]</label>
                <input asp-for="Input.Sex" id="walletSex" class="form-control" maxlength="20" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.BloodType" for="walletBloodType" class="form-label">@Loc["Ids_BloodType"]</label>
                <input asp-for="Input.BloodType" id="walletBloodType" class="form-control" maxlength="10" />
            </div>
        </div>
        <button type="submit" class="btn btn-drmc mt-3" id="walletSaveButton">@Loc["Ids_Save"]</button>
        <a asp-page="MyIds" class="btn btn-outline-secondary mt-3" id="walletReload" hidden>@Loc["Ids_Reload"]</a>
    </form>
</details>

@if (Model.Documents.Count == 0)
{
    <div class="id-wallet-empty text-center rounded-4 p-4 p-md-5">
        <i class="bi bi-person-vcard" aria-hidden="true"></i>
        <h3 class="h5 fw-bold mt-3">@Loc["Ids_EmptyTitle"]</h3>
        <p class="text-muted mb-0">@Loc["Ids_EmptyDescription"]</p>
    </div>
}
else
{
    <div class="id-wallet-list">
        @foreach (var document in Model.Documents)
        {
            var cardId = $"id-card-{document.Id}";
            var frontUrl = document.HasFrontPhoto
                ? Url.Action("IdPhoto", "PatientDocuments", new { id = document.Id, side = "front" })
                : null;
            var backUrl = document.HasBackPhoto
                ? Url.Action("IdPhoto", "PatientDocuments", new { id = document.Id, side = "back" })
                : null;

            <article class="id-wallet-entry rounded-4" aria-labelledby="@cardId-title">
                <div class="id-wallet-heading">
                    <span class="id-wallet-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
                    <div class="min-w-0">
                        <p class="small text-muted mb-1">@document.Issuer</p>
                        <h3 class="h5 fw-bold mb-0" id="@cardId-title">@document.IdType</h3>
                    </div>
                </div>

                @if (document.HasFrontPhoto)
                {
                    <div class="id-card-stage" id="@cardId" data-id-card>
                        <div class="id-card-rotator">
                            <figure class="id-card-face id-card-front mb-0">
                                <img src="@frontUrl" alt="Front of @document.IdType" loading="lazy" />
                                <figcaption>@Loc["Ids_Front"]</figcaption>
                            </figure>
                            @if (document.HasBackPhoto)
                            {
                                <figure class="id-card-face id-card-back mb-0">
                                    <img src="@backUrl" alt="Back of @document.IdType" loading="lazy" />
                                    <figcaption>@Loc["Ids_Back"]</figcaption>
                                </figure>
                            }
                        </div>
                    </div>

                    <div class="id-wallet-controls" aria-label="ID image controls">
                        <button type="button" class="btn btn-outline-drmc" data-id-flip data-show-back="@Loc["Ids_ShowBack"]" data-show-front="@Loc["Ids_ShowFront"]" aria-controls="@cardId" aria-pressed="false" @(!document.HasBackPhoto ? "disabled" : null)>
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                            <span>@(document.HasBackPhoto ? Loc["Ids_ShowBack"] : Loc["Ids_FrontOnly"])</span>
                        </button>
                        <button type="button" class="btn btn-outline-drmc" data-id-zoom data-front-url="@frontUrl" data-back-url="@backUrl" data-id-title="@document.IdType">
                            <i class="bi bi-zoom-in" aria-hidden="true"></i> @Loc["Ids_ViewLarger"]
                        </button>
                    </div>
                }
                else
                {
                    <div class="id-image-unavailable rounded-4">
                        <i class="bi bi-image" aria-hidden="true"></i>
                        <div>
                            <strong>@Loc["Ids_NoImage"]</strong>
                            <span>@Loc["Ids_NoImageDescription"]</span>
                        </div>
                    </div>
                }

                <dl class="id-wallet-details mb-0">
                    <div>
                        <dt>@Loc["Ids_IDNumber"]</dt>
                        <dd>
                            <span data-id-number data-masked-number="@document.MaskedIdNumber" data-full-number="@document.IdNumber">@document.MaskedIdNumber</span>
                            @if (!string.IsNullOrWhiteSpace(document.IdNumber))
                            {
                                <button type="button" class="id-number-toggle" data-id-number-toggle data-show-text="@Loc["Ids_Show"]" data-hide-text="@Loc["Ids_Hide"]" aria-pressed="false">@Loc["Ids_Show"]</button>
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@Loc["Ids_RecordSource"]</dt>
                        <dd>@(document.IsManualEntry ? Loc["Ids_SourceManual"] : Loc["Ids_SourceVerified"])</dd>
                    </div>
                    @if (document.CapturedAt.HasValue)
                    {
                        <div>
                            <dt>@Loc["Ids_Added"]</dt>
                            <dd>@document.CapturedAt.Value.ToLocalTime().ToString("MMMM d, yyyy")</dd>
                        </div>
                    }
                </dl>
            </article>
        }
    </div>
}

<dialog class="id-zoom-dialog" id="idZoomDialog" aria-labelledby="idZoomTitle">
    <div class="id-zoom-shell">
        <header class="id-zoom-header">
            <div>
                <p class="small mb-1">@Loc["Ids_SecurePreview"]</p>
                <h3 class="h5 fw-bold mb-0" id="idZoomTitle">@Loc["Ids_Image"]</h3>
            </div>
            <button type="button" class="btn-close" data-id-zoom-close aria-label="@Loc["Ids_ClosePreview"]"></button>
        </header>
        <div class="id-zoom-toolbar" aria-label="Zoom controls">
            <button type="button" class="btn btn-light" data-id-zoom-out aria-label="@Loc["Ids_ZoomOut"]"><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
            <output data-id-zoom-level aria-live="polite">100%</output>
            <button type="button" class="btn btn-light" data-id-zoom-in aria-label="@Loc["Ids_ZoomIn"]"><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-light" data-id-zoom-reset>@Loc["Ids_Reset"]</button>
            <button type="button" class="btn btn-outline-light ms-auto" data-id-zoom-side data-show-back="@Loc["Ids_ShowBack"]" data-show-front="@Loc["Ids_ShowFront"]" hidden><i class="bi bi-arrow-repeat" aria-hidden="true"></i> @Loc["Ids_ShowBack"]</button>
        </div>
        <div class="id-zoom-viewport" tabindex="0" role="region" aria-label="@Loc["Ids_Image"]">
            <img src="" alt="" data-id-zoom-image />
        </div>
        <p class="small text-white-50 text-center mb-0">@Loc["Ids_ZoomInstruction"]</p>
    </div>
</dialog>

<partial name="_IdCameraModal" />

@section Scripts {
    <script src="~/js/id-camera.js" asp-append-version="true"></script>
    <script src="~/js/id-wallet.js" asp-append-version="true"></script>
}
