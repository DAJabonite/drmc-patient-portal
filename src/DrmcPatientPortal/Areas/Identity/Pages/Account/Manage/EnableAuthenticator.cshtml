@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure Authenticator App";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-bold text-primary-drmc mb-3">@ViewData["Title"]</h2>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success rounded-4 mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.StatusMessage
    </div>
}

<p class="text-muted small">
    To use an authenticator app (such as Google Authenticator, Microsoft Authenticator, or Apple Keychain), follow these simple steps:
</p>

<ol class="list-group list-group-numbered mb-4 shadow-xs rounded-4">
    <li class="list-group-item p-3 border-0 bg-light">
        <span class="fw-semibold text-dark">Download a TOTP Authenticator app:</span>
        <div class="small text-muted mt-1">
            Install <strong>Microsoft Authenticator</strong> or <strong>Google Authenticator</strong> on your mobile phone.
        </div>
    </li>
    <li class="list-group-item p-3 border-0 bg-light">
        <span class="fw-semibold text-dark">Scan the QR code or enter the key manually:</span>
        <div class="row g-4 align-items-center mt-2">
            <div class="col-md-5 text-center">
                <div class="p-3 bg-white border rounded-4 d-inline-block shadow-xs">
                    @Html.Raw(Model.QrCodeSvg)
                </div>
            </div>
            <div class="col-md-7">
                <div class="p-3 bg-white border rounded-3 small">
                    <span class="text-muted d-block mb-1">Manual Setup Key (if scanning fails):</span>
                    <kbd class="fs-6 user-select-all bg-dark text-white px-2 py-1 rounded">@Model.SharedKey</kbd>
                    <span class="d-block text-muted mt-2" style="font-size:0.75rem;">Spaces and hyphens do not matter.</span>
                </div>
            </div>
        </div>
    </li>
    <li class="list-group-item p-3 border-0 bg-light">
        <span class="fw-semibold text-dark">Enter the 6-digit code generated by your app:</span>
        <div class="mt-3" style="max-width: 380px;">
            <form id="send-code" method="post">
                <div class="mb-3">
                    <label asp-for="Input.Code" class="form-label small fw-semibold text-dark"></label>
                    <input asp-for="Input.Code" class="form-control form-control-lg text-center fw-bold letter-spacing-2 rounded-3" autocomplete="off" placeholder="000000" maxlength="7" />
                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                    <i class="bi bi-shield-check me-1"></i> Verify &amp; Activate 2FA
                </button>
                <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold ms-2">Cancel</a>
            </form>
        </div>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
