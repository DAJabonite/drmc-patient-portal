@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Save Your Recovery Codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-bold text-primary-drmc mb-3">@ViewData["Title"]</h2>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success rounded-4 mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i> @Model.StatusMessage
    </div>
}

<div class="card border-0 bg-light rounded-4 p-4 mb-4">
    <div class="d-flex align-items-start gap-3">
        <div class="p-3 rounded-circle bg-primary-subtle text-primary-drmc">
            <i class="bi bi-shield-lock fs-3" aria-hidden="true"></i>
        </div>
        <div>
            <h3 class="h6 fw-bold text-dark mb-1">Store these codes somewhere safe</h3>
            <p class="small text-muted mb-0">
                Save all ten codes in a password manager or another private, secure place. If you lose access to your authenticator app, use one of these codes after entering your email and password.
            </p>
        </div>
    </div>
</div>

<div class="alert alert-warning rounded-4 small mb-4" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
    These codes are only shown once. Each code can be used once. Keep them private and do not share them with anyone.
</div>

<ul class="row row-cols-1 row-cols-sm-2 g-3 list-unstyled mb-4" aria-label="Your recovery codes">
    @foreach (var code in Model.RecoveryCodes!)
    {
        <li class="col">
            <code class="d-block text-center p-3 bg-light border rounded-3 text-primary-drmc fs-6 user-select-all" data-recovery-code>@code</code>
        </li>
    }
</ul>

<a asp-page="./TwoFactorAuthentication" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
    <i class="bi bi-check-lg me-1" aria-hidden="true"></i> Back to 2FA Settings
</a>
