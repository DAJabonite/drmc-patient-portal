@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate Recovery Codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-bold text-primary-drmc mb-3">@ViewData["Title"]</h2>

<div class="card border-0 bg-light rounded-4 p-4 mb-4">
    <div class="d-flex align-items-start gap-3">
        <div class="p-3 rounded-circle bg-primary-subtle text-primary-drmc">
            <i class="bi bi-key fs-3" aria-hidden="true"></i>
        </div>
        <div>
            <h3 class="h6 fw-bold text-dark mb-1">Keep a backup way to sign in</h3>
            <p class="small text-muted mb-0">
                Recovery codes let you sign in if your authenticator app is unavailable. You will receive ten codes to save privately, and each code works once.
            </p>
        </div>
    </div>
</div>

@if (Model.RecoveryCodesLeft > 0)
{
    <div class="alert alert-warning rounded-4 small mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        Generating a new set replaces all your previous recovery codes, including the @Model.RecoveryCodesLeft you have left.
        Your authenticator app will continue to work.
    </div>
}

<form method="post" class="d-flex gap-2 flex-wrap">
    <button type="submit" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
        <i class="bi bi-key me-1" aria-hidden="true"></i>
        @(Model.RecoveryCodesLeft == 0 ? "Generate Recovery Codes" : "Generate New Recovery Codes")
    </button>
    <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancel</a>
</form>
