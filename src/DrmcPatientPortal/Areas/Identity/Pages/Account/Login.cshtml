@page
@model LoginModel

@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-page">
    <div class="container">
        <div class="auth-card">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold text-primary-drmc mb-0">Sign in</h1>
            </div>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope" aria-hidden="true"></i></span>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" aria-required="true" />
                    </div>
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Input.Password" for="loginPassword" class="form-label mb-0">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-lock" aria-hidden="true"></i></span>
                        <input asp-for="Input.Password" class="form-control" id="loginPassword" type="password" autocomplete="current-password" placeholder="Enter your password" aria-required="true" />
                        <button class="btn btn-outline-secondary pw-toggle" type="button" aria-controls="loginPassword" aria-pressed="false" aria-label="Show password">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check mb-0">
                        <input class="form-check-input" asp-for="Input.RememberMe" id="loginRemember" />
                        <label class="form-check-label small text-muted" for="loginRemember">Keep me signed in</label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="small fw-semibold text-primary-drmc text-decoration-none hover-underline">
                        Forgot password?
                    </a>
                </div>

                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-drmc fw-bold py-2">Sign in</button>
                </div>
            </form>

            <div class="text-center mt-3">
                <a asp-page="./ResendEmailConfirmation" asp-route-returnUrl="@Model.ReturnUrl" class="small">@Loc["Login_ResendConfirmation"]</a>
            </div>

            <div class="auth-divider my-4" aria-hidden="true"></div>

            <div class="text-center">
                <p class="mb-0 text-muted">
                    New to the portal? <a asp-page="./Register" asp-route-returnUrl="@Url.Content("~/Patient/Home")" class="fw-semibold text-primary-drmc">Create an account</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}
