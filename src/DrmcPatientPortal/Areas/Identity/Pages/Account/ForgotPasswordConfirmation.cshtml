@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = Loc["Verification_CheckEmailTitle"];
}

<section class="auth-page auth-verification-page">
    <div class="container">
        <div class="auth-card auth-verification-card" aria-labelledby="verificationHeading">
            <partial name="_EmailVerificationHeading" model='new EmailVerificationHeading("Verification_CheckEmailTitle", "Verification_RequestReceived", "bi-envelope-check")' />
            <p class="auth-verification-copy" role="status">@Loc["PasswordReset_RequestReceivedBody"]</p>
            <h2>@Loc["Verification_WhatNext"]</h2>
            <p class="auth-verification-copy">@Loc["PasswordReset_InboxHelp"]</p>
            <a class="btn btn-drmc auth-verification-action" asp-page="./Login">
                @Loc["Verification_BackToSignIn"] <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <div class="auth-verification-secondary">
                <a asp-page="./ForgotPassword">@Loc["PasswordReset_RequestAnotherLink"]</a>
            </div>
            <div class="auth-verification-help">
                <h2>@Loc["Verification_CannotFindEmail"]</h2>
                <p>@Loc["Verification_SpamHelp"]</p>
            </div>
        </div>
        <p class="auth-verification-trust"><i class="bi bi-shield-check" aria-hidden="true"></i> @Loc["Verification_PortalName"]</p>
    </div>
</section>
