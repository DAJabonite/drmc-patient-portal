@page
@model RegisterModel
@{
    ViewData["Title"] = "Create an account";
}

<div class="auth-page">
    <div class="container">
        <div class="auth-card">
            <a class="d-inline-flex align-items-center gap-2 mb-3 text-decoration-none" asp-controller="Home" asp-action="Index">
                <img src="~/images/drmc-seal.png" alt="" style="height:40px;width:auto;" />
                <span class="fw-semibold text-primary-drmc">Davao Regional Medical Center</span>
            </a>
            <h2>Create an account</h2>
            <p class="auth-subtitle">Join the DRMC patient portal to view your care information.</p>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label">Full name</label>
                    <input asp-for="Input.FullName" class="form-control" autocomplete="name" aria-required="true" />
                    <span asp-validation-for="Input.FullName" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ContactNumber" class="form-label">Contact number</label>
                    <input asp-for="Input.ContactNumber" class="form-control" autocomplete="tel" aria-required="true" />
                    <span asp-validation-for="Input.ContactNumber" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                    <div class="form-text" id="password-hint">At least 8 characters, with an uppercase, lowercase, number, and symbol.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                    <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-drmc">Create account</button>
            </form>

            <p class="mt-3 mb-0 small text-muted">
                Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Url.Content("~/Patient/Home")">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
