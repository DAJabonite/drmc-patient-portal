@page
@model RegisterModel
@{
    ViewData["Title"] = "Create your account";
}

<div class="auth-page registration-page py-4">
    <div class="container" style="max-width: 860px;">
        <div class="auth-card auth-card-wide shadow-sm rounded-4 p-4 p-md-5 bg-white border-0">
            <!-- Header Lockup -->
            <div class="text-center mb-4">
                <a class="d-inline-flex align-items-center gap-2 mb-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                    <img src="~/images/drmc-seal.png" alt="DRMC Seal" style="height:48px;width:auto;" />
                    <span class="fw-bold fs-5 text-primary-drmc">Davao Regional Medical Center</span>
                </a>
                <h1 class="h3 fw-bold text-primary-drmc mb-1">Create your patient account</h1>
                <p class="text-muted small mb-0">Fast, verified registration with Philippine Government ID scan-to-autofill.</p>
            </div>

            <ol class="registration-stepper mb-4" id="wizardStepperNav" aria-label="Registration progress">
                <li class="is-current" aria-current="step"><span class="wizard-step-btn" id="stepBtn1">1</span><span id="stepLabel1">ID selection</span></li>
                <li><span class="wizard-step-btn" id="stepBtn2">2</span><span id="stepLabel2">ID photo</span></li>
                <li><span class="wizard-step-btn" id="stepBtn3">3</span><span id="stepLabel3">Review &amp; edit</span></li>
                <li><span class="wizard-step-btn" id="stepBtn4">4</span><span id="stepLabel4">Credentials</span></li>
            </ol>

            <!-- Main Multi-Step Form -->
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" novalidate data-server-errors="@(!ViewData.ModelState.IsValid ? "true" : "false")">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert" tabindex="-1" id="registrationErrors"></div>
                <input type="hidden" asp-for="Input.PrivacyConsent" id="privacyConsentValue" />
                <fieldset id="registrationFields" disabled>
                <legend class="visually-hidden">Patient account details</legend>

                <!-- Hidden inputs for token and metadata -->
                <input type="hidden" asp-for="Input.TempFrontPhotoToken" id="tempFrontToken" />
                <input type="hidden" asp-for="Input.TempBackPhotoToken" id="tempBackToken" />
                <input type="hidden" asp-for="Input.OcrConfidence" id="ocrConfidence" value="0" />
                <input type="hidden" asp-for="Input.IsManualEntry" id="isManualEntry" value="false" />

                <!-- ========================================== -->
                <!-- STEP 1: ID TYPE PICKER & METHOD SELECTION -->
                <!-- ========================================== -->
                <div class="wizard-step" id="wizardStep1">
                    <div id="stepFeedback1" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
                    <div class="mb-4">
                        <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill fw-semibold mb-2">
                            Step 1 of 4 &middot; Verification Document
                        </span>
                        <h2 class="h5 fw-bold text-dark mb-1">Select your Philippine Government ID</h2>
                        <p class="small text-muted mb-3">Choose the valid government ID you will use for account verification and autofill.</p>

                        <div class="mb-3">
                            <label asp-for="Input.IdType" for="selectIdType" class="form-label fw-semibold">Valid government ID</label>
                            <select asp-for="Input.IdType" id="selectIdType" class="form-select form-select-lg">
                                <option value="" disabled selected>Choose your ID type...</option>
                                <option value="Philippine National ID (PhilSys)" data-back="true">Philippine National ID (PhilSys)</option>
                                <option value="Driver's License" data-back="false">Driver's License</option>
                                <option value="Philippine Passport" data-back="false">Philippine Passport</option>
                                <option value="UMID" data-back="false">UMID</option>
                                <option value="Postal ID" data-back="false">Postal ID</option>
                                <option value="PhilHealth ID" data-back="false">PhilHealth ID</option>
                                <option value="SSS / GSIS ID" data-back="false">SSS / GSIS ID</option>
                                <option value="PRC ID" data-back="false">PRC ID</option>
                            </select>
                            <span asp-validation-for="Input.IdType" class="field-validation-error"></span>
                        </div>

                        <!-- Dynamic ID Guidance Notice Card -->
                        <div id="idGuidanceCard" class="card border-0 bg-light rounded-3 p-3 mb-4 d-none">
                            <div class="d-flex align-items-start gap-3">
                                <div class="p-2 rounded-circle bg-primary-subtle text-primary-drmc d-inline-flex" style="flex-shrink:0;">
                                    <i class="bi bi-card-heading fs-4"></i>
                                </div>
                                <div>
                                    <h3 class="h6 fw-bold text-dark mb-1" id="guidanceTitle">ID Guidance</h3>
                                    <p class="small text-muted mb-1" id="guidanceText">Framing advice will appear here.</p>
                                    <div class="small text-primary-drmc fw-semibold" id="guidanceSupports"></div>
                                </div>
                            </div>
                        </div>

                        <div class="registration-actions pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary fw-semibold" id="btnManualSkip">
                                <i class="bi bi-pencil-square me-1"></i> Enter details manually
                            </button>
                            <button type="button" class="btn btn-primary-drmc fw-semibold" id="btnGoToCapture" disabled>
                                Continue to photo <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- STEP 2: NATIVE CAMERA / FILE CAPTURE       -->
                <!-- ========================================== -->
                <div class="wizard-step d-none" id="wizardStep2">
                    <div id="stepFeedback2" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
                    <div class="mb-4">
                        <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill fw-semibold mb-2">
                            Step 2 of 4 &middot; Camera Capture
                        </span>
                        <h2 class="h5 fw-bold text-dark mb-1">Photograph your ID card</h2>
                        <p class="small text-muted mb-3">Take a clear photo with your phone camera or upload an existing image. Avoid glare and ensure text is in focus.</p>

                        <!-- Selected ID banner -->
                        <div class="alert alert-info py-2 px-3 rounded-3 d-flex align-items-center justify-content-between mb-4">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-shield-check fs-5 text-primary-drmc"></i>
                                <span class="small fw-semibold text-dark" id="displaySelectedId">ID Selected</span>
                            </div>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none text-primary-drmc fw-bold p-0" id="btnChangeIdType">Change ID</button>
                        </div>

                        <div class="row g-3 mb-3">
                            <!-- Front Photo Card -->
                            <div class="col-md-6" id="frontCaptureCol">
                                <div class="card border-2 border-dashed rounded-4 p-3 text-center h-100 bg-light" id="frontDropCard">
                                    <h3 class="h6 fw-bold text-dark mb-2">Front of ID card</h3>
                                    
                                    <!-- Preview Area -->
                                    <div id="frontPreviewContainer" class="d-none mb-3">
                                        <img id="frontPreviewImg" src="" alt="Front ID preview" class="img-fluid rounded-3 border shadow-xs" style="max-height: 180px; object-fit: contain;" />
                                        <div class="mt-2 small text-success fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Photo ready
                                        </div>
                                    </div>

                                    <!-- Placeholder / Capture CTA -->
                                    <div id="frontPlaceholder" class="py-4">
                                        <div class="p-3 rounded-circle bg-white shadow-xs d-inline-flex text-primary-drmc mb-2">
                                            <i class="bi bi-camera-fill fs-2"></i>
                                        </div>
                                        <p class="small text-muted mb-0">Take photo or browse</p>
                                    </div>

                                    <div class="mt-auto pt-2">
                                        <label for="frontPhotoInput" class="btn btn-outline-drmc rounded-pill px-3 fw-semibold w-100" id="frontInputLabel" role="button" tabindex="0" aria-controls="frontPhotoInput">
                                            <i class="bi bi-camera me-1"></i> Snap / Select Front
                                        </label>
                                        <input type="file" id="frontPhotoInput" asp-for="Input.FrontPhoto" accept="image/*" capture="environment" class="visually-hidden" tabindex="-1" />
                                    </div>
                                </div>
                            </div>

                            <!-- Back Photo Card (Conditional for PhilSys/back-needed IDs) -->
                            <div class="col-md-6 d-none" id="backCaptureCol">
                                <div class="card border-2 border-dashed rounded-4 p-3 text-center h-100 bg-light" id="backDropCard">
                                    <h3 class="h6 fw-bold text-dark mb-2">Back of ID card</h3>
                                    
                                    <!-- Preview Area -->
                                    <div id="backPreviewContainer" class="d-none mb-3">
                                        <img id="backPreviewImg" src="" alt="Back ID preview" class="img-fluid rounded-3 border shadow-xs" style="max-height: 180px; object-fit: contain;" />
                                        <div class="mt-2 small text-success fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Photo ready
                                        </div>
                                    </div>

                                    <!-- Placeholder / Capture CTA -->
                                    <div id="backPlaceholder" class="py-4">
                                        <div class="p-3 rounded-circle bg-white shadow-xs d-inline-flex text-primary-drmc mb-2">
                                            <i class="bi bi-camera-fill fs-2"></i>
                                        </div>
                                        <p class="small text-muted mb-0">Sex &amp; blood type on back</p>
                                    </div>

                                    <div class="mt-auto pt-2">
                                        <label for="backPhotoInput" class="btn btn-outline-drmc rounded-pill px-3 fw-semibold w-100" id="backInputLabel" role="button" tabindex="0" aria-controls="backPhotoInput">
                                            <i class="bi bi-camera me-1"></i> Snap / Select Back
                                        </label>
                                        <input type="file" id="backPhotoInput" asp-for="Input.BackPhoto" accept="image/*" capture="environment" class="visually-hidden" tabindex="-1" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- OCR Processing Spinner Area -->
                        <div id="ocrProcessingState" class="d-none text-center py-4 bg-light rounded-4 my-3">
                            <div class="spinner-border text-primary-drmc mb-2" role="status">
                                <span class="visually-hidden">Scanning...</span>
                            </div>
                            <h4 class="h6 fw-bold text-dark mb-1">Reading ID Information...</h4>
                            <p class="small text-muted mb-0">Analyzing structured document fields locally in offline mode.</p>
                        </div>

                        <div class="registration-actions pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary fw-semibold" id="btnBackToStep1">
                                <i class="bi bi-arrow-left me-1"></i> Back
                            </button>
                            <div class="registration-action-group">
                                <button type="button" class="btn btn-outline-secondary fw-semibold" id="btnManualSkipFromStep2">
                                    Manual Entry
                                </button>
                                <button type="button" class="btn btn-primary-drmc fw-semibold" id="btnTriggerOcr" disabled>
                                    <i class="bi bi-magic me-1"></i> Scan ID
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- STEP 3: REVIEW & EDIT EXTRACTED FIELDS     -->
                <!-- ========================================== -->
                <div class="wizard-step d-none" id="wizardStep3">
                    <div id="stepFeedback3" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
                    <div class="mb-4">
                        <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill fw-semibold mb-2">
                            Step 3 of 4 &middot; Review Information
                        </span>
                        <h2 class="h5 fw-bold text-dark mb-1">Review &amp; confirm extracted details</h2>
                        <p class="small text-muted mb-3">Please verify every field below. You can freely edit or complete any information before continuing.</p>

                        <!-- Autofill Confirmation Alert -->
                        <div id="autofillNotice" class="alert alert-success py-2 px-3 rounded-3 d-flex align-items-center gap-2 mb-3 d-none">
                            <i class="bi bi-check2-circle fs-5 text-success"></i>
                            <span class="small fw-semibold text-dark">Fields have been pre-filled from your document. Please verify each entry for accuracy.</span>
                        </div>

                        <div class="row g-3">
                            <!-- Names -->
                            <div class="col-md-4">
                                <label asp-for="Input.FirstName" for="txtFirstName" class="form-label fw-semibold">First name</label>
                                <input asp-for="Input.FirstName" id="txtFirstName" class="form-control" autocomplete="given-name" placeholder="Juan" />
                                <span asp-validation-for="Input.FirstName" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.MiddleName" for="txtMiddleName" class="form-label fw-semibold">Middle name <span class="fw-normal text-muted">(optional)</span></label>
                                <input asp-for="Input.MiddleName" id="txtMiddleName" class="form-control" autocomplete="additional-name" placeholder="Santos" />
                                <span asp-validation-for="Input.MiddleName" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Input.LastName" for="txtLastName" class="form-label fw-semibold">Last name</label>
                                <input asp-for="Input.LastName" id="txtLastName" class="form-control" autocomplete="family-name" placeholder="Dela Cruz" />
                                <span asp-validation-for="Input.LastName" class="field-validation-error"></span>
                            </div>

                            <!-- ID Number -->
                            <div class="col-md-6">
                                <label asp-for="Input.IdNumber" for="txtIdNumber" class="form-label fw-semibold">ID number</label>
                                <input asp-for="Input.IdNumber" id="txtIdNumber" class="form-control" placeholder="As printed on your card" />
                                <span asp-validation-for="Input.IdNumber" class="field-validation-error"></span>
                            </div>

                            <!-- Date of Birth -->
                            <div class="col-md-6">
                                <label asp-for="Input.DateOfBirth" for="txtDob" class="form-label fw-semibold">Date of birth <span class="fw-normal text-muted">(optional)</span></label>
                                <input asp-for="Input.DateOfBirth" id="txtDob" type="date" class="form-control" />
                                <span asp-validation-for="Input.DateOfBirth" class="field-validation-error"></span>
                            </div>

                            <!-- Sex -->
                            <div class="col-md-6">
                                <label asp-for="Input.Sex" for="txtSex" class="form-label fw-semibold">Sex <span class="fw-normal text-muted">(optional)</span></label>
                                <select asp-for="Input.Sex" id="txtSex" class="form-select">
                                    <option value="">Select sex...</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Input.Sex" class="field-validation-error"></span>
                            </div>

                            <!-- Blood Type -->
                            <div class="col-md-6">
                                <label asp-for="Input.BloodType" for="txtBloodType" class="form-label fw-semibold">Blood type <span class="fw-normal text-muted">(optional)</span></label>
                                <select asp-for="Input.BloodType" id="txtBloodType" class="form-select">
                                    <option value="">Select blood type...</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                                <span asp-validation-for="Input.BloodType" class="field-validation-error"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="Input.Address" for="txtAddress" class="form-label fw-semibold">Residential address <span class="fw-normal text-muted">(optional)</span></label>
                                <input asp-for="Input.Address" id="txtAddress" class="form-control" placeholder="House/Unit No., Street, Barangay, City/Municipality, Province" />
                                <span asp-validation-for="Input.Address" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="registration-actions pt-4 border-top mt-4">
                            <button type="button" class="btn btn-outline-secondary fw-semibold" id="btnBackToStep2">
                                <i class="bi bi-arrow-left me-1"></i> Back
                            </button>
                            <button type="button" class="btn btn-primary-drmc fw-semibold" id="btnGoToStep4">
                                Continue to security <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ========================================== -->
                <!-- STEP 4: CREDENTIALS & PRIVACY CONSENT      -->
                <!-- ========================================== -->
                <div class="wizard-step d-none" id="wizardStep4">
                    <div id="stepFeedback4" class="alert alert-danger d-none" role="alert" tabindex="-1"></div>
                    <div class="mb-4">
                        <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill fw-semibold mb-2">
                            Step 4 of 4 &middot; Account Security &amp; Consent
                        </span>
                        <h2 class="h5 fw-bold text-dark mb-1">Set up your login credentials</h2>
                        <p class="small text-muted mb-3">Provide your email address, Philippine mobile number, and a strong password.</p>

                        <div class="row g-3">
                            <!-- Email & Mobile -->
                            <div class="col-md-6">
                                <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
                                <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" placeholder="you@example.com" />
                                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.Mobile" class="form-label fw-semibold">Mobile number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted fw-semibold">+63</span>
                                    <input asp-for="Input.Mobile" class="form-control" inputmode="numeric" autocomplete="tel-national" placeholder="9175550123" />
                                </div>
                                <span asp-validation-for="Input.Mobile" class="field-validation-error"></span>
                                <div class="form-text small text-muted">10-digit number starting with 9 (e.g. 9171234567).</div>
                            </div>

                            <!-- Passwords -->
                            <div class="col-md-6">
                                <label asp-for="Input.Password" for="regPassword" class="form-label fw-semibold">Password</label>
                                <div class="input-group">
                                    <input asp-for="Input.Password" class="form-control" type="password" id="regPassword" autocomplete="new-password" placeholder="At least 8 characters" />
                                    <button class="btn btn-outline-secondary pw-toggle" type="button" aria-controls="regPassword" aria-pressed="false" aria-label="Show password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
                                <div class="form-text small text-muted">Must include uppercase, lowercase, number, and symbol.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmPassword" for="regConfirmPassword" class="form-label fw-semibold">Confirm password</label>
                                <div class="input-group">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" type="password" id="regConfirmPassword" autocomplete="new-password" placeholder="Re-enter your password" />
                                    <button class="btn btn-outline-secondary pw-toggle" type="button" aria-controls="regConfirmPassword" aria-pressed="false" aria-label="Show password">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
                            </div>

                            <div class="col-12 mt-3">
                                <div class="registration-consent-summary p-3 rounded-3 bg-light border">
                                    <p class="small mb-1"><i class="bi bi-check-circle me-1" aria-hidden="true"></i> Privacy notice and portal terms accepted.</p>
                                    <button type="button" class="btn btn-link p-0 text-primary-drmc" id="reviewConsent">Review privacy and terms</button>
                                </div>
                                <span asp-validation-for="Input.PrivacyConsent" class="field-validation-error"></span>
                            </div>
                        </div>

                        <div class="registration-actions pt-4 border-top mt-4">
                            <button type="button" class="btn btn-outline-secondary fw-semibold" id="btnBackToStep3">
                                <i class="bi bi-arrow-left me-1"></i> Back to Review
                            </button>
                            <button id="registerSubmit" type="submit" class="btn btn-drmc fw-semibold">
                                <i class="bi bi-check-circle-fill me-1"></i> Create account
                            </button>
                        </div>
                    </div>
                </div>

                </fieldset>

                <!-- Sign in link footer -->
                <div class="text-center mt-4 pt-2 border-top">
                    <p class="small text-muted mb-0">
                        Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Url.Content("~/Patient/Home")" class="fw-semibold text-primary-drmc">Sign in</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal registration-consent" id="registrationConsent" tabindex="-1" aria-labelledby="consentTitle" aria-describedby="consentHint" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header d-block">
                <h2 class="modal-title h4" id="consentTitle">Before you create an account</h2>
                <p class="small text-muted mb-0" id="consentHint">Scroll to the end of the privacy notice and portal terms to enable the agreement checkbox.</p>
            </div>
            <div class="modal-body" id="consentDocument" tabindex="0" role="region" aria-label="Privacy notice and portal terms">
                <h3 class="h5 text-primary-drmc">Data privacy notice</h3>
                <partial name="_PrivacyNotice" />
                <partial name="_PortalTerms" />
                <p class="fw-semibold mb-0" id="consentEnd">End of privacy notice and portal terms.</p>
            </div>
            <div class="modal-footer d-block">
                <p class="small text-muted mb-2" id="consentReadStatus" role="status">Scroll to the end to continue.</p>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="regConsent" disabled aria-describedby="consentReadStatus" />
                    <label class="form-check-label small" for="regConsent">I agree to the portal terms and consent to the data processing described in the privacy notice.</label>
                </div>
                <div class="registration-actions">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary" id="leaveRegistration">Leave signup</a>
                    <button type="button" class="btn btn-primary-drmc" id="acceptConsent" disabled>Agree and continue</button>
                </div>
            </div>
        </div>
    </div>
</div>
<noscript><p class="container alert alert-info">Signup requires JavaScript to guide you through the form. You can <a asp-controller="Home" asp-action="Privacy">read the privacy notice and portal terms</a> without JavaScript.</p></noscript>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registration.js" asp-append-version="true"></script>

}
