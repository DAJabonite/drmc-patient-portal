@page
@model ForgotPasswordModel
@{ ViewData["Title"] = "Reset your password"; }
<section class="auth-page">
    <div class="container"><div class="auth-card">
        <h1 class="h3">Reset your password</h1>
        <p>Enter your email address to request a password-reset link.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" maxlength="256" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
            <button type="submit" class="btn btn-drmc mt-3">Send reset link</button>
        </form>
        <a asp-page="./Login" class="d-inline-block mt-3">Back to sign in</a>
    </div></div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
