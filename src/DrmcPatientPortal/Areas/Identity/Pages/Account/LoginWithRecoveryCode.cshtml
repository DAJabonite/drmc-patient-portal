@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Sign in with a recovery code";
    var returnUrl = Model.ReturnUrl ?? Model.Request.Query["returnUrl"].ToString();
    returnUrl = Url.IsLocalUrl(returnUrl) ? returnUrl : Url.Content("~/Patient/Home");
}

<section class="auth-page">
    <div class="container">
        <div class="auth-card" aria-labelledby="recoveryHeading">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold text-primary-drmc mb-2" id="recoveryHeading">Sign in with a recovery code</h1>
                <p class="small text-muted mb-0">Enter one of the recovery codes you saved when setting up two-factor authentication.</p>
            </div>

            <form method="post" asp-route-returnUrl="@returnUrl">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="Input.RecoveryCode" class="form-label">Recovery code</label>
                    <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Enter recovery code" aria-describedby="recoveryCodeHelp" />
                    <span asp-validation-for="Input.RecoveryCode" class="field-validation-error"></span>
                    <div class="form-text small text-muted" id="recoveryCodeHelp">Each code can be used only once.</div>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-drmc fw-bold py-2">Sign in</button>
            </form>

            <div class="text-center mt-3">
                <a asp-page="./LoginWith2fa" asp-route-returnUrl="@returnUrl" class="small fw-semibold text-primary-drmc">Use authenticator app instead</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
