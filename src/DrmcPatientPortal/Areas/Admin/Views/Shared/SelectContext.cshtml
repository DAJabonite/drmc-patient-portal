@model AdminList
@{ ViewData["Title"] = Model.Title; var action = ViewData["ContextAction"]?.ToString() ?? "Create"; }
<section class="container py-4">
    <h1 class="h3">@Model.Title</h1>
    <form method="get" class="d-flex gap-2 my-3"><label for="search" class="visually-hidden">Search</label><input id="search" name="search" value="@Model.Search" maxlength="450" class="form-control" type="search" /><button class="btn btn-outline-primary" aria-label="Search" title="Search"><i class="bi bi-search" aria-hidden="true"></i></button></form>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Record</th><th>Context</th><th></th></tr></thead><tbody>
    @foreach (var row in Model.Rows) { <tr><td class="text-break">@row.Label</td><td class="text-break">@row.Summary</td><td>
        @if (action == "Index") { <a asp-area="Admin" asp-action="Index" asp-route-contextId="@row.Id" class="btn btn-outline-primary" aria-label="Select" title="Select"><i class="bi bi-check-lg" aria-hidden="true"></i></a> }
        else { <a asp-area="Admin" asp-action="Create" asp-route-id="@row.Id" class="btn btn-outline-primary" aria-label="Select" title="Select"><i class="bi bi-check-lg" aria-hidden="true"></i></a> }
    </td></tr> }
    </tbody></table></div>
    @if (Model.Total == 0) { <p>No records found.</p> }
    <nav class="d-flex justify-content-between align-items-center" aria-label="Record pages"><a asp-area="Admin" asp-action="@action" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary @(Model.Page == 1 ? "disabled" : "")" aria-label="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></a><span>Page @Model.Page of @Model.Pages</span><a asp-area="Admin" asp-action="@action" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary @(Model.Page == Model.Pages ? "disabled" : "")" aria-label="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></a></nav>
</section>
