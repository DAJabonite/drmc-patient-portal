@model AdminForm
@{ ViewData["Title"] = "Edit " + Model.Title; var indexContext = ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? null : Model.Context?.RouteId; }
<div class="admin-page-header">
    <div>
        <h1 class="admin-title">Edit @Model.Title <span class="admin-id fs-6">#@Model.Id</span></h1>
    </div>
</div>
@if (Model.Context is not null) { <partial name="_Context" model="Model.Context" /> }
<form asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="@(Model.Input is LabInput or LabUploadInput or PublicAdvisoryInput ? "multipart/form-data" : null)" class="admin-card admin-form">
    <div class="admin-card-body">
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
        <partial name="@Model.FormPartial" model="Model.Input" />
    </div>
    <div class="admin-form-actions">
        <a asp-area="Admin" asp-action="Index" asp-route-contextId="@indexContext" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Save changes</button>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
