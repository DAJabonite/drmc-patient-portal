@model PhysicianForm
@{ var source = Model.Prefix + "PhysicianSource"; var directory = Model.Prefix + "DirectoryDoctorId"; var historical = Model.Prefix + "HistoricalDoctorName"; }
<div class="row g-3">
    <div class="col-md-4"><label for="@source" class="form-label">@Loc["Rx_PhysicianSource"]</label><select id="@source" name="@source" class="form-select"><option value="0" selected="@(Model.Input.PhysicianSource == PhysicianSource.Directory)">@Loc["Rx_Directory"]</option><option value="1" selected="@(Model.Input.PhysicianSource == PhysicianSource.HistoricalName)">@Loc["Rx_HistoricalName"]</option></select></div>
    <div class="col-md-8"><label for="@directory" class="form-label">@Loc["Rx_DirectoryPhysician"]</label><select id="@directory" name="@directory" class="form-select"><option value="">@Loc["Rx_NotSpecified"]</option>@foreach (var doctor in Model.Doctors) { <option value="@doctor.Value" selected="@(Model.Input.DirectoryDoctorId?.ToString() == doctor.Value)">@doctor.Text</option> }</select></div>
    <div class="col-12"><label for="@historical" class="form-label">@Loc["Rx_HistoricalPhysician"]</label><input id="@historical" name="@historical" value="@Model.Input.HistoricalDoctorName" maxlength="100000" class="form-control" /></div>
</div>
