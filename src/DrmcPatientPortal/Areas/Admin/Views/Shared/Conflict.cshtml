@{ ViewData["Title"] = "Record conflict"; }
<div class="admin-card">
    <div class="admin-empty">
        <span class="admin-empty-icon"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span>
        <h1 class="h5 fw-bold">Record conflict</h1>
        <p role="alert">This record changed or was deleted by another staff member. Reload the list to review the current records.</p>
        <a asp-area="Admin" asp-action="Index" class="btn btn-primary">Back to list</a>
    </div>
</div>
