@model OwnershipContext
<div class="admin-context text-break">
    <span class="admin-module-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
    <span><span class="admin-context-label">Patient #@Model.Patient.Id</span><strong>@Model.Patient.FullName</strong></span>
    <span><span class="admin-context-label">Hospital number</span>@(string.IsNullOrEmpty(Model.Patient.HospitalNumber) ? "Unassigned" : Model.Patient.HospitalNumber)</span>
    <span><span class="admin-context-label">Parent record</span>@Model.Label</span>
</div>
