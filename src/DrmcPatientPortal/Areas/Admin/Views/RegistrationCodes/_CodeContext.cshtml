@model PatientRecord
<div class="admin-context text-break">
    <span class="admin-module-icon"><i class="bi bi-person-vcard" aria-hidden="true"></i></span>
    <span><span class="admin-context-label">Patient #@Model.Id</span><strong>@Model.FullName</strong></span>
    <span><span class="admin-context-label">Hospital number</span>@(string.IsNullOrEmpty(Model.HospitalNumber) ? "Unassigned" : Model.HospitalNumber)</span>
</div>
