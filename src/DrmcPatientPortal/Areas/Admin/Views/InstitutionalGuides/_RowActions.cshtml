<div class="btn-group" role="group" aria-label="Reorder or remove item">
    <button type="button" class="btn btn-sm btn-outline-secondary" data-guide-up aria-label="Move item up">↑</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-guide-down aria-label="Move item down">↓</button>
    <button type="button" class="btn btn-sm btn-outline-danger" data-guide-remove aria-label="Remove item">Remove</button>
</div>
