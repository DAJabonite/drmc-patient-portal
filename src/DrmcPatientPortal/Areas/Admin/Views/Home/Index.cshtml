@model AdminDashboard
@{ ViewData["Title"] = "Dashboard"; }
<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Overview</p>
        <h1 class="admin-title">Administration</h1>
        <p class="admin-subtitle">Work that needs attention across patient records, public content and imports.</p>
    </div>
    @if (Model.Counts.ContainsKey("Imports") || Model.Counts.ContainsKey("Patients"))
    {
        <div class="admin-page-actions">
            @if (Model.Counts.ContainsKey("Imports")) { <a asp-area="Admin" asp-controller="Imports" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-upload me-1" aria-hidden="true"></i>Import data</a> }
            @if (Model.Counts.ContainsKey("Patients")) { <a asp-area="Admin" asp-controller="Patients" asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1" aria-hidden="true"></i>Add patient</a> }
        </div>
    }
</div>

<section aria-labelledby="attention-heading">
    <h2 id="attention-heading" class="visually-hidden">Needs attention</h2>
    <div class="admin-metrics">
        @foreach (var metric in Model.Attention)
        {
            <a asp-area="Admin" asp-controller="@metric.Controller" asp-action="Index" class="admin-card admin-metric @(metric.Attention ? "is-attention" : null)">
                <span class="admin-metric-top"><span class="admin-metric-label">@metric.Label</span><span class="admin-metric-icon"><i class="bi @metric.Icon" aria-hidden="true"></i></span></span>
                <span class="admin-metric-value">@metric.Value.ToString("N0")</span>
                <span class="admin-metric-hint">@metric.Hint</span>
            </a>
        }
    </div>
</section>

@foreach (var navGroup in Model.Sections.Where(section => section.Label != "Overview"))
{
    <section aria-label="@navGroup.Label">
        <div class="admin-section-title"><h2>@navGroup.Label</h2></div>
        <div class="admin-modules">
            @foreach (var item in navGroup.Items)
            {
                <a asp-area="Admin" asp-controller="@item.Controller" asp-action="Index" class="admin-card admin-module">
                    <span class="admin-module-icon"><i class="bi @item.Icon" aria-hidden="true"></i></span>
                    <span>
                        <span class="admin-module-name">@item.Label @if (Model.Counts.TryGetValue(item.Controller, out var count)) { <span class="admin-module-count tabular">@count.ToString("N0")</span> }</span>
                        <span class="admin-module-desc d-block">@item.Description</span>
                    </span>
                </a>
            }
        </div>
    </section>
}

@if (Model.Counts.ContainsKey("Audit") || Model.Counts.ContainsKey("Imports"))
{
<div class="row g-3">
    <div class="col-xl-7">
        <section class="admin-card h-100" aria-labelledby="audit-heading">
            <div class="admin-card-header"><h2 id="audit-heading" class="admin-card-title">Recent staff activity</h2><a asp-area="Admin" asp-controller="Audit" asp-action="Index" class="small">View all</a></div>
            @if (Model.RecentAudit.Count == 0)
            {
                <div class="admin-empty"><span class="admin-empty-icon"><i class="bi bi-journal-text" aria-hidden="true"></i></span><h2>No activity yet</h2><p>Staff changes appear here as they happen.</p></div>
            }
            else
            {
                <ul class="admin-feed">
                    @foreach (var entry in Model.RecentAudit)
                    {
                        <li>
                            <span class="admin-feed-dot" aria-hidden="true"></span>
                            <span class="min-w-0 text-break">
                                <a asp-area="Admin" asp-controller="Audit" asp-action="Details" asp-route-id="@entry.Id" class="fw-semibold text-decoration-none">@entry.Action</a>
                                <span>@entry.Entity @if (entry.RecordKey == "Index") { <span class="admin-muted">list</span> } else { <span class="admin-id">#@entry.RecordKey</span> }</span>
                                <span class="admin-feed-meta d-block">@entry.ActorEmail · <time datetime="@entry.TimestampUtc.ToString("O")">@entry.TimestampUtc.ToString("yyyy-MM-dd HH:mm") UTC</time></span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
    <div class="col-xl-5">
        <section class="admin-card h-100" aria-labelledby="imports-heading">
            <div class="admin-card-header"><h2 id="imports-heading" class="admin-card-title">Recent imports</h2><a asp-area="Admin" asp-controller="Imports" asp-action="Index" class="small">View all</a></div>
            @if (Model.RecentImports.Count == 0)
            {
                <div class="admin-empty"><span class="admin-empty-icon"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i></span><h2>No imports yet</h2><p>Upload a CSV or Excel workbook to stage records.</p><a asp-area="Admin" asp-controller="Imports" asp-action="Index" class="btn btn-sm btn-outline-primary">Go to imports</a></div>
            }
            else
            {
                <ul class="admin-feed">
                    @foreach (var batch in Model.RecentImports)
                    {
                        <li class="justify-content-between align-items-center">
                            <span><a asp-area="Admin" asp-controller="Imports" asp-action="Details" asp-route-id="@batch.Id" class="fw-semibold text-decoration-none">@batch.Template</a><span class="admin-feed-meta d-block tabular">@batch.RowCount rows · @batch.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</span></span>
                            @{ var status = ((IReadOnlyDictionary<Guid, DrmcPatientPortal.Areas.Admin.Services.ImportStatusDisplay>)ViewData["ImportStatuses"]!)[batch.Id]; }
                            <span class="@status.Css">@status.Text</span>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>
}
