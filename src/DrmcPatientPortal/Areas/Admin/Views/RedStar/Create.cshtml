@model RedStarEnrollmentInput
@{ ViewData["Title"] = "Add Red Star enrollment"; var patientId = ViewData["PatientId"] as int? ?? 0; }
<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h3 mb-1">Add Red Star enrollment</h1><p class="text-muted mb-0">Create a private clinic record or add a program for an existing patient.</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Registry</a>
</div>
<partial name="_Status" />
<div class="card"><div class="card-body p-4">
    <form asp-action="Create" asp-route-patientId="@patientId" method="post" autocomplete="off">
        <partial name="_EnrollmentForm" model="Model" />
        <button type="submit" class="btn btn-primary">Create enrollment</button>
    </form>
</div></div>
@section Scripts {
    <script src="~/js/redstar-enrollment.js" asp-append-version="true"></script>
}
