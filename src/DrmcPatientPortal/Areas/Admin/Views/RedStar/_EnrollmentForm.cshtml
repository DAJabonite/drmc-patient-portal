@model RedStarEnrollmentInput
@{ var existing = ViewData["PatientId"] is int patientId && patientId > 0; }
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
<input asp-for="PatientVersion" type="hidden" />
<input asp-for="EnrollmentVersion" type="hidden" />
<fieldset class="mb-4">
    <legend class="h5">Private patient identity</legend>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="PatientCode" class="form-label">Patient code</label><input asp-for="PatientCode" class="form-control" readonly="@existing" /></div>
        <div class="col-md-6"><label asp-for="CodeName" class="form-label">Code name</label><input asp-for="CodeName" class="form-control" readonly="@existing" /></div>
        <div class="col-md-6"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" readonly="@existing" autocomplete="off" /></div>
        <div class="col-md-6"><label asp-for="HospitalNumber" class="form-label">Hospital number (optional)</label><input asp-for="HospitalNumber" class="form-control" readonly="@existing" /></div>
        <div class="col-md-6"><label asp-for="ContactNumber" class="form-label">Contact number (optional)</label><input asp-for="ContactNumber" class="form-control" readonly="@existing" autocomplete="off" /></div>
        <div class="col-md-6"><label asp-for="Address" class="form-label">Address (optional)</label><input asp-for="Address" class="form-control" readonly="@existing" autocomplete="off" /></div>
    </div>
</fieldset>
<fieldset class="mb-4">
    <legend class="h5">Program and care</legend>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="Program" class="form-label">Program</label><select asp-for="Program" asp-items="Html.GetEnumSelectList<RedStarProgram>()" class="form-select"></select></div>
        <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<RedStarStatus>()" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="EnrolledDate" class="form-label">Enrolled date</label><input asp-for="EnrolledDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="StartDate" class="form-label">Treatment / program start</label><input asp-for="StartDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="StatusDate" class="form-label">Status change date</label><input asp-for="StatusDate" type="date" class="form-control" /></div>
        <div class="col-12"><label asp-for="ReceivingHub" class="form-label">Receiving hub (for transfer out)</label><input asp-for="ReceivingHub" class="form-control" /></div>
        <div class="col-12"><label asp-for="Medicines" class="form-label">Medicines and staff instructions</label><textarea asp-for="Medicines" rows="3" class="form-control"></textarea><div class="form-text">Use the patient's prescribed treatment information. Refill dates are approved separately from the days of supply.</div></div>
    </div>
</fieldset>
