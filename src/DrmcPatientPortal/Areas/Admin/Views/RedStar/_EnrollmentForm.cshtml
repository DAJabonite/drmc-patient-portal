@model RedStarEnrollmentInput
@using DrmcPatientPortal.Services
@using System.Text.Json
@{
    var existing = ViewData["PatientId"] is int patientId && patientId > 0;
    var selectedSheet = RedStarRegistryLayout.Find(Model.WorksheetLayout)
        ?? RedStarRegistryLayout.Find(RedStarRegistryLayout.SheetFor(Model.Program, Model.Status))!;
    var optionalFields = new[] { "Address", "HospitalNumber", "CodeName", "EnrolledDate", "StartDate", "ContactNumber", "Medicines" };
}
<div data-redstar-enrollment>
    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
    <input asp-for="PatientVersion" type="hidden" />
    <input asp-for="EnrollmentVersion" type="hidden" />
    <div class="border rounded-3 bg-light p-3 mb-4">
        <label for="redstar-worksheet" class="form-label">Worksheet layout</label>
        <select id="redstar-worksheet" name="WorksheetLayout" class="form-select" data-registry-worksheet aria-describedby="redstar-worksheet-help redstar-worksheet-description">
            @foreach (var sheet in RedStarRegistryLayout.Sheets)
            {
                <option value="@sheet.Name" selected="@(sheet.Name == selectedSheet.Name)" data-columns="@JsonSerializer.Serialize(sheet.Columns)">@sheet.Name</option>
            }
        </select>
        <span asp-validation-for="WorksheetLayout" class="text-danger"></span>
        <p id="redstar-worksheet-help" class="form-text mb-2">Choose a tab from the staff workbook to match its headings and field order. Your entries are kept when you switch. Verify the program and treatment status separately.</p>
        <p id="redstar-worksheet-description" class="small mb-0" data-registry-description role="status" aria-live="polite">Following the @selectedSheet.Name worksheet's supported column order.</p>
    </div>
    <p class="small text-muted mb-4">Refill dates are recorded in appointments and dispensing after enrollment. Other saved portal fields follow the selected worksheet's fields.</p>
    <fieldset class="mb-4">
        <legend class="h5">Registry fields</legend>
        <div class="row g-3" data-registry-fields>
            @foreach (var column in selectedSheet.Columns)
            {
                <div class="@(column.Field == "Medicines" ? "col-12" : "col-md-6")" data-registry-field="@column.Field">
                    @if (column.Field is "DispensedDate" or "NextRefillDate")
                    {
                        <h3 class="h6 mb-2" data-registry-header>@column.Header</h3>
                        <p class="form-text mb-0">@(column.Field == "DispensedDate" ? "Recorded in dispensing history after enrollment." : "Scheduled in appointments after enrollment.")</p>
                    }
                    else
                    {
                        <label for="@column.Field" class="form-label"><span data-registry-header>@column.Header</span>@if (optionalFields.Contains(column.Field)) { <span class="small text-muted"> (optional)</span> }</label>
                        @switch (column.Field)
                        {
                            case "FullName":
                                <input asp-for="FullName" class="form-control" readonly="@existing" autocomplete="off" />
                                break;
                            case "Address":
                                <input asp-for="Address" class="form-control" readonly="@existing" autocomplete="off" />
                                break;
                            case "HospitalNumber":
                                <input asp-for="HospitalNumber" class="form-control" readonly="@existing" />
                                break;
                            case "PatientCode":
                                <input asp-for="PatientCode" class="form-control" readonly="@existing" />
                                break;
                            case "CodeName":
                                <input asp-for="CodeName" class="form-control" readonly="@existing" />
                                break;
                            case "EnrolledDate":
                                <input asp-for="EnrolledDate" type="date" class="form-control" />
                                break;
                            case "StartDate":
                                <input asp-for="StartDate" type="date" class="form-control" />
                                break;
                            case "ContactNumber":
                                <input asp-for="ContactNumber" class="form-control" readonly="@existing" autocomplete="off" />
                                break;
                            case "Medicines":
                                <textarea asp-for="Medicines" rows="3" class="form-control"></textarea>
                                <div class="form-text">Use the patient's prescribed treatment information. Refill dates are approved separately from the days of supply.</div>
                                break;
                            case "Status":
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<RedStarStatus>()" class="form-select"></select>
                                break;
                            case "Program":
                                <select asp-for="Program" asp-items="Html.GetEnumSelectList<RedStarProgram>()" class="form-select"></select>
                                break;
                            case "StatusDate":
                                <input asp-for="StatusDate" type="date" class="form-control" />
                                <div class="form-text">Required for transferred, discontinued, completed or deceased status.</div>
                                break;
                            case "ReceivingHub":
                                <input asp-for="ReceivingHub" class="form-control" />
                                <div class="form-text">Required for transferred-out status.</div>
                                break;
                        }
                    }
                </div>
            }
        </div>
    </fieldset>
</div>
