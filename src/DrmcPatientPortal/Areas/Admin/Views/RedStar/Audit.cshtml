@model RedStarAuditPage
@using DrmcPatientPortal.Services
@{ ViewData["Title"] = "Red Star access history"; var pages = Math.Max(1, (Model.Total + 24) / 25); }
<div class="d-flex justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3">Private access history</h1><p class="text-muted mb-0">Clinic access and changes, without clinical values.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Registry</a></div>
<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th scope="col">Time (Philippines)</th><th scope="col">Actor account ID</th><th scope="col">Action</th><th scope="col">Subject</th></tr></thead><tbody>
@foreach (var row in Model.Rows) { <tr><td>@ClinicalClock.WallTime(row.TimestampUtc).ToString("dd MMM yyyy HH:mm")</td><td class="text-break">@row.ActorId</td><td>@row.Action</td><td>@row.Subject</td></tr> }
@if (Model.Rows.Count == 0) { <tr><td colspan="4" class="text-muted p-4">No private access history yet.</td></tr> }
</tbody></table></div></div>
<nav aria-label="Access history pages" class="d-flex justify-content-between align-items-center mt-3"><span class="small text-muted">@Model.Total events · page @Model.Page of @pages</span><div class="d-flex gap-2">
@if (Model.Page > 1) { <a asp-action="Audit" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary btn-sm">Previous</a> }
@if (Model.Page < pages) { <a asp-action="Audit" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary btn-sm">Next</a> }
</div></nav>
