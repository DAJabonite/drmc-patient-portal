@model RedStarDeliveriesPage
@using DrmcPatientPortal.Services
@{ ViewData["Title"] = "Red Star reminders"; var pages = Math.Max(1, (Model.Total + 24) / 25); }
<div class="d-flex justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3">Reminder delivery</h1><p class="text-muted mb-0">Private delivery status and retry counts. Message contents and email addresses are omitted.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Registry</a></div>
<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th scope="col">Patient code</th><th scope="col">Scheduled date</th><th scope="col">Stage</th><th scope="col">Channel</th><th scope="col">Status</th><th scope="col">Attempts</th><th scope="col">Created (Philippines)</th><th scope="col">Completed</th></tr></thead><tbody>
@foreach (var row in Model.Rows) { <tr><td>@row.PatientCode</td><td>@row.DueDate.ToString("dd MMM yyyy")</td><td>@row.Stage</td><td>@row.Channel</td><td>@row.State</td><td>@row.Attempts</td><td>@ClinicalClock.WallTime(row.CreatedUtc).ToString("dd MMM yyyy HH:mm")</td><td>@(row.CompletedUtc.HasValue ? ClinicalClock.WallTime(row.CompletedUtc.Value).ToString("dd MMM yyyy HH:mm") : "—")</td></tr> }
@if (Model.Rows.Count == 0) { <tr><td colspan="8" class="text-muted p-4">No reminder deliveries yet.</td></tr> }
</tbody></table></div></div>
<nav aria-label="Reminder pages" class="d-flex justify-content-between align-items-center mt-3"><span class="small text-muted">@Model.Total reminders · page @Model.Page of @pages</span><div class="d-flex gap-2">
@if (Model.Page > 1) { <a asp-action="Deliveries" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary btn-sm">Previous</a> }
@if (Model.Page < pages) { <a asp-action="Deliveries" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary btn-sm">Next</a> }
</div></nav>
