@model RadiologyInput
@{
    var creating = ViewContext.RouteData.Values["action"]?.ToString() == "Create";
    var recordId = ViewData["RecordId"] as int?;
}
<input asp-for="RowVersion" type="hidden" />
<fieldset class="border rounded-3 p-3 mb-3">
    <legend class="h6 float-none w-auto px-2">Official radiology report</legend>
    @if (!creating)
    {
        if (ViewData["HasReport"] is true)
        {
            <p class="small">Current PDF: @ViewData["ReportSize"] bytes · uploaded @(((DateTime?)ViewData["ReportUploadedAtUtc"])?.ToString("yyyy-MM-dd HH:mm")) UTC</p>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <a asp-action="PreviewReport" asp-route-id="@recordId" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">View PDF</a>
                <a asp-action="PreviewReport" asp-route-id="@recordId" asp-route-download="true" class="btn btn-outline-primary btn-sm">Download PDF</a>
            </div>
        }
        else { <p class="small">No PDF attached.</p> }
    }
    <label asp-for="Report" class="form-label"></label>
    <input asp-for="Report" type="file" accept=".pdf,application/pdf" class="form-control" aria-describedby="radiologyReportHelp" required="@creating" />
    <span asp-validation-for="Report" class="text-danger"></span>
    <p id="radiologyReportHelp" class="small text-muted mt-2 mb-0">PDF only, up to 10 MiB.@if (!creating) { <text> Leave blank to keep the current report.</text> }</p>
</fieldset>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="PerformedAt" class="form-label"></label><input asp-for="PerformedAt" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /><span asp-validation-for="PerformedAt" class="text-danger"></span></div>
    <div class="col-md-6">
        <label asp-for="Modality" class="form-label"></label>
        <select asp-for="Modality" class="form-select">
            @foreach (var modality in Enum.GetValues<RadiologyModality>())
            {
                <option value="@modality">@modality.PdfDisplayName()</option>
            }
        </select>
        <span asp-validation-for="Modality" class="text-danger"></span>
    </div>
    <div class="col-md-6"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<RadiologyStatus>()" class="form-select" aria-describedby="radiologyStatusHelp"></select><div id="radiologyStatusHelp" class="form-text">Final and Amended need an attached PDF and a release time.</div><span asp-validation-for="Status" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="ReleasedAt" class="form-label"></label><input asp-for="ReleasedAt" type="datetime-local" step="any" class="form-control" aria-describedby="radiologyReleaseHelp" /><div id="radiologyReleaseHelp" class="form-text">Patients can access a released PDF from this time, subject to the hospital's disclosure setting.</div><span asp-validation-for="ReleasedAt" class="text-danger"></span></div>
</div>
<details class="mt-3" open="@(Model.Status == RadiologyStatus.Amended)">
    <summary class="form-label">Amendment note (required for Amended)</summary>
    <label asp-for="AmendmentNote" class="visually-hidden"></label>
    <textarea asp-for="AmendmentNote" class="form-control mt-2" rows="2" maxlength="2000"></textarea>
    <span asp-validation-for="AmendmentNote" class="text-danger"></span>
</details>
