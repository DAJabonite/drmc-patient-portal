@model ImportIndex
@using DrmcPatientPortal.Areas.Admin.Services
@{ ViewData["Title"] = "Imports"; var pages = Math.Max(1, (Model.Total + 24) / 25); var statuses = (IReadOnlyDictionary<Guid, ImportStatusDisplay>)ViewData["ImportStatuses"]!; }
<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Operations</p>
        <h1 class="admin-title">Imports</h1>
        <p class="admin-subtitle">Upload a completed template, review it, then approve the import.</p>
    </div>
</div>
@if (TempData["ImportMessage"] is string message) { <div class="alert alert-warning" role="alert">@message</div> }
<div class="row g-3 mb-3">
    <div class="col-12">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="admin-card admin-form h-100">
            <div class="admin-card-header"><h2 class="admin-card-title">Upload</h2><span class="admin-chip admin-chip-info admin-chip-plain">Step 1 of 4</span></div>
            <div class="admin-card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label for="template" class="form-label">Template</label><select id="template" name="Template" class="form-select" required><option value="Workbook_v1">Workbook v1 (.xlsx)</option>@foreach (var template in ImportTemplates.All) { <option value="@template.Sheet">@template.Sheet (.csv)</option> }</select></div>
                    <div class="col-md-6"><label for="file" class="form-label">File</label><input id="file" name="File" type="file" accept=".csv,.xlsx" class="form-control" required /></div>
                </div>
            </div>
            <div class="admin-form-actions"><button class="btn btn-primary" type="submit"><i class="bi bi-upload me-1" aria-hidden="true"></i>Upload</button></div>
        </form>
    </div>
    <div class="col-12">
        <div class="admin-card h-100">
            <div class="admin-card-header"><h2 class="admin-card-title">Templates</h2></div>
            <div class="admin-card-body">
                <p class="small text-muted mb-3">Each template has five sample rows. Replace or remove them before importing. Keep headers and sheet names unchanged.</p>
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h3 class="h6 mb-1">Excel workbook</h3>
                        <p class="small text-muted mb-0">All templates in one file, with related records linked within the batch.</p>
                    </div>
                    <a asp-action="Template" asp-route-name="Workbook_v1" class="btn btn-sm btn-outline-primary"><i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>Download XLSX</a>
                </div>
                <details class="border-top pt-3">
                    <summary class="fw-semibold">Individual CSV templates <span class="small text-muted">(@ImportTemplates.All.Count)</span></summary>
                    <p class="small text-muted mt-2 mb-3">Import one record type at a time. Clinical CSVs require patient matching; <code>existing:</code> references must point to saved records.</p>
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var template in ImportTemplates.All)
                        {
                            var (label, description) = template.Name switch
                            {
                                "Patients" => ("Patients", "Hospital patient records."),
                                "Doctors" => ("Doctors", "Doctor profiles, rooms and schedules."),
                                "PublicAdvisories" => ("Public advisories", "Announcements and public notices."),
                                "ClinicalEncounters" => ("Clinical encounters", "Visits, diagnoses and care instructions."),
                                "LabResults" => ("Lab results", "Lab reports; linked visits must exist first."),
                                "LabResultItems" => ("Lab result items", "Individual measurements; import lab results first."),
                                "Prescriptions" => ("Prescriptions", "Medicines, instructions and refill details."),
                                "MedicationDoseSchedules" => ("Dose schedules", "Medication times; import prescriptions first."),
                                "PatientAllergies" => ("Patient allergies", "Allergens, reactions and severity."),
                                _ => (template.Name, "Records for this template.")
                            };
                            <div class="col">
                                <a asp-action="Template" asp-route-name="@template.Sheet" class="list-group-item list-group-item-action border rounded-3 h-100 d-flex justify-content-between gap-2 p-3" aria-label="Download @label CSV template">
                                    <span><span class="fw-semibold d-block">@label</span><span class="small text-muted d-block mt-1">@description</span></span>
                                    <i class="bi bi-download text-primary-drmc" aria-hidden="true"></i>
                                </a>
                            </div>
                        }
                    </div>
                </details>
            </div>
        </div>
    </div>
</div>
<div class="admin-card">
    <div class="admin-card-header"><h2 class="admin-card-title">Batches</h2><span class="admin-result-count tabular">@Model.Total total</span></div>
    @if (Model.Rows.Count > 0)
    {
        <div class="table-responsive"><table class="table table-hover admin-table admin-table-cards"><thead><tr><th scope="col">Created (UTC)</th><th scope="col">Batch</th><th scope="col">Template</th><th scope="col">Status</th><th scope="col" class="text-end">Rows</th></tr></thead><tbody>
        @foreach (var batch in Model.Rows)
        {
            <tr>
                <td class="tabular text-nowrap">@batch.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td data-label="Batch"><a asp-action="Details" asp-route-id="@batch.Id" class="admin-record-link admin-id">@batch.Id.ToString("N")[..12]</a></td>
                <td data-label="Template">@batch.Template</td>
                <td data-label="Status"><span class="@statuses[batch.Id].Css">@statuses[batch.Id].Text</span></td>
                <td class="text-lg-end tabular" data-label="Rows">@batch.RowCount</td>
            </tr>
        }
        </tbody></table></div>
    }
    else
    {
        <div class="admin-empty"><span class="admin-empty-icon"><i class="bi bi-file-earmark-arrow-up" aria-hidden="true"></i></span><h2>No batches yet</h2><p>Download a template, fill it in, and upload it above.</p></div>
    }
    <nav aria-label="Batch pages" class="admin-card-footer">
        <span class="tabular">Page @Model.Page of @pages</span>
        <span class="d-flex gap-2">
            <a asp-action="Index" asp-route-page="@(Math.Max(1, Model.Page - 1))" class="btn btn-sm btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")" aria-label="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
            <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-sm btn-outline-secondary @(Model.Page >= pages ? "disabled" : "")" aria-label="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        </span>
    </nav>
</div>
