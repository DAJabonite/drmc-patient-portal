@model ImportReconciliation
@{ ViewData["Title"] = "Reconciliation"; var options = (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["Patients"]!; }
<section class="container py-4">
    <div class="d-flex justify-content-between align-items-center gap-3"><h1 class="h3">Reconciliation</h1><a asp-action="Details" asp-route-id="@Model.Batch.Id">Batch status</a></div>
    @if (TempData["ImportMessage"] is string message) { <div class="alert alert-warning" role="alert">@message</div> }
    <form method="get" class="d-flex gap-2 mb-4"><input type="hidden" name="page" value="@Model.Page" /><label for="patientSearch" class="visually-hidden">Patient search</label><input id="patientSearch" name="patientSearch" value="@ViewData["PatientSearch"]" maxlength="450" class="form-control" placeholder="Patient name or hospital number" /><button class="btn btn-outline-secondary" title="Search patients"><i class="bi bi-search" aria-hidden="true"></i><span class="visually-hidden">Search patients</span></button></form>
    <form asp-action="DryRun" asp-route-id="@Model.Batch.Id" method="post">
        <input name="RowVersion" type="hidden" value="@Model.Input.RowVersion" />
        @for (var i = 0; i < Model.Groups.Count; i++)
        {
            var group = Model.Groups[i]; var mapping = Model.Input.Mappings[i];
            <div class="border-bottom py-3">
                <h2 class="h5 text-break">@group.Key</h2><p class="text-break mb-2">@group.Name <span class="text-muted">@group.BirthDate | @group.Rows rows</span></p>
                <input type="hidden" name="Mappings[@i].SourcePatientKey" value="@group.Key" />
                <label for="existing-@i" class="form-label">Existing hospital record</label><select id="existing-@i" name="Mappings[@i].PatientRecordId" disabled="@group.FromPatientTemplate" class="form-select"><option value="">Unassigned</option>@foreach (var option in options) { <option value="@option.Value" selected="@(option.Value == mapping.PatientRecordId?.ToString())">@option.Text</option> }</select>
                <div class="form-check my-3"><input id="create-@i" name="Mappings[@i].CreateNew" type="checkbox" value="true" checked="@mapping.CreateNew" class="form-check-input" /><label for="create-@i" class="form-check-label">Confirm a new hospital record</label><input name="Mappings[@i].CreateNew" type="hidden" value="false" /></div>
                <div class="row g-3"><div class="col-md-6"><label for="name-@i" class="form-label">New record name</label><input id="name-@i" name="Mappings[@i].Patient.FullName" value="@mapping.Patient.FullName" readonly="@group.FromPatientTemplate" maxlength="100000" class="form-control" /></div><div class="col-md-3"><label for="birth-@i" class="form-label">Birth date</label><input id="birth-@i" name="Mappings[@i].Patient.DateOfBirth" type="date" value="@mapping.Patient.DateOfBirth?.ToString("yyyy-MM-dd")" readonly="@group.FromPatientTemplate" class="form-control" /></div><div class="col-md-3"><label for="number-@i" class="form-label">Hospital number</label><input id="number-@i" name="Mappings[@i].Patient.HospitalNumber" value="@mapping.Patient.HospitalNumber" readonly="@group.FromPatientTemplate" maxlength="450" class="form-control" /></div></div>
            </div>
        }
        <button type="submit" class="btn btn-primary my-4"><i class="bi bi-check2-square me-1" aria-hidden="true"></i>Save mappings and dry run</button>
    </form>
    <nav aria-label="Source group pages" class="d-flex gap-3"><a asp-action="Reconcile" asp-route-id="@Model.Batch.Id" asp-route-page="@(Math.Max(1, Model.Page - 1))" asp-route-patientSearch="@ViewData["PatientSearch"]">Previous</a><span>@Model.Page / @Math.Max(1, (Model.TotalGroups + 24) / 25)</span><a asp-action="Reconcile" asp-route-id="@Model.Batch.Id" asp-route-page="@(Model.Page + 1)" asp-route-patientSearch="@ViewData["PatientSearch"]">Next</a></nav>
</section>
