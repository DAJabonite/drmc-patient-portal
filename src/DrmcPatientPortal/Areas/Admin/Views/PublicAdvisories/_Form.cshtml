@model PublicAdvisoryInput
<input asp-for="RowVersion" type="hidden" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="col-md-6">
        <span class="form-label d-block">Public URL slug</span>
        @if (ViewContext.RouteData.Values["action"]?.ToString() == "Edit")
        {
            <code class="text-break">@Model.Slug</code>
            <p class="small text-muted mb-0">The existing URL stays the same when the title changes.</p>
        }
        else { <p class="small text-muted mb-0">Generated automatically from the title when you save this advisory.</p> }
    </div>
    <div class="col-md-6"><label asp-for="Category" class="form-label"></label><select asp-for="Category" asp-items="Html.GetEnumSelectList<AdvisoryCategory>()" class="form-select"></select></div>
    <div class="col-md-6"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<AdvisoryPriority>()" class="form-select"></select></div>
    <div class="col-12"><label asp-for="Summary" class="form-label"></label><textarea asp-for="Summary" rows="2" class="form-control"></textarea><span asp-validation-for="Summary" class="text-danger"></span></div>
    <div class="col-12"><label asp-for="ContentHtml" class="form-label"></label><textarea asp-for="ContentHtml" rows="8" class="form-control font-monospace"></textarea><span asp-validation-for="ContentHtml" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" /><span asp-validation-for="ImageUrl" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="IssuingUnit" class="form-label"></label><input asp-for="IssuingUnit" class="form-control" /><span asp-validation-for="IssuingUnit" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="PublishedAt" class="form-label"></label><input asp-for="PublishedAt" type="datetime-local" step="any" class="form-control" /><span asp-validation-for="PublishedAt" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="EffectiveUntil" class="form-label"></label><input asp-for="EffectiveUntil" type="datetime-local" step="any" class="form-control" /><span asp-validation-for="EffectiveUntil" class="text-danger"></span></div>
    <div class="col-12"><div class="form-check"><input asp-for="IsPinned" class="form-check-input" /><label asp-for="IsPinned" class="form-check-label"></label></div></div>
</div>
