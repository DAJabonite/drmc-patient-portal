@model RedStarClinicPickerPage
@{ ViewData["Title"] = "Private laboratory reports"; }
<h1 class="h3">Private laboratory reports</h1>
<p>Choose a clinic registry patient to record requests or upload OHASIS PDFs.</p>
<div class="list-group mb-3">
@foreach (var patient in Model.Patients)
{
    <a asp-action="Index" asp-route-id="@patient.Id" class="list-group-item list-group-item-action">@patient.PatientCode · @patient.CodeName</a>
}
</div>
<nav aria-label="Clinic patient pages" class="d-flex gap-2">
@if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">Previous</a> }
@if (Model.Page * 25 < Model.Total) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-secondary">Next</a> }
<a asp-controller="RedStar" asp-action="Index" class="btn btn-outline-secondary">Clinic registry</a>
</nav>
