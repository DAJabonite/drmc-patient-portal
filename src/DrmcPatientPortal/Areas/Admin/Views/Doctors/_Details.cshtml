@model Doctor
<div class="admin-card">
    <div class="admin-card-header"><h2 class="admin-card-title">Directory entry</h2><span class="admin-chips"><span class="@(Model.IsActive ? "admin-chip admin-chip-success" : "admin-chip")">@(Model.IsActive ? "Active" : "Inactive")</span>@if (Model.OffersTeleconsult) { <span class="admin-chip admin-chip-info admin-chip-plain">Teleconsult</span> }</span></div>
    <dl class="admin-dl">
        <div><dt>Name</dt><dd>@Model.FullName</dd></div>
        <div><dt>Title</dt><dd>@(string.IsNullOrEmpty(Model.Title) ? "—" : Model.Title)</dd></div>
        <div><dt>Department</dt><dd>@Model.Department</dd></div>
        <div><dt>Subspecialty</dt><dd>@(string.IsNullOrEmpty(Model.SubSpecialty) ? "—" : Model.SubSpecialty)</dd></div>
        <div><dt>Clinic room</dt><dd>@(string.IsNullOrEmpty(Model.ClinicRoom) ? "—" : Model.ClinicRoom)</dd></div>
        <div><dt>Schedule</dt><dd>@(string.IsNullOrEmpty(Model.ScheduleSummary) ? "—" : Model.ScheduleSummary)</dd></div>
        <div><dt>Teleconsultation</dt><dd>@(Model.OffersTeleconsult ? "Yes" : "No")</dd></div>
        <div><dt>Masked PRC license</dt><dd>@(string.IsNullOrEmpty(Model.PrcLicenseMasked) ? "—" : Model.PrcLicenseMasked)</dd></div>
        <div><dt>Active</dt><dd>@(Model.IsActive ? "Yes" : "No")</dd></div>
        <div class="admin-dl-wide"><dt>Biography</dt><dd>@(string.IsNullOrEmpty(Model.Biography) ? "—" : Model.Biography)</dd></div>
    </dl>
</div>
