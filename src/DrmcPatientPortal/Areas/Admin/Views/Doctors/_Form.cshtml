@model DoctorInput
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<input asp-for="RowVersion" type="hidden" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Department" class="form-label"></label><select asp-for="Department" class="form-select"><option value="">Select department</option>@foreach (var department in ClinicalDepartments.All) { <option value="@department.Name">@department.Name</option> }</select><span asp-validation-for="Department" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="SubSpecialty" class="form-label"></label><input asp-for="SubSpecialty" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="ClinicRoom" class="form-label"></label><input asp-for="ClinicRoom" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="ScheduleSummary" class="form-label"></label><input asp-for="ScheduleSummary" class="form-control" /></div>
    <div class="col-12"><label asp-for="Biography" class="form-label"></label><textarea asp-for="Biography" class="form-control" rows="4"></textarea></div>
    <div class="col-md-6"><label asp-for="PrcLicenseMasked" class="form-label"></label><input asp-for="PrcLicenseMasked" class="form-control" /></div>
    <div class="col-md-6 d-flex flex-wrap align-items-center gap-4"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div><div class="form-check"><input asp-for="OffersTeleconsult" class="form-check-input" /><label asp-for="OffersTeleconsult" class="form-check-label"></label></div></div>
</div>
