@model DoctorInput
@{ ViewData["Title"] = "Edit doctor"; }
<div class="admin-page-header">
    <div><p class="admin-eyebrow">Doctors</p><h1 class="admin-title">Edit doctor</h1><p class="admin-subtitle">Directory details are public. Changes are recorded in the staff audit history.</p></div>
</div>
<form asp-area="Admin" asp-action="Edit" asp-route-id="@ViewData["Id"]" method="post" class="admin-card admin-form">
    <div class="admin-card-body"><partial name="_Form" model="Model" /></div>
    <div class="admin-form-actions">
        <a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Save changes</button>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
