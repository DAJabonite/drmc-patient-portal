@model Doctor
@{ ViewData["Title"] = "Doctor"; }
<div class="admin-page-header">
    <div><p class="admin-eyebrow">Doctors</p><h1 class="admin-title">@Model.FullName</h1><p class="admin-subtitle">@Model.Department</p></div>
    <div class="admin-page-actions">
        <a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</a>
        <a asp-area="Admin" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit</a>
    </div>
</div>
<partial name="_Details" model="Model" />
