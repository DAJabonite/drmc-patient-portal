@model Doctor
@{ ViewData["Title"] = "Delete doctor"; }
<div class="admin-page-header">
    <div><p class="admin-eyebrow">Delete record</p><h1 class="admin-title">Delete @Model.FullName</h1><p class="admin-subtitle">Review the directory entry before removing it.</p></div>
</div>
@if (TempData["AdminError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
<partial name="_Details" model="Model" />
<form asp-area="Admin" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="admin-card admin-danger">
    <div class="admin-card-header"><h2 class="admin-card-title"><i class="bi bi-exclamation-octagon me-2" aria-hidden="true"></i>Danger zone</h2></div>
    <div class="admin-card-body"><input type="hidden" name="rowVersion" value="@ViewData["RowVersion"]" /><p class="mb-0">Deleting removes this doctor from the public directory. To hide them temporarily, mark them inactive instead.</p></div>
    <div class="admin-form-actions">
        <a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button class="btn btn-danger" type="submit"><i class="bi bi-trash me-1" aria-hidden="true"></i>Delete doctor</button>
    </div>
</form>
