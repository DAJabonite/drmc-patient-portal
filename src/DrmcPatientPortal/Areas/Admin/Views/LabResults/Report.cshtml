@model LabReportPage
@{ ViewData["Title"] = "Lab report PDF"; }
<div class="admin-page-header">
    <div><h1 class="admin-title">Lab report PDF</h1><p>@Model.TestName · @Model.AccessionNumber</p></div>
    <a asp-area="Admin" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Back to lab record</a>
</div>
@if (TempData["ReportError"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
@if (TempData["ReportSuccess"] is string message) { <div class="alert alert-success" role="status">@message</div> }
<div class="card p-4">
    <p>One current PDF per lab record. Structured items and summaries remain optional. Patient access requires release and the hospital's disclosure setting.</p>
    @if (Model.HasReport)
    {
        <p>Current report: @Model.Size bytes · uploaded @Model.UploadedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC</p>
        <div class="d-flex flex-wrap gap-2 mb-3">
            <a asp-area="Admin" asp-action="PreviewReport" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-primary">Preview PDF</a>
            <a asp-area="Admin" asp-action="PreviewReport" asp-route-id="@Model.Id" asp-route-download="true" class="btn btn-outline-primary">Download PDF</a>
        </div>
    }
    else { <p>No PDF attached.</p> }
    <form asp-area="Admin" asp-action="UploadReport" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
        <label for="report" class="form-label">@(Model.HasReport ? "Replace report PDF" : "Upload report PDF")</label>
        <input id="report" name="report" type="file" accept=".pdf,application/pdf" required class="form-control" aria-describedby="reportHelp" />
        <p id="reportHelp" class="small text-muted mt-2">PDF only, up to 10 MiB. Review the report and verify its patient before uploading.</p>
        <button class="btn btn-primary" type="submit">@(Model.HasReport ? "Replace PDF" : "Upload PDF")</button>
    </form>
    @if (Model.HasReport)
    {
        <form asp-area="Admin" asp-action="RemoveReport" asp-route-id="@Model.Id" method="post" class="mt-3">
            <input type="hidden" name="rowVersion" value="@Model.RowVersion" />
            <button type="submit" class="btn btn-outline-danger">Remove PDF</button>
        </form>
    }
</div>
