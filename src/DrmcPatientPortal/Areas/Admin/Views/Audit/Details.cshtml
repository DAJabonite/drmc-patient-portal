@model AdminAuditLog
@{ ViewData["Title"] = "Audit entry"; }
<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Audit history</p>
        <h1 class="admin-title">Staff audit entry <span class="admin-id fs-6">#@Model.Id</span></h1>
    </div>
    <div class="admin-page-actions"><a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back</a></div>
</div>
<div class="admin-card">
    <dl class="admin-dl">
        <div><dt>UTC time</dt><dd class="tabular">@Model.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss.fffffff") UTC</dd></div>
        <div><dt>Action</dt><dd><span class="admin-chip admin-chip-info admin-chip-plain">@Model.Action</span></dd></div>
        <div><dt>Actor</dt><dd>@Model.ActorEmail <span class="admin-id d-block">@Model.ActorId</span></dd></div>
        <div><dt>Record</dt><dd>@Model.Entity <span class="admin-id">#@Model.RecordKey</span></dd></div>
        <div><dt>Patient reference</dt><dd class="tabular">@(Model.SubjectPatientId is { } pid ? $"#{pid}" : "—")</dd></div>
        <div class="admin-dl-wide"><dt>Changed fields</dt><dd>@Model.ChangedFields</dd></div>
    </dl>
</div>
@if (Model.Entity is "Doctors" or "PublicAdvisories")
{
    <div class="row g-3 mt-1">
        <div class="col-lg-6"><div class="admin-card h-100"><div class="admin-card-header"><h2 class="admin-card-title">Previous public values</h2></div><div class="admin-card-body"><pre class="admin-pre">@Model.OldValues</pre></div></div></div>
        <div class="col-lg-6"><div class="admin-card h-100"><div class="admin-card-header"><h2 class="admin-card-title">New public values</h2></div><div class="admin-card-body"><pre class="admin-pre">@Model.NewValues</pre></div></div></div>
    </div>
}
