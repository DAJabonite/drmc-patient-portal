@model NewMessageViewModel
@{
    ViewData["Title"] = "New Message to Care Team";
}

<section class="py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All Messages
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">New Message</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">Compose Message to Care Team</h1>
        <p class="text-white text-opacity-90 mb-0">Reach out to your clinic care coordinator for non-emergency guidance.</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 760px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold small text-dark">Destination Clinical Department:</label>
                        <select asp-for="Department" class="form-select form-select-sm">
                            @foreach (var d in Model.Departments)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                            <option value="OPD Pharmacy">OPD Pharmacy</option>
                            <option value="Central Diagnostic Laboratory">Central Diagnostic Laboratory</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold small text-dark">Message Topic / Category:</label>
                        <select asp-for="Category" class="form-select form-select-sm">
                            <option value="@MessageCategory.AppointmentInquiry">Appointment Inquiry</option>
                            <option value="@MessageCategory.LabResultClarification">Lab Result Clarification</option>
                            <option value="@MessageCategory.MedicationQuestion">Medication Question</option>
                            <option value="@MessageCategory.CareGuidance">Care Guidance</option>
                            <option value="@MessageCategory.GeneralInquiry">General Inquiry</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label fw-semibold small text-dark">Subject / Title:</label>
                    <input asp-for="Subject" class="form-control" placeholder="e.g. Question regarding fasting instructions..." required />
                </div>

                <div class="mb-4">
                    <label asp-for="Body" class="form-label fw-semibold small text-dark">Message Content:</label>
                    <textarea asp-for="Body" class="form-control" rows="5" placeholder="Please write your questions clearly. Include any relevant appointment reference or medication names if applicable." required></textarea>
                </div>

                <div class="p-3 bg-light rounded-3 border mb-4 text-muted small">
                    <i class="bi bi-clock-history me-1 text-primary-drmc"></i>
                    <strong>Response Timeline:</strong> Clinic coordinators typically respond within 24 hours on regular clinic days (Monday to Friday, 8:00 AM - 5:00 PM).
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary-drmc rounded-pill px-5 fw-bold shadow-xs">
                        <i class="bi bi-send-fill me-1"></i> Send Message
                    </button>
                </div>

            </form>

        </div>
    </div>
</section>
