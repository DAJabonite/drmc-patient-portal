@model MessageThread
@{
    ViewData["Title"] = $"{Model.Subject} — Message Thread";
}

<section class="py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All Messages
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@Model.Department</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">@Model.Subject</h1>
        <p class="text-white text-opacity-90 mb-0">Department: <strong>@Model.Department</strong> &middot; Category: <strong>@Model.Category</strong></p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 820px;">
        
        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success rounded-4 mb-4 shadow-sm">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        <!-- Message Stream -->
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
            {
                var isPatient = msg.SenderRole == MessageSenderRole.Patient;

                <div class="d-flex flex-column @(isPatient ? "align-items-end" : "align-items-start")">
                    <div class="d-flex align-items-center gap-2 mb-1 px-2">
                        <span class="small fw-semibold @(isPatient ? "text-dark" : "text-primary-drmc")">
                            @msg.SenderName
                        </span>
                        @if (!isPatient)
                        {
                            <span class="badge bg-primary-subtle text-primary-drmc rounded-pill small" style="font-size: 0.65rem;">
                                DRMC Care Team
                            </span>
                        }
                        <span class="small text-muted" style="font-size: 0.75rem;">
                            @msg.SentAt.ToString("MMM d, yyyy h:mm tt")
                        </span>
                    </div>

                    <div class="p-3 rounded-4 shadow-xs @(isPatient ? "bg-primary-drmc text-white" : "bg-white text-dark border")"
                         style="max-width: 85%; border-bottom-@(isPatient ? "end" : "start")-radius: 4px !important;">
                        <p class="mb-0 small leading-relaxed">@msg.Body</p>
                    </div>
                </div>
            }
        </div>

        <!-- Reply Box -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h2 class="h6 fw-bold text-primary-drmc mb-3">
                <i class="bi bi-reply-fill me-1"></i> Send a Reply
            </h2>

            <form asp-action="Reply" method="post">
                <input type="hidden" name="threadId" value="@Model.Id" />
                <div class="mb-3">
                    <textarea name="replyBody" class="form-control rounded-3" rows="3" placeholder="Type your reply message here..." required></textarea>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small text-muted" style="font-size: 0.75rem;">Replies are sent directly to the assigned department staff.</span>
                    <button type="submit" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                        <i class="bi bi-send-fill me-1"></i> Send Reply
                    </button>
                </div>
            </form>
        </div>

    </div>
</section>
