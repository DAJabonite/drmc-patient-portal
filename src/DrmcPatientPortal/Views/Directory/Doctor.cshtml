@model DoctorProfileViewModel
@{
    ViewData["Title"] = $"{Model.Doctor.FullName} — {Model.Doctor.Department}";
    var doc = Model.Doctor;
}

<section class="py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Back to Directory
            </a>
            <span class="text-white text-opacity-50">/</span>
            <a asp-action="Department" asp-route-name="@doc.Department" class="text-white text-opacity-75 text-decoration-none small">
                @doc.Department
            </a>
        </div>
        <h1 class="display-6 fw-bold mb-1">Physician Profile</h1>
        <p class="text-white text-opacity-90 mb-0">Davao Regional Medical Center Attending Consultant</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 860px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            <div class="d-flex flex-wrap align-items-start gap-4 mb-4 pb-4 border-bottom">
                <div class="doctor-avatar-lg bg-primary-subtle text-primary-drmc rounded-circle d-flex align-items-center justify-content-center fw-bold display-5 shadow-xs"
                     style="width: 88px; height: 88px; flex-shrink: 0;">
                    @string.Join("", doc.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(s => s[0]))
                </div>
                <div class="flex-grow-1">
                    <h2 class="h3 fw-bold text-dark mb-1">@doc.FullName</h2>
                    <p class="text-muted fw-semibold mb-2">@doc.Title</p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-primary-drmc text-white px-3 py-1 rounded-pill">
                            @doc.Department
                        </span>
                        <span class="badge bg-info-subtle text-info-emphasis px-3 py-1 rounded-pill">
                            @doc.SubSpecialty
                        </span>
                        @if (doc.OffersTeleconsult)
                        {
                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-3 py-1 rounded-pill">
                                <i class="bi bi-camera-video me-1"></i> Teleconsultation Available
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Profile Details Grid -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block mb-1">Clinical Room Location</span>
                        <strong class="h6 fw-bold text-dark mb-0">@doc.ClinicRoom</strong>
                        <div class="small text-muted mt-1">
                            @(Model.DepartmentInfo?.Location ?? "OPD Complex")
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block mb-1">Outpatient Clinic Schedule</span>
                        <strong class="h6 fw-bold text-primary-drmc mb-0">@doc.ScheduleSummary</strong>
                        <div class="small text-muted mt-1">
                            Regular Clinic Consultation Hours
                        </div>
                    </div>
                </div>
            </div>

            <!-- Biography & Clinical Domains -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-2">Clinical Background &amp; Expertise</h3>
                <p class="text-dark small mb-3 leading-relaxed">
                    @doc.Biography
                </p>
                <div class="p-2 bg-light rounded-3 border d-inline-flex align-items-center gap-2 small text-muted">
                    <i class="bi bi-shield-check text-success"></i>
                    <span>Official Verified DOH Consultant &middot; @doc.PrcLicenseMasked</span>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center pt-4 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Back to Directory
                </a>
                <a asp-controller="Appointments" asp-action="Book" asp-route-department="@doc.Department" asp-route-doctorId="@doc.Id"
                   class="btn btn-primary-drmc btn-lg rounded-pill px-5 fw-bold shadow-sm">
                    <i class="bi bi-calendar-check-fill me-1"></i> Book Consultation with @doc.FullName
                </a>
            </div>

        </div>
    </div>
</section>
