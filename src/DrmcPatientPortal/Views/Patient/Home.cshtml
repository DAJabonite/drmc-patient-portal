@model PatientDashboardViewModel
@{
    ViewData["Title"] = "My Patient Dashboard";
    var firstName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Patient"
        : Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).First();
}

<section class="dashboard-hero">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3 min-w-0">
                <div class="dashboard-avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></div>
                <div class="min-w-0">
                    <p class="small text-white text-opacity-75 mb-0">My DRMC care</p>
                    <h1 class="h2 fw-bold mb-0 text-truncate">Welcome, @firstName</h1>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section dashboard-main py-4">
    <div class="container">
        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success mb-3" role="status">
                <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
            </div>
        }

        <section class="dashboard-actions-section mb-3" aria-labelledby="dashboardActionsHeading">
            <h2 class="visually-hidden" id="dashboardActionsHeading">Quick actions</h2>
            <nav class="dashboard-actions" aria-label="Quick actions">
                <a class="dashboard-action-card" asp-controller="Directory" asp-action="Index">
                    <span class="dashboard-action-icon"><i class="bi bi-person-badge" aria-hidden="true"></i></span>
                    <span class="dashboard-action-content"><strong>Doctors &amp; clinics</strong></span>
                </a>
                <a class="dashboard-action-card" asp-controller="Home" asp-action="OpdGuide">
                    <span class="dashboard-action-icon"><i class="bi bi-signpost-split" aria-hidden="true"></i></span>
                    <span class="dashboard-action-content"><strong>OPD guide</strong></span>
                </a>
            </nav>
        </section>

        <div class="row g-3">
            <div class="col-md-6 col-xl-3">
                <article class="card summary-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-journal-medical" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Clinical care</p>
                                <h2 class="h6 fw-bold mb-0">Visits</h2>
                            </div>
                            <span class="summary-count">@Model.Encounters.Count</span>
                        </div>
                        @if (Model.Encounters.Count > 0)
                        {
                            var latestEnc = Model.Encounters.First();
                            <div class="record-preview-list">
                                <a asp-controller="Encounters" asp-action="Details" asp-route-id="@latestEnc.Id" class="record-preview">
                                    <span><strong>@latestEnc.Department</strong><small>@latestEnc.EncounterDate.ToString("MMM d, yyyy")</small></span>
                                    <span class="badge status-badge text-bg-primary">@latestEnc.Type</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state compact"><span>No recent clinical encounters.</span></div>
                        }
                        <a asp-controller="Encounters" asp-action="Index" class="btn btn-primary-drmc dashboard-summary-button mt-auto">View all visits <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-xl-3">
                <article class="card summary-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Latest updates</p>
                                <h2 class="h6 fw-bold mb-0">Lab results</h2>
                            </div>
                            <span class="summary-count">@Model.LabResults.Count</span>
                        </div>

                        @if (Model.LabResults.Count > 0)
                        {
                            <div class="record-preview-list">
                                @foreach (var lab in Model.LabResults.Take(2))
                                {
                                    <a asp-controller="LabResults" asp-action="Details" asp-route-id="@lab.Id" class="record-preview">
                                        <span><strong>@lab.TestName</strong><small>@lab.CollectedAt.ToString("MMM d, yyyy")</small></span>
                                        <span class="badge status-badge @(lab.Status == "Available" ? "text-bg-success" : "text-bg-warning")">@lab.Status</span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state compact"><span>No recent laboratory records.</span></div>
                        }

                        <a asp-controller="LabResults" asp-action="Index" class="btn btn-primary-drmc dashboard-summary-button mt-auto">View all results <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-xl-3">
                <article class="card summary-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-capsule" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Daily care</p>
                                <h2 class="h6 fw-bold mb-0">Medications</h2>
                            </div>
                            <span class="summary-count">@Model.ActivePrescriptionsCount</span>
                        </div>
                        <p class="text-muted small mb-3">Review dose times, safety instructions, and prescription details.</p>
                        <a asp-controller="Medications" asp-action="Index" class="btn btn-primary-drmc dashboard-summary-button mt-auto">Open medications <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-xl-3">
                <article class="card summary-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-heart-pulse" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Assistance</p>
                                <h2 class="h6 fw-bold mb-0">Malasakit</h2>
                            </div>
                            @if (Model.SubsidyApplication is not null)
                            {
                                <span class="badge status-badge text-bg-info">@Model.SubsidyApplication.Eligibility</span>
                            }
                        </div>
                        <p class="text-muted small mb-3">Check medical assistance programs, document checklists, and application status.</p>
                        <a asp-controller="Malasakit" asp-action="Index" class="btn btn-primary-drmc dashboard-summary-button mt-auto">Malasakit assistance <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>
