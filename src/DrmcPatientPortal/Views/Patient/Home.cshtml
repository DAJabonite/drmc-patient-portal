@model PatientDashboardViewModel
@{
    ViewData["Title"] = "My Patient Dashboard";
    var firstName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Patient"
        : Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).First();
}

<section class="dashboard-hero">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3 min-w-0">
                <div class="dashboard-avatar"><i class="bi bi-person-fill" aria-hidden="true"></i></div>
                <div class="min-w-0">
                    <p class="small text-white text-opacity-75 mb-0">My DRMC care</p>
                    <h1 class="h2 fw-bold mb-0 text-truncate">Welcome, @firstName</h1>
                </div>
            </div>
            <div class="dashboard-hero-actions d-flex gap-2">
                <a asp-action="Audit" class="btn btn-outline-light btn-sm"><i class="bi bi-shield-check" aria-hidden="true"></i> Access history</a>
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-outline-light btn-sm"><i class="bi bi-gear" aria-hidden="true"></i> Settings</a>
            </div>
        </div>
    </div>
</section>

<section class="section dashboard-main py-4">
    <div class="container">
        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success mb-3" role="status">
                <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@TempData["SuccessMessage"]
            </div>
        }

        <nav class="dashboard-shortcuts mb-3" aria-label="Patient shortcuts">
            <a asp-controller="Encounters" asp-action="Index"><i class="bi bi-journal-medical" aria-hidden="true"></i><span>Visits</span></a>
            <a asp-controller="Queue" asp-action="Index"><i class="bi bi-people" aria-hidden="true"></i><span>Live queue</span></a>
            <a asp-action="Audit"><i class="bi bi-shield-check" aria-hidden="true"></i><span>Access history</span></a>
            <a asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-gear" aria-hidden="true"></i><span>Settings</span></a>
        </nav>

        <div class="row g-3">
            <div class="col-lg-6">
                <article class="card summary-card appointment-summary h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Next step</p>
                                <h2 class="h5 fw-bold mb-0">Upcoming appointment</h2>
                            </div>
                            @if (Model.NextAppointment is not null)
                            {
                                <span class="badge status-badge @(Model.NextAppointment.Status == "Confirmed" ? "text-bg-success" : "text-bg-warning")">@Model.NextAppointment.Status</span>
                            }
                        </div>

                        @if (Model.NextAppointment is not null)
                        {
                            var appt = Model.NextAppointment;
                            <div class="appointment-summary-content">
                                <div>
                                    <strong class="d-block fs-5 text-primary-drmc">@appt.Department</strong>
                                    <span class="d-block mt-1"><i class="bi bi-clock me-2 text-muted" aria-hidden="true"></i>@appt.ScheduledAt.ToString("ddd, MMM d, yyyy") at @appt.ScheduledAt.ToString("h:mm tt")</span>
                                    <span class="d-block mt-1 text-muted"><i class="bi bi-person-badge me-2" aria-hidden="true"></i>@appt.DoctorName</span>
                                </div>
                                @if (Model.HasTriageForNextAppointment)
                                {
                                    <div class="status-note status-note-success"><i class="bi bi-check2-circle" aria-hidden="true"></i>Pre-triage completed</div>
                                }
                                else
                                {
                                    <a asp-controller="Triage" asp-action="Start" asp-route-appointmentId="@appt.Id" class="btn btn-primary-drmc">
                                        <i class="bi bi-clipboard-pulse" aria-hidden="true"></i> Complete pre-triage
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state flex-grow-1">
                                <i class="bi bi-calendar2-plus" aria-hidden="true"></i>
                                <strong>No upcoming appointment</strong>
                                <span>Choose a clinic and time that works for you.</span>
                            </div>
                        }

                        <div class="summary-card-actions mt-auto">
                            <a asp-controller="Appointments" asp-action="Book"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Book appointment</a>
                            <a asp-controller="Queue" asp-action="Index"><i class="bi bi-broadcast" aria-hidden="true"></i> Live queue</a>
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-lg-3">
                <article class="card summary-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Latest updates</p>
                                <h2 class="h6 fw-bold mb-0">Lab results</h2>
                            </div>
                            <span class="summary-count">@Model.LabResults.Count</span>
                        </div>

                        @if (Model.LabResults.Count > 0)
                        {
                            <div class="record-preview-list">
                                @foreach (var lab in Model.LabResults.Take(2))
                                {
                                    <a asp-controller="LabResults" asp-action="Details" asp-route-id="@lab.Id" class="record-preview">
                                        <span><strong>@lab.TestName</strong><small>@lab.CollectedAt.ToString("MMM d, yyyy")</small></span>
                                        <span class="badge status-badge @(lab.Status == "Available" ? "text-bg-success" : "text-bg-warning")">@lab.Status</span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state compact"><span>No recent laboratory records.</span></div>
                        }

                        <a asp-controller="LabResults" asp-action="Index" class="summary-primary-link mt-auto">View all results <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>

            <div class="col-md-6 col-lg-3">
                <article class="card summary-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="summary-card-heading">
                            <span class="card-icon"><i class="bi bi-capsule" aria-hidden="true"></i></span>
                            <div>
                                <p class="eyebrow mb-1">Daily care</p>
                                <h2 class="h6 fw-bold mb-0">Medications</h2>
                            </div>
                            <span class="summary-count">@Model.ActivePrescriptionsCount</span>
                        </div>
                        <p class="text-muted small mb-3">Review dose times, safety instructions, and refill status.</p>
                        <a asp-controller="Medications" asp-action="Index" class="summary-primary-link mt-auto">Open medications <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>
