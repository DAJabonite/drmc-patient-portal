@model PatientDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var firstName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Patient"
        : Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).First();
}

<!-- Dashboard Header Banner -->
<section class="dashboard-hero py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="dashboard-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <h1 class="display-6 fw-bold mb-0">Welcome, @firstName!</h1>
                    <span class="badge bg-success-subtle text-success px-3 py-1 fs-6 rounded-pill fw-semibold border border-success border-opacity-25">Active Patient</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-outline-light d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 fw-semibold shadow-sm">
                    <i class="bi bi-person-gear fs-6"></i> Account Settings
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Dashboard Main Cards Grid -->
<section class="section py-5 bg-light">
    <div class="container">
        <div class="row g-4">

            <!-- Next Appointment Card -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="card-icon bg-primary-subtle text-primary-drmc rounded-3 p-2 d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                <i class="bi bi-calendar-event fs-5"></i>
                            </span>
                            @if (Model.NextAppointment is not null)
                            {
                                <span class="badge @(Model.NextAppointment.Status == "Confirmed" ? "bg-success-subtle text-success border border-success border-opacity-25" : "bg-warning-subtle text-warning-emphasis border border-warning border-opacity-25") px-3 py-1 rounded-pill fw-semibold">
                                    @Model.NextAppointment.Status
                                </span>
                            }
                        </div>

                        <h2 class="h6 fw-bold text-dark mb-2">Next Appointment</h2>

                        @if (Model.NextAppointment is not null)
                        {
                            var appt = Model.NextAppointment;
                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                <span class="d-block fw-bold text-primary-drmc fs-6 mb-1">@appt.Department</span>
                                <div class="small text-dark mb-1">
                                    <i class="bi bi-clock me-1 text-muted"></i>
                                    <strong>@appt.ScheduledAt.ToString("ddd, MMM d, yyyy")</strong> at @appt.ScheduledAt.ToString("h:mm tt")
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-person-badge me-1"></i> Attending: <span class="text-dark fw-medium">@appt.ProviderName</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted bg-light rounded-3 mb-3">
                                <i class="bi bi-calendar-x fs-3 d-block mb-1 text-secondary"></i>
                                <span class="small">No upcoming appointments scheduled.</span>
                            </div>
                        }

                        <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                            <span class="small text-muted">
                                <i class="bi bi-info-circle me-1"></i> Online booking coming soon
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Lab Results Card -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="card-icon bg-info-subtle text-info-emphasis rounded-3 p-2 d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                <i class="bi bi-file-earmark-medical fs-5"></i>
                            </span>
                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill small">
                                Diagnostics
                            </span>
                        </div>

                        <h2 class="h6 fw-bold text-dark mb-2">Recent Lab Work</h2>

                        @if (Model.LabResults.Count > 0)
                        {
                            <div class="d-flex flex-column gap-2 mb-3">
                                @foreach (var lab in Model.LabResults.Take(2))
                                {
                                    <div class="p-2 rounded-3 bg-light border">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <strong class="small text-dark">@lab.TestName</strong>
                                            <span class="badge @(lab.Status == "Available" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") rounded-pill small">
                                                @lab.Status
                                            </span>
                                        </div>
                                        <div class="small text-muted" style="font-size:0.8rem;">
                                            Collected: @lab.CollectedAt.ToString("MMM d, yyyy") &middot; @lab.ResultSummary
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted bg-light rounded-3 mb-3">
                                <i class="bi bi-folder-x fs-3 d-block mb-1 text-secondary"></i>
                                <span class="small">No recent laboratory records found.</span>
                            </div>
                        }

                        <div class="mt-auto pt-3 border-top">
                            <span class="small text-muted">
                                <i class="bi bi-shield-lock me-1"></i> Full PDF lab reports coming soon
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Messages Card -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="card-icon bg-warning-subtle text-warning-emphasis rounded-3 p-2 d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                <i class="bi bi-chat-dots fs-5"></i>
                            </span>
                            @if (Model.UnreadMessages > 0)
                            {
                                <span class="badge bg-danger rounded-pill px-2 py-1 small">
                                    @Model.UnreadMessages New
                                </span>
                            }
                        </div>

                        <h2 class="h6 fw-bold text-dark mb-2">Messages &amp; Advisories</h2>

                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <div class="d-flex align-items-baseline gap-2 mb-2">
                                <span class="display-6 fw-bold text-primary-drmc">@Model.UnreadMessages</span>
                                <span class="text-muted small">@(Model.UnreadMessages == 1 ? "unread notification" : "unread notifications")</span>
                            </div>
                            <p class="small text-muted mb-0">
                                You have active notifications regarding clinical schedules and DRMC patient guidelines.
                            </p>
                        </div>

                        <div class="mt-auto pt-3 border-top">
                            <span class="small text-muted">
                                <i class="bi bi-lock me-1"></i> Direct doctor messaging coming soon
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Patient Profile Card -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="card-icon bg-primary-subtle text-primary-drmc rounded-3 p-2 d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                <i class="bi bi-person-vcard fs-5"></i>
                            </span>
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill small">
                                Verified
                            </span>
                        </div>

                        <h2 class="h6 fw-bold text-dark mb-2">Patient Profile</h2>

                        <div class="mb-3">
                            <h3 class="h6 fw-bold text-primary-drmc mb-1">@Model.FullName</h3>
                            <div class="small text-muted mb-1">
                                <i class="bi bi-envelope me-1"></i> @Model.Email
                            </div>
                            <div class="small text-muted mb-1">
                                <i class="bi bi-telephone me-1"></i> @Model.ContactNumber
                            </div>
                            <div class="small text-muted">
                                <i class="bi bi-calendar3 me-1"></i> Member since @Model.CreatedAt.ToString("MMMM yyyy")
                            </div>
                        </div>

                        <div class="mt-auto pt-3 border-top">
                            <a class="btn btn-sm btn-outline-drmc w-100 fw-semibold" asp-area="Identity" asp-page="/Account/Manage/Index">
                                Manage Account Settings <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clinical Departments Directory Card -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="card-icon bg-success-subtle text-success rounded-3 p-2 d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                <i class="bi bi-building fs-5"></i>
                            </span>
                            <span class="badge bg-light text-dark border px-2 py-1 rounded-pill small">
                                8 Specialties
                            </span>
                        </div>

                        <h2 class="h6 fw-bold text-dark mb-2">Hospital Departments</h2>
                        <p class="small text-muted mb-3">
                            Explore available specialized outpatient departments and services at Davao Regional Medical Center.
                        </p>

                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var dept in Model.Departments.Take(4))
                            {
                                <span class="badge bg-light text-secondary border small px-2 py-1">@dept.Name</span>
                            }
                            <span class="badge bg-light text-muted border small px-2 py-1">+@(Model.Departments.Count - 4) more</span>
                        </div>

                        <div class="mt-auto pt-3 border-top">
                            <a class="btn btn-sm btn-outline-drmc w-100 fw-semibold" asp-controller="Home" asp-action="Index" asp-fragment="departments">
                                View All Departments <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hospital Advisory & Announcements Card -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="card-icon bg-danger-subtle text-danger rounded-3 p-2 d-inline-flex align-items-center justify-content-center" style="width:42px;height:42px;">
                                <i class="bi bi-megaphone fs-5"></i>
                            </span>
                            <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill small">
                                Advisory
                            </span>
                        </div>

                        <h2 class="h6 fw-bold text-dark mb-2">Patient Advisory</h2>

                        <div class="p-3 bg-light rounded-3 mb-3 border">
                            <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-2">
                                <li class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Please arrive <strong>15 minutes</strong> prior to your scheduled clinic appointment.</span>
                                </li>
                                <li class="d-flex align-items-start gap-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Present a valid government ID (PhilSys / PhilHealth) at the triage desk.</span>
                                </li>
                            </ul>
                        </div>

                        <div class="mt-auto pt-3 border-top">
                            <a href="tel:1555" class="small text-primary-drmc fw-semibold text-decoration-none">
                                <i class="bi bi-telephone-fill me-1"></i> DOH Helpline: 1555
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
