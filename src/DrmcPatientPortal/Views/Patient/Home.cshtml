@model PatientDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var firstName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "there"
        : Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).First();
}

<!-- Dashboard header -->
<section class="hero">
    <div class="container">
        <h1 class="h2">Welcome, @firstName</h1>
        <p class="lead mb-0">Here is a summary of your care at Davao Regional Medical Center.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row g-4">

            <!-- Next Appointment -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card">
                    <div class="card-body">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1A1.5 1.5 0 0 1 15 2.5v11A1.5 1.5 0 0 1 13.5 15h-11A1.5 1.5 0 0 1 1 13.5v-11A1.5 1.5 0 0 1 2.5 1h1V.5A.5.5 0 0 1 3.5 0zM1 5v8.5A.5.5 0 0 0 1.5 14h13a.5.5 0 0 0 .5-.5V5H1zm3-1.5h.5v1a.5.5 0 0 0 1 0v-1H10v1a.5.5 0 0 0 1 0v-1h.5V5H4v-1.5z"/></svg>
                        </span>
                        <h2 class="h6 card-title">Next Appointment</h2>
                        @if (Model.NextAppointment is not null)
                        {
                            var appt = Model.NextAppointment;
                            <p class="card-text mb-1">
                                <strong class="text-primary-drmc">@appt.Department</strong><br />
                                @appt.ScheduledAt.ToString("ddd, MMM d, yyyy") at @appt.ScheduledAt.ToString("h:mm tt")<br />
                                <span class="small">@appt.ProviderName</span>
                            </p>
                            <span class="badge bg-primary-drmc rounded-pill">@appt.Status</span>
                        }
                        else
                        {
                            <p class="card-text">You have no upcoming appointments.</p>
                        }
                    </div>
                    <div class="card-footer">
                        <span class="small text-muted">Appointment booking is coming to this portal.</span>
                    </div>
                </div>
            </div>

            <!-- Recent Lab Results -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card">
                    <div class="card-body">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M5 1a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2h2a1 1 0 0 1 1 1v1H2V4a1 1 0 0 1 1-1h2V1zM2 7h12v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7zm5 1v2.5a.5.5 0 0 0 1 0V8h1a.5.5 0 0 0 0-1H7V6.5a.5.5 0 0 0-1 0V7H5.5a.5.5 0 0 0 0 1H7z"/></svg>
                        </span>
                        <h2 class="h6 card-title">Recent Lab Work</h2>
                        @if (Model.LabResults.Count > 0)
                        {
                            @foreach (var lab in Model.LabResults.Take(2))
                            {
                                <p class="card-text mb-2">
                                    <span class="fw-semibold">@lab.TestName</span><br />
                                    <span class="small text-muted">@lab.CollectedAt.ToString("MMM d, yyyy")</span><br />
                                    <span class="badge @(lab.Status == "Available" ? "bg-primary-drmc" : "bg-secondary") rounded-pill">@lab.Status</span>
                                    <span class="small text-muted">— @lab.ResultSummary</span>
                                </p>
                            }
                        }
                        else
                        {
                            <p class="card-text">No recent lab results.</p>
                        }
                    </div>
                    <div class="card-footer">
                        <span class="small text-muted">Full results will be available soon.</span>
                    </div>
                </div>
            </div>

            <!-- Messages -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card">
                    <div class="card-body">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M0 3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3zm2-.5a.5.5 0 0 0-.5.5v.2L8 7 14.5 3.2V3a.5.5 0 0 0-.5-.5H2zM14.5 5.2 8.5 8.6a.5.5 0 0 1-1 0L1.5 5.2V13a.5.5 0 0 0 .5.5h12a.5.5 0 0 0 .5-.5V5.2z"/></svg>
                        </span>
                        <h2 class="h6 card-title">Messages</h2>
                        <div class="card-value mb-2">@Model.UnreadMessages</div>
                        <p class="card-text small">
                            @(Model.UnreadMessages == 1 ? "unread message" : "unread messages")
                        </p>
                    </div>
                    <div class="card-footer">
                        <span class="small text-muted">Messaging will be available soon.</span>
                    </div>
                </div>
            </div>

            <!-- My Profile -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card">
                    <div class="card-body">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M8 1a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM3 9.5A1.5 1.5 0 0 1 4.5 8h7A1.5 1.5 0 0 1 13 9.5c0 2.5-1.5 4.5-5 4.5S3 12 3 9.5z"/></svg>
                        </span>
                        <h2 class="h6 card-title">My Profile</h2>
                        <p class="card-text mb-2"><strong>@Model.FullName</strong><br />@Model.Email<br /><span class="small text-muted">@Model.ContactNumber</span></p>
                        <span class="small text-muted">Member since @Model.CreatedAt.ToString("MMM yyyy")</span>
                    </div>
                    <div class="card-footer">
                        <a class="fw-semibold" asp-area="Identity" asp-page="/Account/Manage/Index">Manage profile &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Clinical Departments (reuses Landing content) -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card">
                    <div class="card-body">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5v-3zM8 2.5A1.5 1.5 0 0 1 9.5 1h3A1.5 1.5 0 0 1 14 2.5v3A1.5 1.5 0 0 1 12.5 7h-3A1.5 1.5 0 0 1 8 5.5v-3zM1 8.5A1.5 1.5 0 0 1 2.5 7h3A1.5 1.5 0 0 1 7 8.5v3A1.5 1.5 0 0 1 5.5 13h-3A1.5 1.5 0 0 1 1 11.5v-3zM8 8.5A1.5 1.5 0 0 1 9.5 7h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 8 11.5v-3z"/></svg>
                        </span>
                        <h2 class="h6 card-title">Clinical Departments</h2>
                        <p class="card-text small mb-0">
                            @Model.Departments.Count departments: @string.Join(", ", Model.Departments.Select(d => d.Name))
                        </p>
                    </div>
                    <div class="card-footer">
                        <a class="fw-semibold" asp-controller="Home" asp-action="Index" asp-fragment="departments">View departments &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Announcements -->
            <div class="col-md-6 col-lg-4">
                <div class="card summary-card">
                    <div class="card-body">
                        <span class="card-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm4 0v8h8V4H4z"/></svg>
                        </span>
                        <h2 class="h6 card-title">Announcements</h2>
                        <p class="card-text small mb-0">
                            Please arrive 15 minutes before your appointment and bring a valid ID and any referral letter.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
