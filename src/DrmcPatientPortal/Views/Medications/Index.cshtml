@model MedicationsIndexViewModel
@{
    ViewData["Title"] = Loc["Rx_Title"];
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="display-6 fw-bold mb-0">@Loc["Rx_Title"]</h1>
            </div>

            <div>
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold fs-6">
                    <i class="bi bi-check2-circle me-1"></i> @Model.ActiveCount @Loc["Rx_Active"]
                </span>
            </div>
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 960px;">
        
        <!-- Allergy Alert Banner -->
        @if (Model.Allergies.Count > 0)
        {
            <aside class="medication-safety-card mb-4" aria-labelledby="medicationSafetyHeading">
                <div class="medication-safety-summary">
                    <div class="medication-safety-icon">
                        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="text-danger fw-semibold mb-1">@Loc["Rx_SafetyAlert"]</p>
                        <h2 class="h5 fw-bold text-dark mb-1" id="medicationSafetyHeading">
                            @Loc["Rx_AllergyCount", Model.AllergyPagination.Total]
                        </h2>
                        <p class="small text-muted mb-0 text-wrap-pretty">
                            @string.Join(", ", Model.Allergies.Select(a => a.Allergen))
                        </p>
                    </div>
                </div>
                <details class="medication-allergy-details">
                    <summary>@Loc["Rx_ReactionDetails"]</summary>
                    <div class="medication-allergy-body">
                        <ul class="mb-0 small ps-3">
                            @foreach (var a in Model.Allergies)
                            {
                                <li>
                                    <strong>@a.Allergen</strong> &mdash; <span>@Loc["Rx_Reaction"]: @a.Reaction</span> (@Loc["Rx_Severity"]: <em>@Loc["Rx_Severity_" + a.Severity]</em>)
                                </li>
                            }
                        </ul>
                    </div>
                </details>
            </aside>
            <partial name="_Pagination" model="Model.AllergyPagination" />
        }

        @if (Model.RedStarEnrolled) { <partial name="_RedStarRefillCard" model="Model.RedStarRefill" /> }

        <!-- Data-backed daily medication schedule -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h2 class="h5 fw-bold text-primary-drmc mb-3">
                <i class="bi bi-clock-history me-1"></i> @Loc["Rx_DailySchedule"]
            </h2>
            @{ var scheduledDoses = Model.Schedules; }
            @if (scheduledDoses.Count == 0)
            {
                <p class="small text-muted mb-0">@Loc["Rx_NoExactSchedule"]</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var group in scheduledDoses.GroupBy(x => x.DoseTime))
                    {
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <strong class="text-primary-drmc d-block mb-2">@group.Key.ToString("h:mm tt")</strong>
                                <ul class="list-unstyled text-dark mb-0">
                                    @foreach (var dose in group) { <li>&bull; @dose.GenericName @dose.Dosage</li> }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
            <partial name="_Pagination" model="Model.SchedulePagination" />
        </div>

        <form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <label for="medicationEncounterDate" class="form-label fw-semibold">@Loc["Report_EncounterDate"]</label>
            <select id="medicationEncounterDate" name="dateRange" class="form-select mb-2">
                <option value="" selected="@(Model.SelectedDateRange == null)">@Loc["Report_AnyDate"]</option>
                <option value="30d" selected="@(Model.SelectedDateRange == "30d")">@Loc["Report_Last30Days"]</option>
                <option value="6m" selected="@(Model.SelectedDateRange == "6m")">@Loc["Report_Last6Months"]</option>
                <option value="year" selected="@(Model.SelectedDateRange == "year")">@Loc["Report_ThisYear"]</option>
                <option value="custom" selected="@(Model.SelectedDateRange == "custom")">@Loc["Report_CustomRange"]</option>
            </select>
            <div class="row g-2 mb-3">
                <div class="col-sm-6"><label for="medicationStartDate" class="form-label small">@Loc["Report_From"]</label><input id="medicationStartDate" type="date" name="startDate" value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-sm-6"><label for="medicationEndDate" class="form-label small">@Loc["Report_To"]</label><input id="medicationEndDate" type="date" name="endDate" value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")" class="form-control" /></div>
            </div>
            @if (ViewData["DateRangeError"] is string error) { <p class="small text-danger" role="alert">@Loc[error]</p> }
            <div><button class="btn btn-primary-drmc">@Loc["Report_Apply"]</button> <a asp-action="Index" class="btn btn-outline-secondary">@Loc["Report_ClearFilters"]</a></div>
        </form>

        <!-- Prescriptions List -->
        <div class="mb-3 d-flex align-items-center justify-content-between">
            <h2 class="h5 fw-bold text-primary-drmc mb-0">@Loc["Rx_Tagubilin"] (@Model.PrescriptionTotal)</h2>
        </div>

        <div class="d-flex flex-column gap-3">
            @{ var displayGroups = Model.PrescriptionGroups.ToList();
               if (Model.Prescriptions.Count > 0) displayGroups.Add(new PrescriptionEncounterGroup(null, Loc["Report_Unassigned"].Value, null, Model.Prescriptions)); }
            @foreach (var group in displayGroups)
            {
                <section aria-label="@group.Reference" data-testid="prescription-encounter-group" data-encounter-id="@group.EncounterId">
                    <h3 class="h6 fw-bold text-primary-drmc mt-3">@group.Reference @if (group.Date.HasValue) { <span>· @group.Date.Value.ToString("MMM d, yyyy")</span> }</h3>
                    @if (group.EncounterId.HasValue) { <a asp-controller="Visits" asp-action="Details" asp-route-id="@group.EncounterId" class="small fw-semibold">@Loc["Rx_ViewEncounter"]</a> }
                    @foreach (var rx in group.Prescriptions)
                    {
                        <partial name="_PrescriptionCard" model="rx" />
                    }
                    @if (!group.EncounterId.HasValue) { <partial name="_Pagination" model="Model.LegacyPagination" /> }
                </section>
            }
        </div>
        @if (Model.Pagination.Total > 0) { <partial name="_Pagination" model="Model.Pagination" /> }
        @if (Model.LegacyExcluded) { <p class="small text-muted">@Loc["Report_LegacyExcluded"]</p> }
        @if (displayGroups.Count == 0) { <p class="text-muted">@Loc["Rx_NoMatches"]</p> }

    </div>
</section>
