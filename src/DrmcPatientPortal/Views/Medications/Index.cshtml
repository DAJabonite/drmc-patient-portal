@model MedicationsIndexViewModel
@{
    ViewData["Title"] = Loc["Rx_Title"];
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <p class="small text-white text-opacity-75 mb-1">@Loc["Rx_Pharmacy"]</p>
                <h1 class="display-6 fw-bold mb-0">@Loc["Rx_Title"]</h1>
            </div>

            <div>
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold fs-6">
                    <i class="bi bi-check2-circle me-1"></i> @Model.ActiveCount @Loc["Rx_Active"]
                </span>
            </div>
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 960px;">
        
        <!-- Allergy Alert Banner -->
        @if (Model.Allergies.Count > 0)
        {
            <aside class="medication-safety-card mb-4" aria-labelledby="medicationSafetyHeading">
                <div class="medication-safety-summary">
                    <div class="medication-safety-icon">
                        <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="eyebrow text-danger mb-1">@Loc["Rx_SafetyAlert"]</p>
                        <h2 class="h6 fw-bold text-dark mb-1" id="medicationSafetyHeading">
                            @(Model.Allergies.Count == 1 ? "1 documented drug allergy" : $"{Model.Allergies.Count} documented drug allergies")
                        </h2>
                        <p class="small text-muted mb-0 text-wrap-pretty">
                            @string.Join(", ", Model.Allergies.Select(a => a.Allergen))
                        </p>
                    </div>
                </div>
                <details class="medication-allergy-details">
                    <summary>View reaction details</summary>
                    <div class="medication-allergy-body">
                        <ul class="mb-0 small ps-3">
                            @foreach (var a in Model.Allergies)
                            {
                                <li>
                                    <strong>@a.Allergen</strong> &mdash; <span>Reaction: @a.Reaction</span> (Severity: <em>@a.Severity</em>)
                                </li>
                            }
                        </ul>
                    </div>
                </details>
            </aside>
        }

        <!-- Data-backed daily medication schedule -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <h2 class="h6 fw-bold text-primary-drmc mb-3">
                <i class="bi bi-clock-history me-1"></i> @Loc["Rx_DailySchedule"]
            </h2>
            @{ var scheduledDoses = Model.Prescriptions.Where(p => p.Status == PrescriptionStatus.Active)
                .SelectMany(p => p.DoseSchedules.Select(s => new { Prescription = p, Schedule = s }))
                .OrderBy(x => x.Schedule.DoseTime).ThenBy(x => x.Schedule.DisplayOrder).ToList(); }
            @if (scheduledDoses.Count == 0)
            {
                <p class="small text-muted mb-0">@Loc["Rx_NoExactSchedule"]</p>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var group in scheduledDoses.GroupBy(x => x.Schedule.DoseTime))
                    {
                        <div class="col-sm-6 col-md-3">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <strong class="small text-primary-drmc d-block mb-2">@group.Key.ToString("h:mm tt")</strong>
                                <ul class="list-unstyled small text-dark mb-0">
                                    @foreach (var dose in group) { <li>&bull; @dose.Prescription.GenericName @dose.Prescription.Dosage</li> }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Prescriptions List -->
        <div class="mb-3 d-flex align-items-center justify-content-between">
            <h2 class="h5 fw-bold text-primary-drmc mb-0">@Loc["Rx_ActiveOrders"] (@Model.Prescriptions.Count)</h2>
        </div>

        <div class="d-flex flex-column gap-3">
            @foreach (var rx in Model.Prescriptions)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="row align-items-center g-3">
                        <div class="col-md-7">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="badge @(rx.Status == PrescriptionStatus.Active ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill small">
                                    @rx.Status
                                </span>
                                <span class="small text-muted" style="font-size: 0.75rem;">
                                    @Loc["Rx_Number"]: <strong>@rx.RxNumber</strong>
                                </span>
                            </div>

                            <h3 class="h5 fw-bold text-dark mb-1">
                                @rx.GenericName
                                @if (!string.IsNullOrEmpty(rx.BrandName))
                                {
                                    <span class="text-muted fw-normal fs-6">(@rx.BrandName)</span>
                                }
                            </h3>

                            <div class="small text-primary-drmc fw-semibold mb-2">
                                <i class="bi bi-prescription2 me-1"></i> @rx.Dosage &middot; @rx.DosageForm &middot; @rx.Frequency
                            </div>

                            <p class="small text-muted mb-2">@rx.Instructions</p>

                            <div class="small text-muted d-flex flex-wrap gap-3" style="font-size: 0.8rem;">
                                <span><i class="bi bi-person-badge me-1"></i> @Loc["Rx_Prescriber"]: @rx.PrescribingDoctor</span>
                                <span><i class="bi bi-calendar3 me-1"></i> @Loc["Rx_ValidUntil"]: @rx.ValidUntil.ToString("d")</span>
                            </div>
                        </div>

                        <div class="col-md-5 text-md-end">
                            <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                                <a asp-action="Details" asp-route-id="@rx.Id" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold btn-sm">
                                    @Loc["Rx_Details"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>
