@model RefillRequest
@{
    ViewData["Title"] = "Refill Status & Pick-Up Voucher";
}

<section class="page-header">
    <div class="container">
        <h1 class="display-6 fw-bold mb-1">Prescription Refill Order</h1>
        <p class="text-white text-opacity-90 mb-0">DRMC Outpatient Pharmacy Pick-Up Validation</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 680px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
            
            <div class="p-3 rounded-circle bg-success-subtle text-success d-inline-flex mx-auto mb-3">
                <i class="bi bi-bag-check-fill fs-1"></i>
            </div>

            <span class="badge bg-success px-3 py-1 rounded-pill mb-2 d-inline-block mx-auto">
                Refill Order @Model.Status
            </span>

            <h2 class="h4 fw-bold text-dark mb-1">@Model.Prescription.GenericName @Model.Prescription.Dosage</h2>
            <p class="text-muted small mb-4">Prescription Order: <strong>@Model.Prescription.RxNumber</strong></p>

            <div class="p-4 bg-light rounded-3 text-start mb-4 border">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Refill Request ID:</span>
                    <strong class="text-dark small">#@Model.Id</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Requested On:</span>
                    <strong class="text-dark small">@Model.RequestedAt.ToString("MMMM d, yyyy")</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Pick-Up Location:</span>
                    <strong class="text-primary-drmc small">DRMC OPD Pharmacy Window 2</strong>
                </div>
                @if (Model.EstimatedPickupDate.HasValue)
                {
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted small">Estimated Claim Date:</span>
                        <strong class="text-dark small">@Model.EstimatedPickupDate.Value.ToString("MMMM d, yyyy")</strong>
                    </div>
                }
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Remaining Refills:</span>
                    <strong class="text-dark small">@Model.Prescription.RefillsRemaining refills</strong>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.PharmacyNotes))
            {
                <div class="p-3 bg-primary-subtle border border-primary border-opacity-25 rounded-3 text-start mb-4 small text-dark">
                    <strong>Pharmacy Dispensing Note:</strong> @Model.PharmacyNotes
                </div>
            }

            <div class="d-flex gap-2 justify-content-center">
                <a asp-action="Index" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                    <i class="bi bi-capsule me-1"></i> Medication Tracker
                </a>
                <button onclick="window.print();" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                    <i class="bi bi-printer me-1"></i> Print Voucher
                </button>
            </div>

        </div>
    </div>
</section>
