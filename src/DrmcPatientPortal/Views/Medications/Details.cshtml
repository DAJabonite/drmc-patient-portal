@model Prescription
@{ ViewData["Title"] = Loc["Rx_DetailTitle"]; }
<section class="page-header"><div class="container"><h1 class="display-6 fw-bold mb-0">@Loc["Rx_DetailTitle"]</h1></div></section>
<section class="section py-5 bg-light"><div class="container" style="max-width:860px">
    <partial name="_PrescriptionCard" model="Model" />
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill mt-4"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>@Loc["Rx_Back"]</a>
</div></section>
