@model EncountersIndexViewModel
@{
    ViewData["Title"] = Loc["Enc_Title"];
}

<section class="page-header">
    <div class="container">
        <div>
            <p class="small text-white text-opacity-75 mb-1">@Loc["Enc_Subtitle"]</p>
            <h1 class="display-6 fw-bold mb-0">@Loc["Enc_Title"]</h1>
        </div>
    </div>
</section>

<!-- Visit filters -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="encounterDepartmentFilter" class="form-label small fw-semibold text-dark mb-1">Filter visits by department</label>
                <select id="encounterDepartmentFilter" name="department" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDepartment))">@Loc["Enc_AllDepartments"] (@Model.Encounters.Count)</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Name" selected="@(Model.SelectedDepartment == dept.Name)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label for="encounterDateFilter" class="form-label small fw-semibold text-dark mb-1">Filter by date</label>
                <select id="encounterDateFilter" name="dateRange" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">Any date</option>
                    <option value="30d" selected="@(Model.SelectedDateRange == "30d")">Last 30 days</option>
                    <option value="6m" selected="@(Model.SelectedDateRange == "6m")">Last 6 months</option>
                    <option value="year" selected="@(Model.SelectedDateRange == "year")">This year</option>
                </select>
            </div>
        </form>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container">
        @if (Model.Encounters.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                <i class="bi bi-journal-x fs-1 text-muted mb-2"></i>
                <h3 class="h5 fw-bold text-dark">@Loc["Enc_None"]</h3>
                <p class="text-muted small mb-3">@Loc["Enc_NoneBody"]</p>
                <a asp-action="Index" class="btn btn-primary-drmc btn-sm rounded-pill px-4 fw-semibold mx-auto">
                    @Loc["Enc_ViewAll"]
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var enc in Model.Encounters)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow-sm transition">
                        <div class="row align-items-center g-3">
                            <div class="col-md-8">
                                <div class="record-metadata d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge bg-primary-subtle text-primary-drmc rounded-pill small fw-semibold">
                                        @enc.Department
                                    </span>
                                    <span class="badge bg-light text-secondary border rounded-pill small">
                                        @Loc[$"EncounterType_{enc.Type}"]
                                    </span>
                                    <span class="encounter-reference record-reference small text-muted" style="font-size: 0.75rem;">
                                        @Loc["Enc_Reference"]: <strong>@enc.EncounterReference</strong>
                                    </span>
                                </div>

                                <h2 class="h5 fw-bold text-dark mb-1">@enc.PrimaryDiagnosis</h2>

                                @if (!string.IsNullOrEmpty(enc.SecondaryDiagnosis))
                                {
                                    <span class="small text-muted d-block mb-2">@Loc["Enc_Secondary"]: @enc.SecondaryDiagnosis</span>
                                }

                                <p class="small text-muted mb-2">@enc.ClinicalSummary</p>

                                <div class="small text-muted d-flex flex-wrap gap-3" style="font-size: 0.8rem;">
                                    <span><i class="bi bi-calendar3 me-1"></i> @Loc["Enc_VisitDate"]: @enc.EncounterDate.ToString("D")</span>
                                    <span><i class="bi bi-person-badge me-1"></i> @Loc["Enc_Attending"]: @enc.AttendingPhysician</span>
                                </div>
                            </div>

                            <div class="col-md-4 text-md-end">
                                <div class="d-flex gap-2 justify-content-md-end">
                                    <a asp-action="Details" asp-route-id="@enc.Id" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                                        <i class="bi bi-file-earmark-text me-1"></i> @Loc["Enc_ViewSummary"]
                                    </a>
                                </div>
                                @if (enc.FollowUpDate.HasValue)
                                {
                                    <span class="small text-primary-drmc fw-semibold d-block mt-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-arrow-repeat me-1"></i> @Loc["Enc_FollowUp"]: @enc.FollowUpDate.Value.ToString("d")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
