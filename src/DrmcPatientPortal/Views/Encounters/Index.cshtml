@model EncountersIndexViewModel
@{
    ViewData["Title"] = Loc["Enc_Title"];
}

<section class="page-header">
    <div class="container">
        <div>
            <p class="small text-white text-opacity-75 mb-1">@Loc["Enc_Subtitle"]</p>
            <h1 class="display-6 fw-bold mb-0">@Loc["Enc_Title"]</h1>
        </div>
    </div>
</section>

<!-- Visit filters -->
<section class="encounter-filter-section py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <form asp-action="Index" method="get" class="encounter-filter-form" id="encounterFilterForm">
            <div class="encounter-filter-toolbar">
                <div class="encounter-department-field">
                    <label for="encounterDepartmentFilter" class="form-label small fw-semibold text-dark mb-1 encounter-filter-label">Visit type</label>
                    <select id="encounterDepartmentFilter" name="department" class="form-select" aria-label="Filter visits by type">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedType))">@Loc["Enc_AllTypes"] (@Model.Encounters.Count)</option>
                        <option value="OPD" selected="@(Model.SelectedType == "OPD")">@Loc["Enc_TypeOpd"]</option>
                        <option value="Emergency" selected="@(Model.SelectedType == "Emergency")">@Loc["Enc_TypeEmergencyRoom"]</option>
                        <option value="Inpatient" selected="@(Model.SelectedType == "Inpatient")">@Loc["Enc_TypeInpatient"]</option>
                    </select>
                </div>
                <button type="button"
                        class="btn btn-outline-drmc encounter-date-toggle d-md-none"
                        id="encounterDateToggle"
                        aria-expanded="@(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "true" : "false")"
                        aria-controls="encounterDatePanel">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span>Date</span>
                    @if (!string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <span class="filter-active-dot" aria-label="Date filter active"></span>
                    }
                </button>
            </div>

            <div id="encounterDatePanel" class="encounter-date-panel @(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "is-open" : null)">
                <div class="encounter-date-field">
                    <label for="encounterDateFilter" class="form-label small fw-semibold text-dark mb-1">Date</label>
                    <select id="encounterDateFilter" name="dateRange" class="form-select" aria-controls="customEncounterDateRange">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">Any date</option>
                        <option value="30d" selected="@(Model.SelectedDateRange == "30d")">Last 30 days</option>
                        <option value="6m" selected="@(Model.SelectedDateRange == "6m")">Last 6 months</option>
                        <option value="year" selected="@(Model.SelectedDateRange == "year")">This year</option>
                        <option value="custom" selected="@(Model.SelectedDateRange == "custom")">Custom date range</option>
                    </select>
                </div>

                <div id="customEncounterDateRange" class="encounter-custom-date @(Model.SelectedDateRange == "custom" ? null : "d-none")">
                    <fieldset class="custom-date-range">
                        <legend class="visually-hidden">Custom visit date range</legend>
                        <div>
                            <label for="encounterStartDate" class="form-label small fw-semibold text-dark mb-1">From</label>
                            <input id="encounterStartDate"
                                   name="startDate"
                                   type="date"
                                   value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@(Model.SelectedEndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div>
                            <label for="encounterEndDate" class="form-label small fw-semibold text-dark mb-1">To</label>
                            <input id="encounterEndDate"
                                   name="endDate"
                                   type="date"
                                   value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")"
                                   min="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                        </div>
                    </fieldset>
                    @if (ViewData["DateRangeError"] is string dateRangeError)
                    {
                        <p class="small text-danger mt-2 mb-0" role="alert">@dateRangeError</p>
                    }
                </div>

                <div class="encounter-filter-actions">
                    <button type="submit" class="btn btn-primary-drmc fw-semibold">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i> Apply
                    </button>
                    @if (!string.IsNullOrEmpty(Model.SelectedType) || !string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const rangeSelect = document.getElementById("encounterDateFilter");
            const customRange = document.getElementById("customEncounterDateRange");
            const startDate = document.getElementById("encounterStartDate");
            const endDate = document.getElementById("encounterEndDate");
            const filterForm = document.getElementById("encounterFilterForm");
            const visitTypeSelect = document.getElementById("encounterDepartmentFilter");
            const dateToggle = document.getElementById("encounterDateToggle");
            const datePanel = document.getElementById("encounterDatePanel");

            if (!rangeSelect || !customRange || !startDate || !endDate) return;

            const setDatePanelOpen = (open) => {
                datePanel?.classList.toggle("is-open", open);
                dateToggle?.setAttribute("aria-expanded", open ? "true" : "false");
            };

            const syncRangeVisibility = () => {
                const isCustom = rangeSelect.value === "custom";
                customRange.classList.toggle("d-none", !isCustom);
                startDate.required = isCustom;
                endDate.required = isCustom;
            };

            rangeSelect.addEventListener("change", syncRangeVisibility);
            startDate.addEventListener("change", () => {
                endDate.min = startDate.value;
                if (endDate.value && endDate.value < startDate.value) endDate.value = startDate.value;
            });
            endDate.addEventListener("change", () => {
                startDate.max = endDate.value || "@DateTime.Today.ToString("yyyy-MM-dd")";
            });
            dateToggle?.addEventListener("click", () => {
                setDatePanelOpen(dateToggle.getAttribute("aria-expanded") !== "true");
            });
            datePanel?.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && window.matchMedia("(max-width: 767.98px)").matches) {
                    setDatePanelOpen(false);
                    dateToggle?.focus();
                }
            });
            visitTypeSelect?.addEventListener("change", () => {
                if (window.matchMedia("(max-width: 767.98px)").matches) filterForm?.requestSubmit();
            });

            syncRangeVisibility();
        })();
    </script>
}

<section class="section py-5 bg-light">
    <div class="container">
        @if (Model.Encounters.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                <i class="bi bi-journal-x fs-1 text-muted mb-2"></i>
                <h3 class="h5 fw-bold text-dark">@Loc["Enc_None"]</h3>
                <p class="text-muted small mb-3">@Loc["Enc_NoneBody"]</p>
                <a asp-action="Index" class="btn btn-primary-drmc btn-sm rounded-pill px-4 fw-semibold mx-auto">
                    @Loc["Enc_ViewAll"]
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var enc in Model.Encounters)
                {
                    var encounterTypeLabel = enc.Type switch
                    {
                        EncounterType.Emergency => "Enc_TypeEmergencyRoom",
                        EncounterType.Inpatient => "Enc_TypeInpatient",
                        _ => "Enc_TypeOpd"
                    };
                    var encounterTypeClass = enc.Type switch
                    {
                        EncounterType.Emergency => "bg-danger-subtle text-danger-emphasis",
                        EncounterType.Inpatient => "bg-info-subtle text-info-emphasis",
                        _ => "bg-success-subtle text-success"
                    };
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow-sm transition">
                        <div class="row align-items-center g-3">
                            <div class="col-md-8">
                                <div class="record-metadata d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge @encounterTypeClass rounded-pill small fw-semibold">
                                        @Loc[encounterTypeLabel]
                                    </span>
                                    <span class="badge bg-primary-subtle text-primary-drmc rounded-pill small fw-semibold">
                                        @enc.Department
                                    </span>
                                    <span class="encounter-reference record-reference small text-muted" style="font-size: 0.75rem;">
                                        @Loc["Enc_Reference"]: <strong>@enc.EncounterReference</strong>
                                    </span>
                                </div>

                                <h2 class="h5 fw-bold text-dark mb-1">@enc.PrimaryDiagnosis</h2>

                                @if (!string.IsNullOrEmpty(enc.SecondaryDiagnosis))
                                {
                                    <span class="small text-muted d-block mb-2">@Loc["Enc_Secondary"]: @enc.SecondaryDiagnosis</span>
                                }

                                <p class="small text-muted mb-2">@enc.ClinicalSummary</p>

                                <div class="small text-muted d-flex flex-wrap gap-3" style="font-size: 0.8rem;">
                                    <span><i class="bi bi-calendar3 me-1"></i> @Loc["Enc_VisitDate"]: @enc.EncounterDate.ToString("D")</span>
                                    <span><i class="bi bi-person-badge me-1"></i> @Loc["Enc_Attending"]: @enc.AttendingPhysician</span>
                                </div>
                            </div>

                            <div class="col-md-4 text-md-end">
                                <div class="d-flex gap-2 justify-content-md-end">
                                    <a asp-action="Details" asp-route-id="@enc.Id" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                                        <i class="bi bi-file-earmark-text me-1"></i> @Loc["Enc_ViewSummary"]
                                    </a>
                                </div>
                                @if (enc.FollowUpDate.HasValue)
                                {
                                    <span class="small text-primary-drmc fw-semibold d-block mt-2" style="font-size: 0.75rem;">
                                        <i class="bi bi-arrow-repeat me-1"></i> @Loc["Enc_FollowUp"]: @enc.FollowUpDate.Value.ToString("d")
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
