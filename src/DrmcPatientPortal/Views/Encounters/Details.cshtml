@model ClinicalEncounter
@{
    ViewData["Title"] = $"After-Visit Summary — {Model.EncounterReference}";
}

<section class="py-4 bg-primary-drmc text-white shadow-sm d-print-none">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All Clinical Notes
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@Model.Department</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">After-Visit Clinical Summary</h1>
        <p class="text-white text-opacity-90 mb-0">Encounter Reference: <strong>@Model.EncounterReference</strong> &middot; Davao Regional Medical Center</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 880px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            <!-- Header Meta -->
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 pb-4 mb-4 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill small fw-semibold mb-2">
                        @Model.Department &middot; @Model.Type
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">@Model.PrimaryDiagnosis</h2>
                    @if (!string.IsNullOrEmpty(Model.SecondaryDiagnosis))
                    {
                        <p class="text-muted small mb-0">Secondary: @Model.SecondaryDiagnosis</p>
                    }
                </div>

                <div class="text-md-end">
                    <span class="badge bg-success px-3 py-1 rounded-pill mb-1">
                        Completed Encounter
                    </span>
                    <div class="small text-muted" style="font-size: 0.8rem;">
                        Visit Date: @Model.EncounterDate.ToString("MMMM d, yyyy")
                    </div>
                </div>
            </div>

            <!-- Attending Doctor & Vitals -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Attending Physician</span>
                        <strong class="small text-dark">@Model.AttendingPhysician</strong>
                        <div class="small text-muted mt-1">@Model.Department Outpatient Clinic</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Recorded Vital Signs</span>
                        <strong class="small text-primary-drmc">@Model.VitalSignsRecorded</strong>
                    </div>
                </div>
            </div>

            <!-- Chief Complaint & Clinical Findings -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-2">Chief Complaint &amp; Clinical Progress Notes</h3>
                <div class="p-3 bg-light rounded-3 border mb-3 small">
                    <strong class="text-dark d-block mb-1">Presenting Complaint:</strong>
                    <p class="text-muted mb-0">@Model.ChiefComplaint</p>
                </div>
                <div class="p-3 bg-light rounded-3 border small">
                    <strong class="text-dark d-block mb-1">Clinical Evaluation Summary:</strong>
                    <p class="text-muted mb-0 leading-relaxed">@Model.ClinicalSummary</p>
                </div>
            </div>

            <!-- Care Plan, Medications & Home Instructions -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-2">Physician Care Plan &amp; Patient Home Instructions</h3>
                <div class="p-4 bg-primary-subtle border border-primary border-opacity-25 rounded-3 text-dark small leading-relaxed">
                    @Html.Raw(Model.CarePlanAndInstructions.Replace("\n", "<br />"))
                </div>
            </div>

            <!-- Scheduled Follow-Up -->
            @if (Model.FollowUpDate.HasValue)
            {
                <div class="p-3 bg-light rounded-3 border mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <strong class="text-dark small d-block">
                            <i class="bi bi-calendar-event text-primary-drmc me-1"></i> Recommended Next Follow-Up:
                        </strong>
                        <span class="small text-muted">@Model.FollowUpDate.Value.ToString("MMMM d, yyyy") &middot; @Model.FollowUpNotes</span>
                    </div>
                    <a asp-controller="Appointments" asp-action="Book" asp-route-department="@Model.Department" class="btn btn-sm btn-primary-drmc rounded-pill px-3 fw-semibold shadow-xs">
                        Book Follow-Up Slot
                    </a>
                </div>
            }

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3 border-top d-print-none">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Back to Notes
                </a>
                <div class="d-flex gap-2">
                    <a asp-controller="Medications" asp-action="Index" class="btn btn-outline-drmc rounded-pill px-3 fw-semibold">
                        <i class="bi bi-capsule me-1"></i> View Prescriptions
                    </a>
                    <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                        <i class="bi bi-printer-fill me-1"></i> Print Summary Slip
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
