@model RedStarPatientReportPage
@{
    var report = Model.Report;
    ViewData["Title"] = report.Description;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var hasReturnUrl = Url.IsLocalUrl(returnUrl);
    var backUrl = hasReturnUrl ? Url.Content(returnUrl) : Url.Action("Index", "LabResults");
    var card = new PatientReportCard
    {
        Id = report.Id, Source = "redstar", Description = report.Description,
        ClinicalEncounterId = report.ClinicalEncounterId,
        EncounterReference = report.Encounter.EncounterReference,
        EncounterDate = report.Encounter.EncounterDate, ExamDate = report.CollectedAt,
        Status = report.Status, CanOpenPdf = Model.CanOpenPdf,
        HasPdf = !string.IsNullOrWhiteSpace(report.ReportFileName)
    };
}
<section class="patient-record-header"><div class="container patient-report-detail-container">
    <a href="@backUrl" class="patient-record-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> @(hasReturnUrl ? Loc["Report_BackPrevious"] : Loc["Report_BackLab"])</a>
    <p class="patient-record-eyebrow">@Loc["PatientUX_ResultsTitle"]</p>
    <h1 class="h2 fw-bold text-break mb-0">@report.Description</h1>
</div></section>
<section class="section patient-report-section"><div class="container patient-report-detail-container">
    <partial name="_PatientReportDetails" model="card" />
</div></section>
