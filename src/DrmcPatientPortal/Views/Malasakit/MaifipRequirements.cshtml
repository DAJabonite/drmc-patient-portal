@model ResolvedInstitutionalGuide
@{
    ViewData["Title"] = Model.Content.PageTitle;
    var content = Model.Content;
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> @content.ParentLabel
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@content.Breadcrumb</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">@content.Heading</h1>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 960px;">
        <details class="requirement-disclosure card border-0 shadow-sm rounded-4 bg-white mb-4">
            <summary class="requirement-disclosure-summary p-4 p-md-5">
                <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">1</span>
                <span class="h4 fw-bold text-primary-drmc mb-0 flex-grow-1">@content.Sections[0].Title</span>
                <i class="bi bi-chevron-down requirement-disclosure-chevron" aria-hidden="true"></i>
            </summary>

            <div class="d-flex flex-column gap-3 px-4 px-md-5 pb-4 pb-md-5">
                @for (var itemIndex = 0; itemIndex < content.Sections[0].Items.Count; itemIndex++)
                {
                    var item = content.Sections[0].Items[itemIndex];
                    var icon = itemIndex switch { 0 => "bi-prescription2", 1 => "bi-file-earmark-medical", 2 => "bi-person-vcard", 3 => "bi-receipt", _ => "bi-file-earmark-check" };
                    <div class="p-3 rounded-3 bg-light border d-flex gap-3 align-items-start">
                        <i class="bi @icon fs-5 text-primary-drmc"></i>
                        <div>
                            <h3 class="h6 fw-bold text-dark mb-1">@item.Title</h3>
                            <p class="small text-muted @(string.IsNullOrEmpty(item.SupplementalHtml) ? "mb-0" : "mb-2")">@Html.Raw(item.BodyHtml)</p>
                            @if (!string.IsNullOrEmpty(item.SupplementalHtml))
                            {
                                <div class="text-dark ps-3">@Html.Raw(item.SupplementalHtml)</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </details>

        <details class="requirement-disclosure card border-0 shadow-sm rounded-4 bg-white mb-4">
            <summary class="requirement-disclosure-summary p-4 p-md-5">
                <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">2</span>
                <span class="h4 fw-bold text-primary-drmc mb-0 flex-grow-1">@content.Sections[1].Title</span>
                <i class="bi bi-chevron-down requirement-disclosure-chevron" aria-hidden="true"></i>
            </summary>
            <div class="px-4 px-md-5 pb-4 pb-md-5">
                <div class="p-3 rounded-3 bg-light border">
                    @for (var paragraphIndex = 0; paragraphIndex < content.Sections[1].Paragraphs.Count; paragraphIndex++)
                    {
                        <p class="small text-dark @(paragraphIndex == content.Sections[1].Paragraphs.Count - 1 ? "mb-0" : "mb-2")">@Html.Raw(content.Sections[1].Paragraphs[paragraphIndex])</p>
                    }
                </div>
            </div>
        </details>

        <details class="requirement-disclosure card border-0 shadow-sm rounded-4 bg-white">
            <summary class="requirement-disclosure-summary p-4 p-md-5">
                <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">3</span>
                <span class="h4 fw-bold text-primary-drmc mb-0 flex-grow-1">@content.Sections[2].Title</span>
                <i class="bi bi-chevron-down requirement-disclosure-chevron" aria-hidden="true"></i>
            </summary>
            <div class="table-responsive mx-4 mx-md-5 mb-4 mb-md-5" role="region" aria-label="@content.Sections[2].RegionLabel" tabindex="0">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">@content.Sections[2].FirstColumnHeading</th>
                            <th scope="col">@content.Sections[2].SecondColumnHeading</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in content.Sections[2].Rows)
                        {
                            <tr><td>@row.Hospital</td><td>@row.NextStep</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>

        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> @content.BackLabel
            </a>
        </div>
        <partial name="_GuideReview" model="Model" />
    </div>
</section>
