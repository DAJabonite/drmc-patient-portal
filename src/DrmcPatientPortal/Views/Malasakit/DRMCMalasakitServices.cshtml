@model ResolvedInstitutionalGuide
@{
    ViewData["Title"] = Model.Content.PageTitle;
    var content = Model.Content;
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> @content.ParentLabel
            </a>
            <span class="text-white text-opacity-50" aria-hidden="true">/</span>
            <span class="small text-white text-opacity-75">@content.Breadcrumb</span>
        </div>
        <div>
            <h1 class="display-6 fw-bold mb-2">@content.Heading</h1>
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 860px;">
        <article class="dswd-requirement-card card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="requirement-icon text-primary-drmc">
                    <i class="bi bi-file-earmark-check" aria-hidden="true"></i>
                </span>
                <div>
                    <h2 class="h4 fw-bold text-primary-drmc mb-0">@content.Sections[0].Title</h2>
                </div>
            </div>

            <ul class="requirement-list requirement-list-spacious mb-0">
                @foreach (var item in content.Sections[0].Items)
                {
                    <li>@Html.Raw(item.BodyHtml)</li>
                }
            </ul>
        </article>

        <div class="mt-4 pt-4 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> @content.BackLabel
            </a>
        </div>
        <partial name="_GuideReview" model="Model" />
    </div>
</section>
