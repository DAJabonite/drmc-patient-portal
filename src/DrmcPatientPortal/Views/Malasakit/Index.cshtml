@model IReadOnlyList<AssistanceProgram>
@{
    ViewData["Title"] = "Medical Social Services & Malasakit Center";
}

<!-- Hero Section -->
<section class="page-header">
    <div class="container">
        <div>
            <p class="small text-white text-opacity-75 mb-2">Republic Act No. 11463 · Malasakit Centers Act</p>
            <h1 class="display-6 fw-bold mb-0">Malasakit Center &amp; Social Services</h1>
        </div>
    </div>
</section>

<!-- Participating service providers -->
<section class="malasakit-provider-band py-3 bg-white border-bottom">
    <div class="container">
        <div class="d-flex align-items-center justify-content-around flex-wrap gap-3 text-center">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/doh-seal.png" alt="DOH" style="height: 36px; width: auto;" />
                <span class="small fw-bold text-dark">DOH MAIP</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-hospital fs-4 text-primary-drmc" aria-hidden="true"></i>
                <span class="small fw-bold text-dark">PhilHealth Konsulta</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill fs-4 text-primary-drmc" aria-hidden="true"></i>
                <span class="small fw-bold text-dark">DSWD AICS</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/drmc-seal.png" alt="DRMC" style="height: 36px; width: auto;" />
                <span class="small fw-bold text-dark">DRMC</span>
            </div>
        </div>
    </div>
</section>

<!-- How to Avail Step-by-Step Guide -->
<section class="section py-5 bg-light">
    <div class="container">
        <div>
            <div class="mb-4">
                <h2 class="h4 fw-bold text-primary-drmc mb-0">Government Service Guides</h2>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <a asp-action="DSWDServices" class="dswd-service-tile card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-decoration-none" aria-label="Open DSWD services and requirements guide">
                        <div class="d-flex align-items-start gap-3">
                            <span class="dswd-service-icon" aria-hidden="true">
                                <i class="bi bi-people-fill"></i>
                            </span>
                            <span class="flex-grow-1">
                                <span class="badge bg-primary-subtle text-primary-drmc rounded-pill mb-2">DSWD AICS</span>
                                <span class="h5 fw-bold text-dark d-block mb-2">DSWD Services</span>
                                <span class="small text-primary-drmc fw-semibold">View requirements <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                            </span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-3">
                    <a asp-action="DRMCMalasakitServices" class="dswd-service-tile card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-decoration-none" aria-label="Open DRMC Malasakit Services document preparation guide">
                        <div class="d-flex align-items-start gap-3">
                            <span class="dswd-service-icon" aria-hidden="true">
                                <i class="bi bi-folder-check"></i>
                            </span>
                            <span class="flex-grow-1">
                                <span class="badge bg-primary-subtle text-primary-drmc rounded-pill mb-2">DRMC Malasakit Center</span>
                                <span class="h5 fw-bold text-dark d-block mb-2">DRMC Malasakit Services</span>
                                <span class="small text-primary-drmc fw-semibold">View checklist <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                            </span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-3">
                    <a asp-action="MaifipRequirements" class="dswd-service-tile card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-decoration-none" aria-label="Open DOH MAIFIP requirements guide">
                        <div class="d-flex align-items-start gap-3">
                            <span class="dswd-service-icon" aria-hidden="true">
                                <i class="bi bi-file-earmark-medical"></i>
                            </span>
                            <span class="flex-grow-1">
                                <span class="badge bg-primary-subtle text-primary-drmc rounded-pill mb-2">DOH MAIFIP</span>
                                <span class="h5 fw-bold text-dark d-block mb-2">DOH-MAIFIP Requirements</span>
                                <span class="small text-primary-drmc fw-semibold">View requirements <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                            </span>
                        </div>
                    </a>
                </div>
                <div class="col-md-6 col-lg-3">
                    <a asp-action="Philhealth" class="dswd-service-tile card border-0 shadow-sm rounded-4 h-100 p-4 bg-white text-decoration-none" aria-label="Open PhilHealth requirements guide">
                        <div class="d-flex align-items-start gap-3">
                            <span class="dswd-service-icon" aria-hidden="true">
                                <i class="bi bi-hospital"></i>
                            </span>
                            <span class="flex-grow-1">
                                <span class="badge bg-primary-subtle text-primary-drmc rounded-pill mb-2">PhilHealth</span>
                                <span class="h5 fw-bold text-dark d-block mb-2">PhilHealth Requirements</span>
                                <span class="small text-primary-drmc fw-semibold">View requirements <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        </div>

    </div>
</section>
