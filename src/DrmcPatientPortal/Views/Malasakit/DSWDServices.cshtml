@model ResolvedInstitutionalGuide
@{
    ViewData["Title"] = Model.Content.PageTitle;
    var content = Model.Content;
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> @content.ParentLabel
            </a>
            <span class="text-white text-opacity-50" aria-hidden="true">/</span>
            <span class="small text-white text-opacity-75">@content.Breadcrumb</span>
        </div>
        <div>
            <span class="badge bg-primary-subtle text-primary-drmc rounded-pill mb-2">@content.Badge</span>
            <h1 class="display-6 fw-bold mb-2">@content.Heading</h1>
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container">
        <div class="row g-4 dswd-requirements-grid">
            @for (var sectionIndex = 0; sectionIndex < content.Sections.Count; sectionIndex++)
            {
                var requirements = content.Sections[sectionIndex];
                var icon = sectionIndex switch { 0 => "bi-capsule-pill", 1 => "bi-clipboard2-pulse", 2 => "bi-receipt-cutoff", 3 => "bi-flower1", _ => "bi-file-earmark-check" };
                <div class="col-md-6">
                    <details class="dswd-requirement-card requirement-disclosure card border-0 shadow-sm rounded-4 bg-white">
                        <summary class="requirement-disclosure-summary p-4">
                            <span class="requirement-icon bg-primary-subtle text-primary-drmc"><i class="bi @icon" aria-hidden="true"></i></span>
                            <span class="flex-grow-1">
                                <span class="h5 fw-bold text-primary-drmc d-block mb-0">@requirements.Title</span>
                            </span>
                            <i class="bi bi-chevron-down requirement-disclosure-chevron" aria-hidden="true"></i>
                        </summary>
                        <div class="px-4 pb-4">
                            <ul class="requirement-list mb-0">
                                @foreach (var item in requirements.Items)
                                {
                                    <li>@Html.Raw(item.BodyHtml)</li>
                                }
                            </ul>
                        </div>
                    </details>
                </div>
            }
        </div>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 pt-4 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> @content.BackLabel
            </a>
        </div>
        <partial name="_GuideReview" model="Model" />
    </div>
</section>
