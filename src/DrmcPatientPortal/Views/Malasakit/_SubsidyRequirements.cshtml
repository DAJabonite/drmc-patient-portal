@model SubsidyRequirementsInput
<fieldset class="mb-4">
    <legend class="h5">@Loc["Subsidy_Requirements"]</legend>
    <p class="text-muted small">@Loc["Subsidy_RequirementsHelp"]</p>
    <div class="form-check mb-3">
        <input asp-for="GovernmentIdReady" class="form-check-input" />
        <label asp-for="GovernmentIdReady" class="form-check-label">@Loc["Subsidy_Id"]</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="ClinicalDocumentReady" class="form-check-input" />
        <label asp-for="ClinicalDocumentReady" class="form-check-label">@Loc["Subsidy_Clinical"]</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="CostDocumentReady" class="form-check-input" />
        <label asp-for="CostDocumentReady" class="form-check-label">@Loc["Subsidy_Cost"]</label>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IndigencyDocumentReady" class="form-check-input" />
        <label asp-for="IndigencyDocumentReady" class="form-check-label">@Loc["Subsidy_Indigency"]</label>
    </div>
</fieldset>
