@model MedicalHistoryViewModel
@{ ViewData["Title"] = Loc["History_Title"]; }
<section class="page-header">
    <div class="container">
        <h1 class="h2 fw-bold">@Loc["History_Title"]</h1>
        <p class="mb-0">@Loc["History_Description"]</p>
    </div>
</section>
<section class="section py-4">
    <div class="container">
        <a asp-controller="Patient" asp-action="Home" class="d-inline-block mb-3">@Loc["Nav_Dashboard"]</a>
        <nav class="d-flex flex-wrap gap-2 mb-4" aria-label="@Loc["History_Categories"]">
            <a asp-action="Index" class="btn @(Model.SelectedCategory is null ? "btn-drmc" : "btn-outline-drmc")" aria-current="@(Model.SelectedCategory is null ? "page" : null)">@Loc["History_All"] (@Model.Records.Count)</a>
            @foreach (var category in MedicalHistoryViewModel.Categories)
            {
                <a asp-action="Index" asp-route-category="@category" class="btn @(Model.SelectedCategory == category ? "btn-drmc" : "btn-outline-drmc")" aria-current="@(Model.SelectedCategory == category ? "page" : null)">@Loc[$"History_{category}"] (@Model.Records.Count(e => MedicalHistoryViewModel.CategoryFor(e.Type) == category))</a>
            }
        </nav>
        @foreach (var category in MedicalHistoryViewModel.Categories.Where(c => Model.SelectedCategory is null || c == Model.SelectedCategory))
        {
            var records = Model.Records.Where(e => MedicalHistoryViewModel.CategoryFor(e.Type) == category).ToList();
            <section class="mb-4" aria-labelledby="heading-@category">
                <h2 class="h5 fw-bold" id="heading-@category">@Loc[$"History_{category}"]</h2>
                @if (records.Count == 0)
                {
                    <p class="text-muted border rounded-3 p-3">@Loc["History_Empty"]</p>
                }
                @foreach (var record in records)
                {
                    <article class="bg-white border rounded-3 p-3 mb-2">
                        <div class="d-flex flex-wrap gap-2 small text-muted mb-2">
                            <time datetime="@record.EncounterDate.ToString("yyyy-MM-dd")">@record.EncounterDate.ToString("D")</time>
                            <span>@record.Department</span><span>@Loc[$"EncounterType_{record.Type}"]</span>
                        </div>
                        <h3 class="h6 fw-bold">@record.PrimaryDiagnosis</h3>
                        <p class="mb-2">@record.ClinicalSummary</p>
                        <a asp-controller="Visits" asp-action="Details" asp-route-id="@record.Id">@Loc["Enc_ViewSummary"]<span class="visually-hidden">: @record.EncounterReference</span></a>
                    </article>
                }
            </section>
        }
    </div>
</section>
