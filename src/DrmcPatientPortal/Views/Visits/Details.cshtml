@model ClinicalEncounter
@{
    ViewData["Title"] = $"{Loc["Enc_ClinicalSummary"]} — {Model.EncounterReference}";
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> @Loc["Enc_AllNotes"]
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@Model.Department</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">@Loc["Enc_ClinicalSummary"]</h1>
        <p class="text-white text-opacity-90 mb-0">@Loc["Enc_Reference"]: <strong>@Model.EncounterReference</strong> &middot; Davao Regional Medical Center</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 880px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">

            <!-- Header Meta -->
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 pb-4 mb-4 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill small fw-semibold mb-2">
                        @Model.Department &middot; @Loc[$"EncounterType_{Model.Type}"]
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">@Model.PrimaryDiagnosis</h2>
                    @if (!string.IsNullOrEmpty(Model.SecondaryDiagnosis))
                    {
                        <p class="text-muted small mb-0">@Loc["Enc_Secondary"]: @Model.SecondaryDiagnosis</p>
                    }
                </div>

                <div class="text-md-end">
                    <span class="badge bg-success px-3 py-1 rounded-pill mb-1">
                        @Loc["Enc_Completed"]
                    </span>
                    <div class="small text-muted" style="font-size: 0.8rem;">
                        @Loc["Enc_VisitDate"]: @Model.EncounterDate.ToString("D")
                    </div>
                </div>
            </div>

            <!-- Attending Doctor & Vitals -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">@Loc["Enc_Physician"]</span>
                        <strong class="small text-dark">@Model.AttendingPhysician</strong>
                        <div class="small text-muted mt-1">@Loc["Enc_OutpatientClinic", Model.Department]</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">@Loc["Enc_Vitals"]</span>
                        <strong class="small text-primary-drmc">@Model.VitalSignsRecorded</strong>
                    </div>
                </div>
            </div>

            <!-- Chief Complaint & Clinical Findings -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-2">@Loc["Enc_Complaint"]</h3>
                <div class="p-3 bg-light rounded-3 border mb-3 small">
                    <strong class="text-dark d-block mb-1">@Loc["Enc_PresentingComplaint"]:</strong>
                    <p class="text-muted mb-0">@Model.ChiefComplaint</p>
                </div>
                <div class="p-3 bg-light rounded-3 border small">
                    <strong class="text-dark d-block mb-1">@Loc["Enc_Evaluation"]:</strong>
                    <p class="text-muted mb-0 leading-relaxed">@Model.ClinicalSummary</p>
                </div>
            </div>

            <!-- Care Plan, Medications & Home Instructions -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-2">@Loc["Enc_CarePlan"]</h3>
                <div class="p-4 bg-primary-subtle border border-primary border-opacity-25 rounded-3 text-dark small leading-relaxed" style="white-space: pre-line;">
                    @Model.CarePlanAndInstructions
                </div>
            </div>

            @foreach (var reportSection in new[] {
                (Title: "Laboratory requests and reports", Key: "LaboratoryRequests"),
                (Title: "Radiology requests and reports", Key: "RadiologyRequests") })
            {
                var requests = ViewData[reportSection.Key] as IReadOnlyList<PatientReportCard> ?? Array.Empty<PatientReportCard>();
                <section class="mb-4" aria-label="@reportSection.Title">
                    <h3 class="h6 fw-bold text-primary-drmc">@reportSection.Title (@requests.Count)</h3>
                    @if (requests.Count == 0) { <p class="small text-muted">No requests recorded for this encounter.</p> }
                    @foreach (var request in requests.OrderByDescending(r => r.ActivityAt).ThenBy(r => r.Source).ThenByDescending(r => r.Id))
                    { <partial name="_PatientReportCard" model="request" /> }
                </section>
            }
            <section class="mb-4" aria-labelledby="encounterPrescriptionsHeading">
                <h3 id="encounterPrescriptionsHeading" class="h6 fw-bold text-primary-drmc">Prescriptions (@Model.Prescriptions.Count)</h3>
                @if (Model.Prescriptions.Count == 0) { <p class="small text-muted">No prescriptions recorded for this encounter.</p> }
                @foreach (var rx in Model.Prescriptions)
                {
                    <div class="border rounded-3 p-3 mb-2">
                        <strong>@rx.GenericName @rx.Dosage</strong>
                        <span class="badge bg-light text-dark border">@rx.Status</span>
                        <p class="small mb-1">@rx.Frequency · Prescribed @rx.PrescribedAt.ToString("MMM d, yyyy")</p>
                        <a asp-controller="Medications" asp-action="Details" asp-route-id="@rx.Id" class="small fw-semibold">Prescription details</a>
                    </div>
                }
            </section>

            <!-- Scheduled Follow-Up -->
            @if (Model.FollowUpDate.HasValue)
            {
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <strong class="text-dark small d-block">
                        <i class="bi bi-calendar-event text-primary-drmc me-1"></i> @Loc["Enc_RecommendedFollowUp"]:
                    </strong>
                    <span class="small text-muted">@Model.FollowUpDate.Value.ToString("D") &middot; @Model.FollowUpNotes</span>
                </div>
            }

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> @Loc["Enc_BackNotes"]
                </a>
                <div class="d-flex gap-2">
                    <a asp-controller="Medications" asp-action="Index" class="btn btn-outline-drmc rounded-pill px-3 fw-semibold">
                        <i class="bi bi-capsule me-1"></i> @Loc["Enc_ViewPrescriptions"]
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
