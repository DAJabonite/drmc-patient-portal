@model AdvisoriesIndexViewModel
@{
    ViewData["Title"] = "Public Health Advisories & Hospital Bulletins";
}

<!-- Hero Section -->
<section class="page-header">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                        <i class="bi bi-megaphone-fill me-1"></i> Official Announcements
                    </span>
                    <span class="small text-white text-opacity-75">DOH Region XI &amp; DRMC Public Health</span>
                </div>
                <h1 class="display-6 fw-bold mb-0">Health Advisories &amp; Bulletins</h1>
            </div>

            <div class="col-lg-5">
                <form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-dark">
                    <label for="advisorySearch" class="form-label fw-bold text-primary-drmc small mb-2">
                        <i class="bi bi-search me-1"></i> Search Advisories &amp; Notices
                    </label>
                    <div class="input-group page-header-search-control">
                        <input id="advisorySearch" type="search" name="search" value="@Model.SearchTerm" class="form-control form-control-sm"
                               placeholder="e.g. Dengue, Vaccine, Schedule, Konsulta" aria-label="Search Advisories" />
                        <button type="submit" class="btn btn-sm btn-primary-drmc px-3 fw-semibold" aria-label="Search advisories">
                            <i class="bi bi-search" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">Search</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- Category Filter Pills -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <div class="d-flex align-items-center gap-1 overflow-x-auto pb-1" style="max-width: 100%;">
            <a asp-action="Index" asp-route-search="@Model.SearchTerm"
               class="btn btn-sm @(!Model.SelectedCategory.HasValue ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                All Bulletins (@Model.Advisories.Count)
            </a>
            <a asp-action="Index" asp-route-category="@AdvisoryCategory.HealthAlert" asp-route-search="@Model.SearchTerm"
               class="btn btn-sm @(Model.SelectedCategory == AdvisoryCategory.HealthAlert ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> Health Alerts
            </a>
            <a asp-action="Index" asp-route-category="@AdvisoryCategory.Vaccination" asp-route-search="@Model.SearchTerm"
               class="btn btn-sm @(Model.SelectedCategory == AdvisoryCategory.Vaccination ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                <i class="bi bi-shield-plus text-primary-drmc me-1"></i> Vaccination Drives
            </a>
            <a asp-action="Index" asp-route-category="@AdvisoryCategory.HospitalNotice" asp-route-search="@Model.SearchTerm"
               class="btn btn-sm @(Model.SelectedCategory == AdvisoryCategory.HospitalNotice ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                <i class="bi bi-building text-secondary me-1"></i> Hospital Notices
            </a>
            <a asp-action="Index" asp-route-category="@AdvisoryCategory.SeasonalHealth" asp-route-search="@Model.SearchTerm"
               class="btn btn-sm @(Model.SelectedCategory == AdvisoryCategory.SeasonalHealth ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                <i class="bi bi-sun text-warning me-1"></i> Seasonal Health
            </a>
            <a asp-action="Index" asp-route-category="@AdvisoryCategory.Advisory" asp-route-search="@Model.SearchTerm"
               class="btn btn-sm @(Model.SelectedCategory == AdvisoryCategory.Advisory ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                <i class="bi bi-info-circle text-info me-1"></i> General Advisories
            </a>
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container">

        <!-- Pinned Urgent Alert Banner (if available) -->
        @if (Model.PinnedAlert is not null && !Model.SelectedCategory.HasValue && string.IsNullOrEmpty(Model.SearchTerm))
        {
            var pinned = Model.PinnedAlert;
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-danger text-white mb-5 position-relative overflow-hidden">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-white text-danger fw-bold px-3 py-1 rounded-pill">
                        <i class="bi bi-bell-fill me-1"></i> URGENT HEALTH ALERT
                    </span>
                    <span class="small text-white text-opacity-85">Published @pinned.PublishedAt.ToString("MMMM d, yyyy")</span>
                </div>
                <h2 class="h4 fw-bold mb-2">@pinned.Title</h2>
                <p class="text-white text-opacity-95 small mb-3" style="max-width: 720px;">
                    @pinned.Summary
                </p>
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top border-white border-opacity-25">
                    <span class="small text-white text-opacity-75">
                        <i class="bi bi-shield-check me-1"></i> Issuing Unit: @pinned.IssuingUnit
                    </span>
                    <a asp-action="Details" asp-route-slug="@pinned.Slug" class="btn btn-light btn-sm text-danger fw-bold rounded-pill px-4">
                        Read Full Alert &rarr;
                    </a>
                </div>
            </div>
        }

        <!-- Advisories Cards Grid -->
        <div class="row g-4">
            @foreach (var adv in Model.Advisories)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white advisory-card d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge @(adv.Category == AdvisoryCategory.HealthAlert ? "bg-danger-subtle text-danger" : adv.Category == AdvisoryCategory.Vaccination ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary-drmc") rounded-pill small">
                                @adv.Category
                            </span>
                            <span class="small text-muted" style="font-size: 0.75rem;">
                                @adv.PublishedAt.ToString("MMM d, yyyy")
                            </span>
                        </div>

                        <h3 class="h6 fw-bold text-dark mb-2">@adv.Title</h3>
                        <p class="small text-muted mb-3 flex-grow-1">@adv.Summary</p>

                        <div class="small text-muted mb-3" style="font-size: 0.75rem;">
                            <i class="bi bi-hospital me-1"></i> @adv.IssuingUnit
                        </div>

                        <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                            <span class="small text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-eye me-1"></i> @adv.ViewCount views
                            </span>
                            <a asp-action="Details" asp-route-slug="@adv.Slug" class="small text-primary-drmc fw-semibold text-decoration-none">
                                Read More &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>
