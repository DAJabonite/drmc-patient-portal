@{ ViewData["Title"] = "Staff access required"; }
<section class="container py-4">
    <h1 class="h3">Staff access required</h1>
    <p>This area requires an Admin account with a confirmed email and an authenticator sign-in.</p>
    <p>Select "Forget this browser" under Two-factor authentication, then sign in again with an authenticator code.</p>
    <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication" class="btn btn-primary">Two-factor authentication</a>
</section>
