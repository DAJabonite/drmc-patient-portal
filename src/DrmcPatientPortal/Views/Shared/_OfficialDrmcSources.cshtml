<aside class="border rounded-3 p-3 my-3" aria-label="@Loc["Sources_Title"]">
    <h2 class="h6 mb-2">@Loc["Sources_Title"]</h2>
    <p class="small mb-2">@Loc["Sources_Description"]</p>
    <div class="d-flex flex-wrap gap-3">
        <a href="@OfficialDrmcSources.Arta">@Loc["Sources_Arta"] <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
        <a href="@OfficialDrmcSources.CitizenCharter">@Loc["Sources_Charter"] <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
    </div>
</aside>
