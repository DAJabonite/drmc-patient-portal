@model PatientReportPage
@{ var kind = ViewData["ReportKind"] as string ?? "lab"; }
<p class="small text-muted">@Model.Pagination.Total encounters · @Model.RequestCount requests · @Model.PdfCount attached PDFs. Recently updated encounters appear first.</p>
@if (Model.EncounterGroups.Count == 0 && Model.LegacyReports.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4" data-testid="@(kind + "-no-match")">
        <h2 class="h5">No requests match these filters</h2>
        <p class="text-muted">Try another encounter date, description or status.</p>
        <a asp-action="Index" class="fw-semibold">Clear filters and view all requests</a>
    </div>
}
<div class="d-flex flex-column gap-3">
    @for (var i = 0; i < Model.EncounterGroups.Count; i++)
    {
        var group = Model.EncounterGroups[i];
        <details class="card border-0 shadow-sm rounded-4 bg-white" data-testid="@(kind + "-encounter-group")" data-encounter-id="@group.EncounterId" open="@(i == 0)">
            <summary class="p-4 fw-bold text-primary-drmc text-break">
                Encounter @group.Reference · <time datetime="@group.Date.ToString("yyyy-MM-dd")">@group.Date.ToString("MMM d, yyyy")</time>
                <span class="badge bg-light text-secondary border ms-2">@group.Reports.Count requests · @group.Reports.Count(r => r.HasPdf) PDFs</span>
            </summary>
            <div class="px-4 pb-4">
                @foreach (var report in group.Reports) { <partial name="_PatientReportCard" model="report" /> }
            </div>
        </details>
    }
</div>
@if (Model.Pagination.Total > 0) { <partial name="_Pagination" model="Model.Pagination" /> }
@if (Model.LegacyExcluded)
{ <p class="small text-muted">Records with an encounter not assigned are excluded from encounter-date filters. Clear the date filter to see them.</p> }
@if (Model.LegacyPagination.Total > 0)
{
    <section class="card border-0 shadow-sm rounded-4 p-4 bg-white mt-4" aria-labelledby="legacyReportsHeading" data-testid="@(kind + "-unassigned")">
        <h2 id="legacyReportsHeading" class="h5 fw-bold">Encounter not assigned</h2>
        <p class="small text-muted">These historical records remain available while their originating encounter is unassigned.</p>
        @foreach (var report in Model.LegacyReports) { <partial name="_PatientReportCard" model="report" /> }
        <partial name="_Pagination" model="Model.LegacyPagination" />
    </section>
}
