@model PatientReportCard
@using Microsoft.AspNetCore.WebUtilities
@{
    var listUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var detailsUrl = QueryHelpers.AddQueryString(Url.Content("~" + Model.DetailsUrl), "returnUrl", listUrl);
}
<article class="py-3 border-top" data-report-id="@Model.Id" data-report-source="@Model.Source">
    <h2 class="h6 fw-bold text-dark text-break">@Model.Description</h2>
    @if (Model.ClinicalEncounterId.HasValue)
    {
        <p class="small mb-1">Encounter: <a asp-controller="Visits" asp-action="Details" asp-route-id="@Model.ClinicalEncounterId">@Model.EncounterReference</a>
            · <time datetime="@Model.EncounterDate?.ToString("yyyy-MM-dd")">@Model.EncounterDate?.ToString("MMM d, yyyy")</time></p>
    }
    else { <p class="small mb-1">Encounter not assigned</p> }
    <p class="small text-muted mb-1">
        @(Model.Source == "radiology" ? "Study date:" : "Test date:")
        @if (Model.ExamDate.HasValue)
        { <time datetime="@Model.ExamDate.Value.ToString("yyyy-MM-dd")">@Model.ExamDate.Value.ToString("MMM d, yyyy")</time> }
        else { <span>Test date not recorded</span> }
    </p>
    <p class="small mb-2">Status: <strong>@Model.Status</strong></p>
    @if (!string.IsNullOrEmpty(Model.RequestReference)) { <p class="small text-muted text-break mb-2">Request reference: @Model.RequestReference</p> }
    @if (Model.CanOpenPdf)
    {
        <partial name="_PdfReportActions" model='new PdfReportActionsViewModel(Model.ControllerName, Model.Id, Model.Description, Model.Source)' />
    }
    else
    {
        <p class="small text-muted mb-2">@(Model.Status == "Cancelled" ? "This request was cancelled." : Model.HasPdf ? "The PDF is not currently available to view." : "The report PDF is not available yet.")</p>
    }
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Visits" || ViewContext.RouteData.Values["action"]?.ToString() != "Details")
    { <a href="@detailsUrl" class="small fw-semibold">Request details</a> }
</article>
