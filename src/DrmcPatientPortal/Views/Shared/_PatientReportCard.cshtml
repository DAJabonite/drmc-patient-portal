@model PatientReportCard
@using Microsoft.AspNetCore.WebUtilities
@{
    var listUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var detailsUrl = QueryHelpers.AddQueryString(Url.Content("~" + Model.DetailsUrl), "returnUrl", listUrl);
    var availability = Model.Status == "Cancelled" ? "PatientUX_RequestCancelled"
        : Model.CanOpenPdf ? "PatientUX_PdfAvailable"
        : Model.IsReleased || Model.HasPdf || Model.Status is "Available" or "Final" or "Amended"
            ? "PatientUX_PdfUnavailable" : "PatientUX_AwaitingResult";
}
<article class="patient-report-row" data-report-id="@Model.Id" data-report-source="@Model.Source">
    <div class="patient-report-row-content">
        <h3 class="h6 fw-bold text-break mb-2">@Model.Description</h3>
        <p class="patient-report-row-date text-muted mb-2">
            @(Model.Source == "radiology" ? Loc["Report_StudyDate"] : Loc["Report_TestDate"])
            @if (Model.ExamDate.HasValue)
            { <time datetime="@Model.ExamDate.Value.ToString("yyyy-MM-dd")">@Model.ExamDate.Value.ToString("MMM d, yyyy")</time> }
            else { <span>@Loc["PatientUX_DateNotRecorded"]</span> }
        </p>
        <span class="patient-report-availability @(Model.CanOpenPdf ? "is-available" : null)">
            <i class="bi @(Model.CanOpenPdf ? "bi-file-earmark-check" : "bi-info-circle")" aria-hidden="true"></i>
            @Loc[availability]
        </span>
    </div>
    <a href="@detailsUrl" class="patient-report-open">
        @(Model.CanOpenPdf ? Loc["PatientUX_OpenReport"] : Loc["Report_Details"])<span class="visually-hidden"> @Loc["Report_ForDescription", Model.Description]</span>
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </a>
</article>
