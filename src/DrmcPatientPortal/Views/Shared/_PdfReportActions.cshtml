@model PdfReportActionsViewModel
@{
    var actionId = $"pdf-{Model.ControllerName}-{Model.Source}-{Model.ReportId}";
    var reportUrl = Model.Source == "redstar"
        ? Url.Content($"~/Patient/LabResults/RedStar/Report/{Model.ReportId}")
        : Url.Action("Report", Model.ControllerName, new { area = "", id = Model.ReportId });
    var hasErrors = !ViewData.ModelState.IsValid;
    var requestedIntent = hasErrors && Context.Request.HasFormContentType
        ? (await Context.Request.ReadFormAsync())["intent"].ToString() : "";
}
<div class="patient-pdf-actions">
    @foreach (var intent in new[] { "view", "download" })
    {
        var viewing = intent == "view";
        var passwordId = $"{actionId}-{intent}-password";
        var helpId = passwordId + "-help";
        var actionHasErrors = hasErrors && (requestedIntent == intent || requestedIntent == "" && viewing);
        <details class="patient-pdf-action" name="@actionId" open="@actionHasErrors">
            <summary class="btn @(viewing ? "btn-primary-drmc" : "btn-outline-drmc")">
                <i class="bi @(viewing ? "bi-file-earmark-pdf" : "bi-download")" aria-hidden="true"></i>
                @(viewing ? Loc["Report_ViewPdf"] : Loc["Report_DownloadPdf"])
                <span class="visually-hidden">@Loc["Report_ForDescription", Model.Description]</span>
            </summary>
            <form action="@reportUrl" method="post" rel="noopener" class="patient-pdf-confirmation">
                @Html.AntiForgeryToken()
                <p class="fw-semibold text-break mb-2">@Model.Description</p>
                <label for="@passwordId" class="form-label fw-semibold">@Loc["Report_Password"]</label>
                <input id="@passwordId" name="password" type="password" autocomplete="current-password"
                       maxlength="1024" required class="form-control" aria-invalid="@(actionHasErrors ? "true" : null)" aria-describedby="@(actionHasErrors ? helpId + " report-access-error" : helpId)" />
                <p id="@helpId" class="small text-muted mt-2 mb-3">@Loc["Report_PdfPasswordHelp"]</p>
                @if (viewing)
                {
                    <button type="submit" name="intent" value="view" formtarget="_blank" class="btn btn-primary-drmc">
                        @Loc["PatientUX_ConfirmView"]
                        <span class="visually-hidden">@Loc["Report_NewTab", Model.Description]</span>
                    </button>
                    <p class="small text-muted mt-2 mb-0">@Loc["PatientUX_PdfNewTab"]</p>
                }
                else
                {
                    <button type="submit" name="intent" value="download" class="btn btn-primary-drmc">@Loc["PatientUX_ConfirmDownload"]</button>
                }
            </form>
        </details>
    }
</div>
