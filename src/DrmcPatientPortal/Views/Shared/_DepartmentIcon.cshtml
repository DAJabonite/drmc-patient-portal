@model string
@{
    var iconClass = (Model ?? string.Empty).ToLowerInvariant() switch
    {
        "stethoscope" => "bi-clipboard2-pulse",
        "scalpel" => "bi-scissors",
        "baby" => "bi-person-hearts",
        "venus" => "bi-gender-female",
        "house-user" => "bi-house-heart",
        "syringe" => "bi-prescription2",
        "eye" => "bi-eye",
        "scan" => "bi-bounding-box",
        _ => "bi-hospital"
    };
}
<i class="bi @iconClass fs-4" aria-hidden="true"></i>
