@model PatientReportCard
@{
    var availability = Model.Status == "Cancelled" ? "PatientUX_RequestCancelled"
        : Model.CanOpenPdf ? "PatientUX_PdfAvailable"
        : Model.IsReleased || Model.HasPdf || Model.Status is "Available" or "Final" or "Amended"
            ? "PatientUX_PdfUnavailable" : "PatientUX_AwaitingResult";
}
<article class="patient-report-detail" data-report-id="@Model.Id" data-report-source="@Model.Source">
    <h2 class="h5 fw-bold mb-3">@Loc["PatientUX_ReportDetails"]</h2>
    <span class="patient-report-availability @(Model.CanOpenPdf ? "is-available" : null)">
        <i class="bi @(Model.CanOpenPdf ? "bi-file-earmark-check" : "bi-info-circle")" aria-hidden="true"></i>
        @Loc[availability]
    </span>
    <dl class="patient-report-metadata">
        <div>
            <dt>@(Model.Source == "radiology" ? Loc["Report_StudyDate"] : Loc["Report_TestDate"])</dt>
            <dd>
                @if (Model.ExamDate.HasValue)
                { <time datetime="@Model.ExamDate.Value.ToString("yyyy-MM-dd")">@Model.ExamDate.Value.ToString("MMM d, yyyy")</time> }
                else { @Loc["Report_NoTestDate"] }
            </dd>
        </div>
        <div>
            <dt>@Loc["PatientUX_Visit"]</dt>
            <dd>
                @if (Model.ClinicalEncounterId.HasValue)
                {
                    <a asp-controller="Visits" asp-action="Details" asp-route-id="@Model.ClinicalEncounterId">@Model.EncounterReference</a>
                    @if (Model.EncounterDate.HasValue)
                    { <span> &middot; <time datetime="@Model.EncounterDate.Value.ToString("yyyy-MM-dd")">@Model.EncounterDate.Value.ToString("MMM d, yyyy")</time></span> }
                }
                else { @Loc["PatientUX_UnassignedVisit"] }
            </dd>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.RequestReference))
        { <div><dt>@Loc["Report_RequestReference"]</dt><dd>@Model.RequestReference</dd></div> }
        <div><dt>@Loc["Report_Status"]</dt><dd>@Loc["ReportStatus_" + Model.Status.ToLowerInvariant()]</dd></div>
    </dl>
    <section class="patient-official-report" aria-labelledby="officialReportHeading">
        <h2 id="officialReportHeading" class="h5 fw-bold mb-2">@Loc["PatientUX_OfficialReport"]</h2>
        <div id="report-access-error" asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (Model.CanOpenPdf)
        {
            <p class="text-muted">@Loc["PatientUX_OfficialReportHelp"]</p>
            <partial name="_PdfReportActions" model='new PdfReportActionsViewModel(Model.ControllerName, Model.Id, Model.Description, Model.Source)' />
        }
        else
        {
            <p class="text-muted mb-0">@(Model.Status == "Cancelled" ? Loc["Report_Cancelled"] : Model.HasPdf || Model.IsReleased || Model.Status is "Available" or "Final" or "Amended" ? Loc["Report_UnavailablePdf"] : Loc["Report_PendingPdf"])</p>
        }
    </section>
</article>
