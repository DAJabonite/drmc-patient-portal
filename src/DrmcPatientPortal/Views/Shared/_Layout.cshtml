@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? "Davao Regional Medical Center" : $"{title} | Davao Regional Medical Center")</title>
    <link rel="icon" type="image/png" href="~/drmc-favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DrmcPatientPortal.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- Unified Masthead Header with Integrated PST Clock -->
    <header class="masthead">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-3">
            <a class="d-inline-block" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Davao Regional Medical Center home">
                <img class="masthead-lockup" src="~/images/drmc-masthead.png"
                     alt="Davao Regional Medical Center, Republic of the Philippines, Department of Health, Brgy. Apokon, Tagum City, Davao del Norte" />
            </a>
            <div class="pst-clock text-end text-white">
                <div class="pst-label">Philippine Standard Time:</div>
                <div id="govphClock" class="pst-time" aria-live="polite">--</div>
            </div>
        </div>
    </header>

    <!-- Primary nav -->
    <nav class="navbar navbar-expand-lg navbar-drmc">
        <div class="container">
            <a class="navbar-brand d-lg-none fw-bold text-primary-drmc" asp-area="" asp-controller="Home" asp-action="Index">DRMC</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav"
                    aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="primaryNav">
                <ul class="navbar-nav me-auto gap-lg-1">
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">About Us</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">Services</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">Transparency</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">Programs &amp; Projects</a></li>
                    <li class="nav-item"><a class="nav-link px-3" asp-controller="Home" asp-action="Index">Contact Us</a></li>
                </ul>
                <div class="d-none d-lg-block nav-divider"></div>
                <div class="d-flex align-items-center pt-2 pt-lg-0">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <main id="main-content" role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- Modern DRMC Hub Footer -->
    <!-- Footer (GOVPH-standard) -->
    <footer class="footer-drmc">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6 col-md-6">
                    <img class="footer-seal" src="~/images/drmc-seal.png" alt="Davao Regional Medical Center seal" />
                    <h6 class="text-white">Republic of the Philippines</h6>
                    <p class="mb-2">All content is in the public domain unless otherwise stated.</p>
                    <p class="mb-0">Davao Regional Medical Center<br />Brgy. Apokon, Tagum City, Davao del Norte<br />Caring for Life, Changing Lives.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>About GOVPH</h6>
                    <p class="small">Learn more about the Philippine government, its structure, how government works, and the people behind it.</p>
                    <ul class="footer-list">
                        <li><a href="https://www.gov.ph/" target="_blank" rel="noopener">GOV.PH</a></li>
                        <li><a href="https://www.gov.ph/data" target="_blank" rel="noopener">Open Data Portal</a></li>
                        <li><a href="https://www.officialgazette.gov.ph/" target="_blank" rel="noopener">Official Gazette</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>Government Links</h6>
                    <ul class="footer-list">
                        <li><a href="https://op-proper.gov.ph/" target="_blank" rel="noopener">Office of the President</a></li>
                        <li><a href="https://ovp.gov.ph/" target="_blank" rel="noopener">Office of the Vice President</a></li>
                        <li><a href="https://www.senate.gov.ph/" target="_blank" rel="noopener">Senate of the Philippines</a></li>
                        <li><a href="https://www.congress.gov.ph/" target="_blank" rel="noopener">House of Representatives</a></li>
                        <li><a href="https://sc.judiciary.gov.ph/" target="_blank" rel="noopener">Supreme Court</a></li>
                        <li><a href="https://ca.judiciary.gov.ph/" target="_blank" rel="noopener">Court of Appeals</a></li>
                        <li><a href="https://sb.judiciary.gov.ph/" target="_blank" rel="noopener">Sandiganbayan</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom d-flex justify-content-between flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year Davao Regional Medical Center. All rights reserved.</span>
                <span>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Statement</a>
                    &nbsp;·&nbsp; <a asp-controller="Home" asp-action="Privacy">Terms of Use</a>
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
