@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? "Davao Regional Medical Center" : $"{title} | Davao Regional Medical Center")</title>
    <link rel="icon" type="image/png" href="~/drmc-favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DrmcPatientPortal.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <!-- GOVPH utility bar -->
    <div class="govph-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div><a href="https://www.gov.ph/" target="_blank" rel="noopener">GOVPH</a></div>
            <div class="govph-time" aria-live="polite">Philippine Standard Time: <span id="govphClock">--</span></div>
        </div>
    </div>

    <!-- Masthead -->
    <header class="masthead">
        <div class="container d-flex align-items-center gap-4">
            <a class="masthead-brand d-inline-flex align-items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Davao Regional Medical Center home">
                <img class="masthead-seal" src="~/images/drmc-seal.png" alt="Davao Regional Medical Center seal" />
                <span>
                    <span class="masthead-meta d-block">Republic of the Philippines<br />Department of Health</span>
                    <img class="masthead-wordmark" src="~/images/drmc-masthead.png" alt="Davao Regional Medical Center" />
                    <span class="masthead-location d-block">Brgy. Apokon, Tagum City, Davao del Norte</span>
                </span>
            </a>
            <span class="ms-auto d-none d-lg-flex flex-column align-items-end">
                <img class="masthead-seal" src="~/images/doh-seal.png" alt="Department of Health seal" />
            </span>
        </div>
        <div class="container mt-1 d-lg-none">
            <div class="masthead-tagline">Caring for Life, Changing Lives.</div>
        </div>
    </header>

    <!-- Primary nav -->
    <nav class="navbar navbar-expand-lg navbar-drmc">
        <div class="container">
            <a class="navbar-brand d-lg-none" asp-area="" asp-controller="Home" asp-action="Index">DRMC</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNav"
                    aria-controls="primaryNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="primaryNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">About Us</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Services</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Transparency</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Programs &amp; Projects</a></li>
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Contact Us</a></li>
                    <li class="nav-item">
                        <div class="px-2 py-1">
                            <form class="d-flex" role="search" asp-controller="Home" asp-action="Index" method="get">
                                <input class="form-control form-control-sm me-2" type="search" placeholder="Search" aria-label="Search" />
                                <button class="btn btn-sm btn-outline-drmc" type="submit" aria-label="Search">Search</button>
                            </form>
                        </div>
                    </li>
                    <li class="nav-item d-flex align-items-center px-2">
                        <span class="text-muted" title="Accessibility statement">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" role="img" aria-label="Accessibility">
                                <path d="M8 1.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11.5 5a.5.5 0 0 0-.5-.5H5.5a.5.5 0 0 0 0 1H7v1.3c-.9.2-1.7.6-2.3 1.2l-.5.7a.5.5 0 1 0 .8.6l.4-.5c.5-.5 1.3-.8 2.1-.8 1.7 0 2.7.9 3 .9a.5.5 0 1 0 .2-1c-.4-.1-.7-.3-1.2-.5V5.5h1.5a.5.5 0 0 0 .5-.5z"/>
                                <path d="M4 3a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM3 5a1 1 0 0 0-1 1v2H1a.5.5 0 0 0 0 1h1v5a.5.5 0 0 0 1 0v-3h.5v3a.5.5 0 0 0 1 0v-5H4v-2a1 1 0 0 0-1-1z"/>
                            </svg>
                        </span>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </div>
    </nav>

    <!-- Secondary nav (portal) -->
    <div class="secondary-nav">
        <div class="container">
            <ul class="nav flex-nowrap overflow-auto py-1">
                <li class="nav-item"><a class="nav-link active" href="#main-content">Citizen's Charter</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">Opportunities</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">Training &amp; Research</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">Doctor's Directory</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">Rates &amp; Fees</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">Press Release</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">Related Links</a></li>
                <li class="nav-item"><a class="nav-link" href="#main-content">FAQs</a></li>
            </ul>
        </div>
    </div>

    <main id="main-content" role="main" class="pb-3">
        @RenderBody()
    </main>

    <!-- Footer (GOVPH-standard) -->
    <footer class="footer-drmc">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6 col-md-6">
                    <img class="footer-seal" src="~/images/drmc-seal.png" alt="Davao Regional Medical Center seal" />
                    <h6 class="text-white">Republic of the Philippines</h6>
                    <p class="mb-2">All content is in the public domain unless otherwise stated.</p>
                    <p class="mb-0">Davao Regional Medical Center<br />Brgy. Apokon, Tagum City, Davao del Norte<br />Caring for Life, Changing Lives.</p>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>About GOVPH</h6>
                    <p class="small">Learn more about the Philippine government, its structure, how government works, and the people behind it.</p>
                    <ul class="footer-list">
                        <li><a href="https://www.gov.ph/" target="_blank" rel="noopener">GOV.PH</a></li>
                        <li><a href="https://www.gov.ph/data" target="_blank" rel="noopener">Open Data Portal</a></li>
                        <li><a href="https://www.officialgazette.gov.ph/" target="_blank" rel="noopener">Official Gazette</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6>Government Links</h6>
                    <ul class="footer-list">
                        <li><a href="https://op-proper.gov.ph/" target="_blank" rel="noopener">Office of the President</a></li>
                        <li><a href="https://ovp.gov.ph/" target="_blank" rel="noopener">Office of the Vice President</a></li>
                        <li><a href="https://www.senate.gov.ph/" target="_blank" rel="noopener">Senate of the Philippines</a></li>
                        <li><a href="https://www.congress.gov.ph/" target="_blank" rel="noopener">House of Representatives</a></li>
                        <li><a href="https://sc.judiciary.gov.ph/" target="_blank" rel="noopener">Supreme Court</a></li>
                        <li><a href="https://ca.judiciary.gov.ph/" target="_blank" rel="noopener">Court of Appeals</a></li>
                        <li><a href="https://sb.judiciary.gov.ph/" target="_blank" rel="noopener">Sandiganbayan</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom d-flex justify-content-between flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year Davao Regional Medical Center. All rights reserved.</span>
                <span>
                    <a asp-controller="Home" asp-action="Privacy">Privacy Statement</a>
                    &nbsp;·&nbsp; <a asp-controller="Home" asp-action="Privacy">Terms of Use</a>
                </span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
