@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject IStringLocalizer<SharedResource> Loc
@{
    var title = ViewData["Title"]?.ToString();
    var currentCulture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var signedIn = SignInManager.IsSignedIn(User);
    var isHome = currentController == "Home" && currentAction == "Index";
    var isDashboard = currentController == "Patient" && currentAction == "Home";
    var isMalasakit = currentController == "Malasakit";
    var isResults = currentController == "LabResults";
    var isMedications = currentController == "Medications";
    var isEncounters = currentController == "Encounters";
    var homeActive = signedIn ? isDashboard : isHome;
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(string.IsNullOrEmpty(title) ? "Davao Regional Medical Center" : $"{title} | Davao Regional Medical Center")</title>
    <link rel="icon" type="image/png" href="~/drmc-favicon.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DrmcPatientPortal.styles.css" asp-append-version="true" />
</head>
<body class="has-mobile-navigation">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="masthead d-none d-lg-block" role="banner">
        <div class="container d-flex justify-content-between align-items-center gap-4">
            <a class="d-inline-block" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Davao Regional Medical Center home">
                <img class="masthead-lockup" src="~/images/drmc-masthead.png"
                     alt="Davao Regional Medical Center, Republic of the Philippines, Department of Health, Brgy. Apokon, Tagum City, Davao del Norte" />
            </a>

            <div class="masthead-tools d-flex align-items-center gap-3">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle header-control d-flex align-items-center gap-2"
                            type="button" id="langDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Select language">
                        <i class="bi bi-translate" aria-hidden="true"></i>
                        <span>@(currentCulture.StartsWith("fil") ? "Filipino" : currentCulture.StartsWith("ceb") ? "Cebuano" : "English")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="langDropdown">
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="en" />
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="dropdown-item @(currentCulture.StartsWith("en") ? "active" : null)">English</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="fil" />
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="dropdown-item @(currentCulture.StartsWith("fil") ? "active" : null)">Filipino</button>
                            </form>
                        </li>
                        <li>
                            <form asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="culture" value="ceb" />
                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                <button type="submit" class="dropdown-item @(currentCulture.StartsWith("ceb") ? "active" : null)">Cebuano / Bisaya</button>
                            </form>
                        </li>
                    </ul>
                </div>
                <div class="pst-clock text-end text-white">
                    <div class="pst-label">Philippine Standard Time</div>
                    <div id="govphClock" class="pst-time" aria-live="off">--</div>
                </div>
            </div>
        </div>
    </header>

    <header class="mobile-header d-lg-none" role="banner">
        <div class="container-fluid justify-content-between gap-2">
            <a class="mobile-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Davao Regional Medical Center home">
                <img src="~/images/drmc-masthead.png"
                     alt="Davao Regional Medical Center, Department of Health" />
            </a>
            <button class="mobile-menu-trigger" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileUtilityMenu"
                    aria-controls="mobileUtilityMenu" aria-label="@Loc["Mobile_Menu"]">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    <nav class="navbar navbar-drmc d-none d-lg-block" aria-label="Main navigation">
        <div class="container d-flex align-items-center">
            <ul class="navbar-nav flex-row align-items-center gap-1 me-auto">
                @if (signedIn)
                {
                    <li class="nav-item"><a class="nav-link @(homeActive ? "active" : null)" aria-current="@(homeActive ? "page" : null)" asp-controller="Patient" asp-action="Home">@Loc["Nav_Home"]</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link @(homeActive ? "active" : null)" aria-current="@(homeActive ? "page" : null)" asp-controller="Home" asp-action="Index">@Loc["Nav_Home"]</a></li>
                }
                <li class="nav-item"><a class="nav-link @(isEncounters ? "active" : null)" aria-current="@(isEncounters ? "page" : null)" asp-controller="Encounters" asp-action="Index">@Loc["Nav_Encounters"]</a></li>
                <li class="nav-item"><a class="nav-link @(isResults ? "active" : null)" aria-current="@(isResults ? "page" : null)" asp-controller="LabResults" asp-action="Index">@Loc["Nav_Results"]</a></li>
                <li class="nav-item"><a class="nav-link @(isMedications ? "active" : null)" aria-current="@(isMedications ? "page" : null)" asp-controller="Medications" asp-action="Index">@Loc["Nav_Medication"]</a></li>
                <li class="nav-item"><a class="nav-link @(isMalasakit ? "active" : null)" aria-current="@(isMalasakit ? "page" : null)" asp-controller="Malasakit" asp-action="Index">@Loc["Nav_FinancialAssistance"]</a></li>
            </ul>
            <div class="nav-account"><partial name="_LoginPartial" /></div>
        </div>
    </nav>

    <main id="main-content" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="footer-drmc" role="contentinfo">
        <div class="container">
            <div class="footer-primary">
                <img class="footer-seal" src="~/images/drmc-seal.png" alt="Davao Regional Medical Center seal" />
                <div>
                    <h2 class="h6 text-white mb-1">Davao Regional Medical Center</h2>
                    <p class="mb-0">Brgy. Apokon, Tagum City, Davao del Norte<br />@Loc["Header_Tagline"]</p>
                </div>
            </div>

            <div class="row g-4 mt-1 d-none d-md-flex">
                <div class="col-md-6">
                    <h2 class="h6">About GOVPH</h2>
                    <p class="small">Learn more about the Philippine government, its structure, how government works, and the people behind it.</p>
                    <ul class="footer-list footer-list-inline">
                        <li><a href="https://www.gov.ph/" target="_blank" rel="noopener">GOV.PH</a></li>
                        <li><a href="https://www.gov.ph/data" target="_blank" rel="noopener">Open Data Portal</a></li>
                        <li><a href="https://www.officialgazette.gov.ph/" target="_blank" rel="noopener">Official Gazette</a></li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h2 class="h6">Government Links</h2>
                    <ul class="footer-list footer-list-columns">
                        <li><a href="https://op-proper.gov.ph/" target="_blank" rel="noopener">Office of the President</a></li>
                        <li><a href="https://ovp.gov.ph/" target="_blank" rel="noopener">Office of the Vice President</a></li>
                        <li><a href="https://www.senate.gov.ph/" target="_blank" rel="noopener">Senate of the Philippines</a></li>
                        <li><a href="https://www.congress.gov.ph/" target="_blank" rel="noopener">House of Representatives</a></li>
                        <li><a href="https://sc.judiciary.gov.ph/" target="_blank" rel="noopener">Supreme Court</a></li>
                        <li><a href="https://ca.judiciary.gov.ph/" target="_blank" rel="noopener">Court of Appeals</a></li>
                        <li><a href="https://sb.judiciary.gov.ph/" target="_blank" rel="noopener">Sandiganbayan</a></li>
                    </ul>
                </div>
            </div>

            <div class="mobile-footer-links d-md-none">
                <details>
                    <summary>Government information</summary>
                    <ul class="footer-list mt-2">
                        <li><a href="https://www.gov.ph/" target="_blank" rel="noopener">GOV.PH</a></li>
                        <li><a href="https://www.gov.ph/data" target="_blank" rel="noopener">Open Data Portal</a></li>
                        <li><a href="https://www.officialgazette.gov.ph/" target="_blank" rel="noopener">Official Gazette</a></li>
                        <li><a href="https://op-proper.gov.ph/" target="_blank" rel="noopener">Office of the President</a></li>
                        <li><a href="https://ovp.gov.ph/" target="_blank" rel="noopener">Office of the Vice President</a></li>
                        <li><a href="https://www.senate.gov.ph/" target="_blank" rel="noopener">Senate of the Philippines</a></li>
                        <li><a href="https://www.congress.gov.ph/" target="_blank" rel="noopener">House of Representatives</a></li>
                        <li><a href="https://sc.judiciary.gov.ph/" target="_blank" rel="noopener">Supreme Court</a></li>
                        <li><a href="https://ca.judiciary.gov.ph/" target="_blank" rel="noopener">Court of Appeals</a></li>
                        <li><a href="https://sb.judiciary.gov.ph/" target="_blank" rel="noopener">Sandiganbayan</a></li>
                    </ul>
                </details>
            </div>

            <div class="footer-bottom d-flex justify-content-between flex-wrap gap-2">
                <span>&copy; @DateTime.Now.Year DRMC. All content is in the public domain unless otherwise stated.</span>
                <span><a asp-controller="Home" asp-action="Privacy">Privacy Statement</a> · <a asp-controller="Home" asp-action="Privacy">Terms of Use</a></span>
            </div>
        </div>
    </footer>

    <partial name="_MobileNavigation" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
