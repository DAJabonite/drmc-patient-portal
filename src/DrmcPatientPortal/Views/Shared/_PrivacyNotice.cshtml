<div class="privacy-content">
    <p class="lead text-secondary mb-4">@Loc["Privacy_Introduction"]</p>

    <h2 class="h5 fw-bold text-primary-drmc mt-4 mb-3">1. @Loc["Privacy_InformationHeading"]</h2>
    <ul class="mb-4">
        <li><strong>@Loc["Privacy_IdentityHeading"]</strong> @Loc["Privacy_Identity"]</li>
        <li><strong>@Loc["Privacy_ClinicalHeading"]</strong> @Loc["Privacy_Clinical"]</li>
        <li><strong>@Loc["Privacy_ActivityHeading"]</strong> @Loc["Privacy_Activity"]</li>
    </ul>

    <h2 class="h5 fw-bold text-primary-drmc mt-4 mb-3">2. @Loc["Privacy_PurposeHeading"]</h2>
    <p>@Loc["Privacy_Purpose"]</p>
    <p>@Loc["Privacy_Notifications"]</p>
    <h3 class="h6 fw-bold mt-3">@Loc["Privacy_UsageHeading"]</h3>
    <p>@Loc["Privacy_UsageCollection"]</p>
    <p>@Loc["Privacy_UsageRetention"]</p>

    <h2 class="h5 fw-bold text-primary-drmc mt-4 mb-3">3. @Loc["Privacy_SecurityHeading"]</h2>
    <p>@Loc["Privacy_PdfAccess"]</p>
    <p>@Loc["Privacy_StorageAndAudit"]</p>
    <p>@Loc["Privacy_HivConfidentiality"]</p>

    <h2 class="h5 fw-bold text-primary-drmc mt-4 mb-3">4. @Loc["Privacy_RightsHeading"]</h2>
    <p>@Loc["Privacy_Rights"]</p>

    <div class="bg-light p-4 rounded-3 mt-4 border">
        <h3 class="h6 fw-bold text-primary-drmc mb-2">@Loc["Privacy_ContactHeading"]</h3>
        <address class="small text-muted mb-2">
            <strong>Davao Regional Medical Center</strong><br />
            Brgy. Apokon, Tagum City, Davao del Norte, 8100 Philippines<br />
            @Loc["Privacy_DpoContact"] <a href="mailto:dpo@drmc.doh.gov.ph" class="text-primary-drmc fw-semibold">dpo@drmc.doh.gov.ph</a><br />
            @Loc["Privacy_ClinicContact"] <a href="mailto:redstarclinic@drmc.doh.gov.ph" class="text-primary-drmc fw-semibold">redstarclinic@drmc.doh.gov.ph</a>
        </address>
        <p class="small text-muted mb-0">@Loc["Privacy_EmailSafety"]</p>
    </div>
</div>
