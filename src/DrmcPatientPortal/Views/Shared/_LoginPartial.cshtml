@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Loc

<ul class="navbar-nav align-items-lg-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = user?.FullName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = User.Identity?.Name;
        }

        <li class="nav-item dropdown">
            <a class="btn btn-sm btn-outline-primary dropdown-toggle d-inline-flex align-items-center gap-2 px-3 py-1 text-primary-drmc fw-semibold bg-white border-primary-subtle"
               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User Account Menu">
                <i class="bi bi-person-circle fs-6"></i>
                <span class="d-inline-block text-truncate" style="max-width: 180px;">@displayName</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3 border-0 small mt-2">
                <li>
                    <a class="dropdown-item fw-semibold text-primary-drmc py-2" asp-controller="Patient" asp-action="Home">
                        <i class="bi bi-speedometer2 me-2"></i> @Loc["Nav_Dashboard"]
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item py-1" asp-controller="LabResults" asp-action="Index">
                        <i class="bi bi-file-earmark-medical me-2 text-info-emphasis"></i> @Loc["Nav_LabResults"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-1" asp-controller="Medications" asp-action="Index">
                        <i class="bi bi-capsule me-2 text-success"></i> @Loc["Nav_Medications"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-1" asp-controller="Encounters" asp-action="Index">
                        <i class="bi bi-journal-medical me-2 text-primary"></i> @Loc["Nav_Encounters"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-1" asp-controller="Messages" asp-action="Index">
                        <i class="bi bi-chat-dots me-2 text-warning-emphasis"></i> @Loc["Nav_Messages"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-1" asp-controller="Proxy" asp-action="Index">
                        <i class="bi bi-people me-2 text-secondary"></i> @Loc["Nav_Proxy"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-1" asp-controller="Patient" asp-action="Audit">
                        <i class="bi bi-shield-check me-2 text-success"></i> @Loc["Nav_Audit"]
                    </a>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                    <a class="dropdown-item py-1" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">
                        <i class="bi bi-shield-lock me-2 text-primary-drmc"></i> Two-Factor Auth (2FA)
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-1" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-gear me-2 text-muted"></i> @Loc["Nav_Settings"]
                    </a>
                </li>
                <li>
                    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item text-danger py-1">
                            <i class="bi bi-box-arrow-right me-2"></i> @Loc["Nav_SignOut"]
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-outline-drmc px-3" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i>@Loc["Nav_Register"]
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-drmc px-3 text-white" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>@Loc["Nav_LogIn"]
            </a>
        </li>
    }
</ul>
