@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IStringLocalizer<SharedResource> Loc

<ul class="navbar-nav align-items-lg-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = user?.FullName;
        if (string.IsNullOrWhiteSpace(displayName))
        {
            displayName = User.Identity?.Name;
        }

        <li class="nav-item">
            <button class="nav-menu-trigger btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-2 px-3 py-1 text-primary-drmc fw-semibold bg-white border-primary-subtle"
                    type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileUtilityMenu"
                    aria-controls="mobileUtilityMenu" aria-label="User Account Menu">
                <i class="bi bi-person-circle fs-6" aria-hidden="true"></i>
                <span class="d-inline-block text-truncate" style="max-width: 180px;">@displayName</span>
            </button>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-outline-drmc px-3" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i>@Loc["Nav_Register"]
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-drmc px-3 text-white" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right me-1"></i>@Loc["Nav_LogIn"]
            </a>
        </li>
    }
</ul>
