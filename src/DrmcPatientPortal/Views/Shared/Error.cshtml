@model ErrorViewModel
@{
    ViewData["Title"] = Loc["Status_GenericTitle"];
}

<section class="section py-5 bg-light">
    <div class="container">
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4 mx-auto" style="max-width: 36rem;">
            <i class="bi bi-exclamation-triangle fs-1 text-muted mb-2" aria-hidden="true"></i>
            <h1 class="h4 fw-bold text-dark">@ViewData["Title"]</h1>
            <p class="text-muted mb-3">@Loc["Status_GenericBody"]</p>
            @if (Model.ShowRequestId)
            {
                <p class="text-muted small mb-4">Reference: <code>@Model.RequestId</code></p>
            }
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="/" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold">@Loc["Status_Home"]</a>
            </div>
        </div>
    </div>
</section>
