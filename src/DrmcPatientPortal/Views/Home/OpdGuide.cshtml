@model OpdGuideViewModel
@{
    ViewData["Title"] = "Outpatient Department (OPD) Guide";
}

<!-- Hero / Header Banner -->
<section class="py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-white text-primary-drmc fw-bold px-3 py-1 rounded-pill small">
                        <i class="bi bi-compass me-1"></i> Patient Orientation
                    </span>
                    <span class="small text-white text-opacity-75">Outpatient Visit Sequence</span>
                </div>
                <h1 class="display-6 fw-bold mb-0">Outpatient Department (OPD) Guide</h1>
            </div>
            <div>
                <a asp-controller="Appointments" asp-action="Book" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm">
                    <i class="bi bi-calendar-check-fill me-1"></i> Book an Appointment
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Main Guide Content -->
<section class="section py-5 bg-light">
    <div class="container" style="max-width: 1140px;">
        
        <!-- Plain Language Intro Line -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white border-start border-4 border-primary">
            <div class="d-flex align-items-start gap-3">
                <div class="p-2 rounded-circle bg-primary-subtle text-primary-drmc d-inline-flex" style="flex-shrink:0;">
                    <i class="bi bi-info-circle-fill fs-4"></i>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Patient Consultation Sequence</h2>
                    <p class="text-muted mb-0 leading-relaxed">
                        @Model.IntroLine
                    </p>
                </div>
            </div>
        </div>

        <!-- Linear Visual Stepper Container -->
        <div class="opd-stepper-container mb-4">
            <h3 class="h6 text-uppercase fw-bold text-muted mb-0" style="font-size: 0.78rem; letter-spacing: 0.5px;">
                Outpatient Visit Sequence (Steps 1 to 6)
            </h3>

            <ol class="opd-stepper">
                @foreach (var step in Model.Steps)
                {
                    <li class="opd-step-item">
                        <div class="opd-step-node" aria-hidden="true">
                            @step.StepNumber
                        </div>
                        <div class="opd-step-content">
                            <h4 class="opd-step-title">@step.Title</h4>
                            <div class="opd-step-location">
                                <i class="bi bi-geo-alt me-1 text-muted"></i>@step.Location
                            </div>
                            @if (!string.IsNullOrEmpty(step.RequirementNote))
                            {
                                <div class="opd-step-requirement">
                                    <i class="bi bi-card-checklist me-1"></i>@step.RequirementNote
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>

        <!-- Plain Language Outro Line (Wayfinder Kiosk Referral) -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 rounded-circle bg-light text-primary-drmc border d-inline-flex" style="flex-shrink:0;">
                    <i class="bi bi-signpost-2-fill fs-3"></i>
                </div>
                <div>
                    <h2 class="h6 fw-bold text-dark mb-1">Need Turn-by-Turn Indoor Directions?</h2>
                    <p class="text-muted small mb-0">
                        @Model.KioskReferralLine
                    </p>
                </div>
            </div>
        </div>

        <!-- Clinic Hours & Operational Notes -->
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card border-0 rounded-4 p-3 bg-white shadow-xs h-100">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-clock-fill text-primary-drmc"></i>
                        <h3 class="h6 fw-bold text-dark mb-0">OPD Consultation Schedule</h3>
                    </div>
                    <p class="small text-muted mb-0">
                        Monday to Friday: 8:00 AM – 5:00 PM (Excluding Official National Holidays).
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 rounded-4 p-3 bg-white shadow-xs h-100">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="bi bi-telephone-fill text-primary-drmc"></i>
                        <h3 class="h6 fw-bold text-dark mb-0">Hospital Information Assistance</h3>
                    </div>
                    <p class="small text-muted mb-0">
                        For inquiries, visit the Public Assistance and Complaints Desk (PACD) at the main entrance or call (084) 216-9120.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>
