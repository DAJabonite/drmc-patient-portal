@{
    ViewData["Title"] = Loc["Error_ServiceUnavailableTitle"];
}
<section class="section py-5 bg-light">
    <div class="container" style="max-width: 720px;">
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-shield-exclamation display-4 text-warning mb-3"></i>
            <h1 class="h3 fw-bold text-primary-drmc">@Loc["Error_ServiceUnavailableTitle"]</h1>
            <p class="text-muted">@Loc["Error_ServiceUnavailableBody"]</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary-drmc rounded-pill px-4">@Loc["Nav_Home"]</a>
        </div>
    </div>
</section>
