@model LandingViewModel
@{
    ViewData["Title"] = "Davao Regional Medical Center";
    var signedIn = User.Identity?.IsAuthenticated ?? false;
}

<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <p class="eyebrow text-warning mb-2">Official DRMC Patient Portal</p>
            <h1 class="hero-title fw-bold text-white mb-3">Your care, in one clear place.</h1>
            <p class="hero-lead mb-4">
                Book a consultation, check the live OPD queue, and securely review your health records from your phone.
            </p>
            <div class="hero-actions">
                <a class="btn btn-warning btn-lg text-dark" asp-controller="Appointments" asp-action="Book">
                    <i class="bi bi-calendar-plus" aria-hidden="true"></i> Book appointment
                </a>
                <a class="btn btn-outline-light btn-lg" asp-controller="Queue" asp-action="Index">
                    <i class="bi bi-people" aria-hidden="true"></i> Track queue
                </a>
                @if (signedIn)
                {
                    <a class="btn btn-outline-light btn-lg" asp-controller="Patient" asp-action="Home">
                        <i class="bi bi-house-heart" aria-hidden="true"></i> My dashboard
                    </a>
                }
                else
                {
                    <a class="btn btn-outline-light btn-lg" asp-area="Identity" asp-page="/Account/Login">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Sign in
                    </a>
                }
            </div>
            <div class="hero-meta">
                <span><i class="bi bi-geo-alt" aria-hidden="true"></i> Brgy. Apokon, Tagum City</span>
                <a class="text-white text-decoration-none" href="tel:1555"><i class="bi bi-telephone" aria-hidden="true"></i> Emergency hotline 1555</a>
            </div>
        </div>
    </div>
</section>

<section class="task-strip" aria-labelledby="public-services-title">
    <div class="container">
        <h2 id="public-services-title" class="visually-hidden">Patient services</h2>
        <div class="task-strip-inner">
            <a class="task-link" asp-controller="Malasakit" asp-action="Index">
                <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                <span><strong>Malasakit assistance</strong><small>Check support and document requirements</small></span>
            </a>
            <a class="task-link" asp-controller="Directory" asp-action="Index">
                <i class="bi bi-person-badge" aria-hidden="true"></i>
                <span><strong>Find a doctor</strong><small>Browse clinics and specialists</small></span>
            </a>
            <a class="task-link" asp-controller="Advisories" asp-action="Index">
                <i class="bi bi-megaphone" aria-hidden="true"></i>
                <span><strong>Health advisories</strong><small>Read current hospital notices</small></span>
            </a>
        </div>
    </div>
</section>

<section class="section py-5" id="departments" aria-labelledby="departments-title">
    <div class="container">
        <div class="d-flex align-items-end justify-content-between gap-3 mb-4">
            <div>
                <p class="eyebrow mb-1">Tertiary medical services</p>
                <h2 id="departments-title" class="h2 fw-bold text-primary-drmc mb-1">@Model.DepartmentHeading</h2>
                <p class="text-muted mb-0">Choose a common clinic or browse the complete directory.</p>
            </div>
            <a class="btn btn-outline-drmc d-none d-sm-inline-flex" asp-controller="Directory" asp-action="Index">
                View all clinics <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        <div class="row g-3">
            @foreach (var dept in Model.Departments.Take(4))
            {
                <div class="col-sm-6 col-lg-3">
                    <a asp-controller="Directory" asp-action="Department" asp-route-name="@dept.Name" class="card department-card h-100 p-3 text-decoration-none text-dark d-block">
                        <div class="card-body d-flex flex-column h-100 p-0">
                            <div class="card-icon-wrapper mb-3"><partial name="_DepartmentIcon" model="dept.Icon" /></div>
                            <h3 class="h6 fw-bold text-primary-drmc mb-2">@dept.Name</h3>
                            <p class="small text-muted mb-3 flex-grow-1">@dept.Description</p>
                            <span class="small text-primary-drmc fw-bold">Doctors and schedules <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                        </div>
                    </a>
                </div>
            }
        </div>

        <a class="btn btn-outline-drmc w-100 mt-3 d-sm-none" asp-controller="Directory" asp-action="Index">
            View all clinics <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>
</section>

<section class="pb-5" aria-label="Hospital information">
    <div class="container">
        <div class="service-link-grid">
            <a class="service-link" asp-controller="Home" asp-action="OpdGuide">
                <i class="bi bi-signpost-split" aria-hidden="true"></i>
                <strong>First OPD visit?</strong>
                <span>Follow the step-by-step guide.</span>
            </a>
            <a class="service-link" asp-controller="Queue" asp-action="Index">
                <i class="bi bi-broadcast" aria-hidden="true"></i>
                <strong>Live clinic status</strong>
                <span>See numbers currently being called.</span>
            </a>
            <a class="service-link" asp-controller="Malasakit" asp-action="Navigator">
                <i class="bi bi-clipboard2-check" aria-hidden="true"></i>
                <strong>Document checklist</strong>
                <span>Prepare before visiting Malasakit.</span>
            </a>
            <a class="service-link" asp-controller="Home" asp-action="Privacy">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <strong>Privacy and security</strong>
                <span>Learn how patient information is handled.</span>
            </a>
        </div>
    </div>
</section>
