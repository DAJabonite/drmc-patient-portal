@model AddDependentViewModel
@{
    ViewData["Title"] = "Add Dependent / Family Member";
}

<section class="py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Family Profiles
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">New Registration</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">Register Family Member / Dependent</h1>
        <p class="text-white text-opacity-90 mb-0">Link a minor child, elderly parent, or legal dependent to manage their care in the DRMC Portal.</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 760px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            <form asp-action="Add" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold small text-dark">Full Legal Name (as shown on Birth Certificate / ID):</label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Joshua Delos Santos" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Relationship" class="form-label fw-semibold small text-dark">Relationship to You:</label>
                        <select asp-for="Relationship" class="form-select form-select-sm">
                            <option value="@RelationshipType.Child">Child (Minor Dependent)</option>
                            <option value="@RelationshipType.Parent">Parent (Senior Citizen)</option>
                            <option value="@RelationshipType.Spouse">Spouse</option>
                            <option value="@RelationshipType.Sibling">Sibling</option>
                            <option value="@RelationshipType.LegalWard">Legal Ward / Court-Appointed</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label fw-semibold small text-dark">Gender:</label>
                        <select asp-for="Gender" class="form-select form-select-sm">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold small text-dark">Date of Birth:</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control form-control-sm" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhilHealthNumber" class="form-label fw-semibold small text-dark">PhilHealth Number (Optional):</label>
                        <input asp-for="PhilHealthNumber" class="form-control form-control-sm" placeholder="e.g. 19-203948571-3" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="IdType" class="form-label fw-semibold small text-dark">Verification Document Type:</label>
                        <select asp-for="IdType" class="form-select form-select-sm">
                            <option value="PSA Birth Certificate">PSA Birth Certificate</option>
                            <option value="OSCA Senior Citizen ID">OSCA Senior Citizen ID</option>
                            <option value="PWD ID">PWD ID</option>
                            <option value="Barangay Certificate of Guardianship">Barangay Certificate of Guardianship</option>
                            <option value="Court Guardianship Order">Court Guardianship Order</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdNumber" class="form-label fw-semibold small text-dark">Document / ID Reference No.:</label>
                        <input asp-for="IdNumber" class="form-control form-control-sm" placeholder="e.g. PSA-2018-091823" />
                    </div>
                </div>

                <!-- Statutory Consent Agreement -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="StatutoryConsentAgreed" id="consentCheck" required />
                        <label class="form-check-label small text-dark" for="consentCheck">
                            <strong>Caregiver Statutory Declaration:</strong> I hereby declare under penalty of law that I am the legal parent, statutory guardian, or authorized family representative for this dependent. I consent to access and manage their healthcare information in compliance with the Data Privacy Act of 2012 (RA 10173).
                        </label>
                    </div>
                    <span asp-validation-for="StatutoryConsentAgreed" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-primary-drmc rounded-pill px-5 fw-bold shadow-xs">
                        <i class="bi bi-person-check-fill me-1"></i> Register Dependent Profile
                    </button>
                </div>

            </form>

        </div>
    </div>
</section>
