@model LabTrendsViewModel
@{
    ViewData["Title"] = "Biomarker Historical Trends";
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All Lab Results
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">Biomarker Analytics</span>
        </div>
        <h1 class="display-6 fw-bold mb-0">Laboratory Biomarker Trends</h1>
    </div>
</section>

<!-- Parameter Tabs -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <div class="d-flex align-items-center gap-1 overflow-x-auto pb-1" style="max-width: 100%;">
            @foreach (var p in Model.AvailableParameters)
            {
                <a asp-action="Trends" asp-route-parameter="@p"
                   class="btn btn-sm @(string.Equals(Model.SelectedParameter, p, StringComparison.OrdinalIgnoreCase) ? "btn-primary-drmc text-white" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                    @p
                </a>
            }
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 880px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
            
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary-drmc rounded-pill small fw-semibold">Biomarker Metric</span>
                    <h2 class="h4 fw-bold text-dark mb-0 mt-1">@Model.SelectedParameter</h2>
                </div>
                <div class="text-muted small">
                    Tracking <strong>@Model.TrendItems.Count</strong> historical test readings
                </div>
            </div>

            <!-- Visual Bar/Trend Chart -->
            <div class="p-4 bg-light rounded-4 border mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-3">
                    <i class="bi bi-graph-up me-1"></i> Chronological Readings
                </h3>

                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.TrendItems)
                    {
                        var isHigh = item.Flag == LabFlag.High;
                        var isLow = item.Flag == LabFlag.Low;
                        
                        <div class="p-3 bg-white rounded-3 border shadow-xs">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <strong class="text-dark">@item.LabResult.CollectedAt.ToString("MMMM d, yyyy")</strong>
                                    <span class="small text-muted ms-2">(@item.LabResult.TestName)</span>
                                </div>
                                <div class="text-end">
                                    <span class="h5 fw-bold @(isHigh ? "text-danger" : isLow ? "text-primary" : "text-success") mb-0">
                                        @item.Value <span class="small text-muted fs-6 fw-normal">@item.Unit</span>
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between text-muted small">
                                <span>Reference: @item.ReferenceRange @item.Unit</span>
                                <span>
                                    @if (item.Flag == LabFlag.Normal)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill">Within Normal Range</span>
                                    }
                                    else if (item.Flag == LabFlag.High)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill">Above Reference Limit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">Below Reference Limit</span>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex justify-content-start align-items-center pt-3 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Back to Lab Results
                </a>
            </div>

        </div>
    </div>
</section>
