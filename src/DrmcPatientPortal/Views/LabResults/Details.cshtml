@model PatientReportCard
@{
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var hasReturnUrl = Url.IsLocalUrl(returnUrl);
    var backUrl = hasReturnUrl ? Url.Content(returnUrl) : Url.Action("Index");
}
@{ ViewData["Title"] = "Laboratory request"; }
<section class="page-header"><div class="container">
    <a href="@backUrl" class="text-white text-opacity-75 small">@(hasReturnUrl ? "Back to previous page" : "Back to laboratory requests")</a>
    <h1 class="display-6 fw-bold mt-2">Laboratory request</h1>
</div></section>
<section class="section py-5 bg-light"><div class="container" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <partial name="_PatientReportCard" model="Model" />
        <nav class="pt-3 mt-3 border-top" aria-label="Request actions">
            @if (Model.ClinicalEncounterId.HasValue)
            { <a asp-controller="Visits" asp-action="Details" asp-route-id="@Model.ClinicalEncounterId" class="btn btn-outline-secondary">Back to encounter</a> }
            <a href="@backUrl" class="btn btn-outline-secondary">@(hasReturnUrl ? "Back to previous page" : "Back to laboratory requests")</a>
        </nav>
    </div>
</div></section>
