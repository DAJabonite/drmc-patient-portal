@model LabResult
@{
    ViewData["Title"] = $"{Model.TestName} — Diagnostic Report";
}

<section class="py-4 bg-primary-drmc text-white shadow-sm d-print-none">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All Lab Results
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@Model.Category</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">Diagnostic Laboratory Report</h1>
        <p class="text-white text-opacity-90 mb-0">Accession Number: <strong>@Model.AccessionNumber</strong> &middot; Davao Regional Medical Center</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 920px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            <!-- Report Meta Header -->
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 pb-4 mb-4 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill small fw-semibold mb-2">
                        @Model.Category Panel
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">@Model.TestName</h2>
                    <p class="text-muted small mb-0">Performing Unit: <strong>@Model.PerformingUnit</strong></p>
                </div>

                <div class="text-md-end">
                    <span class="badge bg-success px-3 py-1 rounded-pill mb-1">
                        @Model.Status
                    </span>
                    <div class="small text-muted" style="font-size: 0.8rem;">
                        Collected: @Model.CollectedAt.ToString("MMM d, yyyy h:mm tt")
                    </div>
                    @if (Model.ReleasedAt.HasValue)
                    {
                        <div class="small text-muted" style="font-size: 0.8rem;">
                            Released: @Model.ReleasedAt.Value.ToString("MMM d, yyyy h:mm tt")
                        </div>
                    }
                </div>
            </div>

            <!-- Clinical Physicians Attribution -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Requesting / Ordering Physician</span>
                        <strong class="small text-dark">@Model.OrderingPhysician</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Attending Clinical Pathologist</span>
                        <strong class="small text-dark">@Model.PathologistName</strong>
                    </div>
                </div>
            </div>

            <!-- Analyte Values Breakdown Table -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-3">
                    <i class="bi bi-list-check me-1"></i> Quantitative Analyte Breakdown &amp; Biological Reference Ranges
                </h3>

                <div class="table-responsive rounded-3 border">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted text-uppercase">
                            <tr>
                                <th style="min-width: 220px;">Analyte / Parameter</th>
                                <th>Result Value</th>
                                <th>Unit</th>
                                <th>Reference Range</th>
                                <th>Diagnostic Flag</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@item.ParameterName</td>
                                    <td class="fw-bold @(item.Flag == LabFlag.High ? "text-danger" : item.Flag == LabFlag.Low ? "text-primary" : "text-dark")">
                                        @item.Value
                                    </td>
                                    <td class="text-muted">@item.Unit</td>
                                    <td class="text-muted">@item.ReferenceRange</td>
                                    <td>
                                        @if (item.Flag == LabFlag.Normal)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success border-opacity-25 rounded-pill px-2">
                                                Normal
                                            </span>
                                        }
                                        else if (item.Flag == LabFlag.High)
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2">
                                                <i class="bi bi-arrow-up"></i> High
                                            </span>
                                        }
                                        else if (item.Flag == LabFlag.Low)
                                        {
                                            <span class="badge bg-primary text-white rounded-pill px-2">
                                                <i class="bi bi-arrow-down"></i> Low
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2">
                                                Critical
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pathologist Summary & Notes -->
            @if (!string.IsNullOrEmpty(Model.ClinicalNotes) || !string.IsNullOrEmpty(Model.ResultSummary))
            {
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h4 class="h6 fw-bold text-dark mb-1">
                        <i class="bi bi-chat-left-text me-1 text-primary-drmc"></i> Diagnostic Interpretation &amp; Clinical Notes
                    </h4>
                    <p class="small text-muted mb-0 leading-relaxed">
                        @(string.IsNullOrEmpty(Model.ClinicalNotes) ? Model.ResultSummary : Model.ClinicalNotes)
                    </p>
                </div>
            }

            <!-- Verification & Action Footer -->
            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center pt-3 border-top d-print-none">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Back to Results
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Trends" asp-route-parameter="@(Model.Items.FirstOrDefault()?.ParameterName)" class="btn btn-outline-drmc rounded-pill px-3 fw-semibold">
                        <i class="bi bi-graph-up me-1"></i> Track Trend
                    </a>
                    <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                        <i class="bi bi-printer-fill me-1"></i> Print Official Report
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
