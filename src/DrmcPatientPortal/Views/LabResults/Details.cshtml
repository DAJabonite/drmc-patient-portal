@model PatientReportCard
@{
    ViewData["Title"] = Model.Description;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var hasReturnUrl = Url.IsLocalUrl(returnUrl);
    var backUrl = hasReturnUrl ? Url.Content(returnUrl) : Url.Action("Index");
}
<section class="patient-record-header"><div class="container patient-report-detail-container">
    <a href="@backUrl" class="patient-record-back"><i class="bi bi-arrow-left" aria-hidden="true"></i> @(hasReturnUrl ? Loc["Report_BackPrevious"] : Loc["Report_BackLab"])</a>
    <p class="patient-record-eyebrow">@Loc["PatientUX_ResultsTitle"]</p>
    <h1 class="h2 fw-bold text-break mb-0">@Model.Description</h1>
</div></section>
<section class="section patient-report-section"><div class="container patient-report-detail-container">
    <partial name="_PatientReportDetails" model="Model" />
</div></section>
