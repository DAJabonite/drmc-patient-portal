@model LabResult
@{
    ViewData["Title"] = $"{Model.TestName} — Result Availability & Claiming Guide";
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> All Lab Results
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@Model.Category</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">Result Availability &amp; Claiming Guide</h1>
        <p class="text-white text-opacity-90 mb-0">Accession Number: <strong>@Model.AccessionNumber</strong> &middot; Davao Regional Medical Center</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 920px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            
            <!-- Availability Status Banner -->
            @if (Model.Status == "Available")
            {
                <div class="alert alert-success d-flex align-items-start gap-3 rounded-4 border-0 shadow-xs p-3 p-md-4 mb-4" role="status">
                    <div class="p-2 rounded-circle bg-success text-white d-inline-flex fs-4" style="flex-shrink:0;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold text-success-emphasis mb-1">Official Result is Ready for Claiming</h2>
                        <p class="mb-0 small text-success-emphasis">
                            Your diagnostic test has been completed, validated, and signed by the clinical pathologist. Official sealed physical reports are available for claiming at the hospital releasing window.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-start gap-3 rounded-4 border-0 shadow-xs p-3 p-md-4 mb-4" role="status">
                    <div class="p-2 rounded-circle bg-warning text-dark d-inline-flex fs-4" style="flex-shrink:0;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold text-warning-emphasis mb-1">Specimen Processing in Progress</h2>
                        <p class="mb-0 small text-warning-emphasis">
                            Your diagnostic order is currently undergoing laboratory processing and clinical validation. Once completed, your status will update to "Ready for Claiming".
                        </p>
                    </div>
                </div>
            }

            <!-- Test Order Metadata Header -->
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 pb-3 mb-4 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill small fw-semibold mb-2">
                        @Model.Category Panel
                    </span>
                    <h2 class="h4 fw-bold text-dark mb-1">@Model.TestName</h2>
                    <p class="text-muted small mb-0">
                        Accession Code: <strong class="text-dark font-monospace">@Model.AccessionNumber</strong>
                    </p>
                </div>

                <div class="text-md-end">
                    <div class="small text-muted" style="font-size: 0.85rem;">
                        <i class="bi bi-calendar3 me-1"></i> Collected: <strong>@Model.CollectedAt.ToString("MMM d, yyyy h:mm tt")</strong>
                    </div>
                    @if (Model.ReleasedAt.HasValue)
                    {
                        <div class="small text-muted mt-1" style="font-size: 0.85rem;">
                            <i class="bi bi-check2-circle me-1 text-success"></i> Released: <strong>@Model.ReleasedAt.Value.ToString("MMM d, yyyy h:mm tt")</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Physician Attribution -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Requesting / Ordering Physician</span>
                        <strong class="small text-dark">@(string.IsNullOrEmpty(Model.OrderingPhysician) ? "Attending OPD Physician" : Model.OrderingPhysician)</strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Designated Performing Facility</span>
                        <strong class="small text-dark">@(string.IsNullOrEmpty(Model.PerformingUnit) ? "DRMC Central Clinical Diagnostic Laboratory" : Model.PerformingUnit)</strong>
                    </div>
                </div>
            </div>

            <!-- Where & How to Claim Guide -->
            <div class="mb-4">
                <h3 class="h6 fw-bold text-primary-drmc mb-3">
                    <i class="bi bi-geo-alt-fill me-1"></i> Where &amp; How to Claim Your Official Results
                </h3>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 p-3 bg-light">
                            <h4 class="h6 fw-bold text-dark mb-2">
                                <i class="bi bi-building me-1 text-primary-drmc"></i> Releasing Location
                            </h4>
                            <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-2">
                                <li>
                                    <strong>Unit:</strong> @(string.IsNullOrEmpty(Model.PerformingUnit) ? "DRMC Central Clinical Diagnostic Laboratory" : Model.PerformingUnit)
                                </li>
                                <li>
                                    <strong>Window:</strong> Laboratory Releasing Window &amp; HIMD Records
                                </li>
                                <li>
                                    <strong>Facility:</strong> Ground Floor, Clinical Laboratory Building
                                </li>
                                <li>
                                    <strong>Address:</strong> Davao Regional Medical Center, Apokon, Tagum City, Davao del Norte
                                </li>
                                <li>
                                    <strong>Schedule:</strong> Monday to Friday, 8:00 AM – 5:00 PM (Outpatient Releasing)
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card h-100 border rounded-3 p-3 bg-light">
                            <h4 class="h6 fw-bold text-dark mb-2">
                                <i class="bi bi-card-checklist me-1 text-primary-drmc"></i> Claiming Requirements
                            </h4>
                            <ul class="list-unstyled small text-muted mb-0 d-flex flex-column gap-2">
                                <li>
                                    <i class="bi bi-check2 text-success me-1"></i> <strong>Valid Photo ID:</strong> Any government ID (PhilSys, Driver's License, PRC, UMID) or DRMC Hospital Card.
                                </li>
                                <li>
                                    <i class="bi bi-check2 text-success me-1"></i> <strong>Accession Slip:</strong> Present Accession Number <code>@Model.AccessionNumber</code>.
                                </li>
                                <li>
                                    <i class="bi bi-check2 text-success me-1"></i> <strong>Authorized Representative:</strong> If claimed by family or representative, bring a signed Authorization Letter, patient's valid ID, and representative's valid ID.
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <nav class="lab-result-actions pt-3 border-top" aria-label="Result actions">
                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Back to Results
                </a>
                <a asp-controller="Home" asp-action="OpdGuide" class="btn btn-outline-drmc fw-semibold">
                    <i class="bi bi-signpost-split me-1"></i> OPD Wayfinding Guide
                </a>
                <a asp-controller="Directory" asp-action="Index" class="btn btn-outline-drmc fw-semibold">
                    <i class="bi bi-person-badge me-1"></i> Doctor Directory
                </a>
            </nav>

        </div>
    </div>
</section>
