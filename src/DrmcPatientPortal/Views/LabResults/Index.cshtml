@model LabResultsIndexViewModel
@{
    ViewData["Title"] = "Diagnostic & Laboratory Results";
}

<section class="page-header">
    <div class="container">
        <div>
            <p class="small text-white text-opacity-75 mb-1">Central Diagnostic Laboratory</p>
            <h1 class="display-6 fw-bold mb-0">Laboratory &amp; Diagnostic Results</h1>
        </div>
    </div>
</section>

<!-- Result filters -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <form asp-action="Index" method="get" class="lab-filter-form" id="labResultFilterForm">
            <div class="lab-filter-toolbar">
                <div class="lab-category-field">
                    <label for="labCategoryFilter" class="form-label small fw-semibold text-dark mb-1 lab-filter-label">Test category</label>
                    <select id="labCategoryFilter" name="category" class="form-select" aria-label="Filter by test category">
                        <option value="" selected="@(!Model.SelectedCategory.HasValue)">All Tests (@Model.TotalCount)</option>
                        <option value="@LabCategory.Hematology" selected="@(Model.SelectedCategory == LabCategory.Hematology)">Hematology</option>
                        <option value="@LabCategory.ClinicalChemistry" selected="@(Model.SelectedCategory == LabCategory.ClinicalChemistry)">Clinical Chemistry</option>
                        <option value="@LabCategory.SpecialDiagnostics" selected="@(Model.SelectedCategory == LabCategory.SpecialDiagnostics)">Special Diagnostics</option>
                    </select>
                </div>
                <button type="button"
                        class="btn btn-outline-drmc lab-date-toggle d-md-none"
                        id="labDateToggle"
                        aria-expanded="@(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "true" : "false")"
                        aria-controls="labDatePanel">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span>Date</span>
                    @if (!string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <span class="filter-active-dot" aria-label="Date filter active"></span>
                    }
                </button>
            </div>

            <div id="labDatePanel" class="lab-date-panel @(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "is-open" : null)">
                <div class="lab-date-field">
                    <label for="labDateFilter" class="form-label small fw-semibold text-dark mb-1">Date</label>
                    <select id="labDateFilter" name="dateRange" class="form-select" aria-controls="customLabDateRange">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">Any date</option>
                        <option value="30d" selected="@(Model.SelectedDateRange == "30d")">Last 30 days</option>
                        <option value="6m" selected="@(Model.SelectedDateRange == "6m")">Last 6 months</option>
                        <option value="year" selected="@(Model.SelectedDateRange == "year")">This year</option>
                        <option value="custom" selected="@(Model.SelectedDateRange == "custom")">Custom date range</option>
                    </select>
                </div>
                <div id="customLabDateRange" class="lab-custom-date @(Model.SelectedDateRange == "custom" ? null : "d-none")">
                    <fieldset class="custom-date-range">
                        <legend class="visually-hidden">Custom laboratory result date range</legend>
                        <div>
                            <label for="labStartDate" class="form-label small fw-semibold text-dark mb-1">From</label>
                            <input id="labStartDate"
                                   name="startDate"
                                   type="date"
                                   value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@(Model.SelectedEndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div>
                            <label for="labEndDate" class="form-label small fw-semibold text-dark mb-1">To</label>
                            <input id="labEndDate"
                                   name="endDate"
                                   type="date"
                                   value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")"
                                   min="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                        </div>
                    </fieldset>
                    @if (ViewData["DateRangeError"] is string dateRangeError)
                    {
                        <p class="small text-danger mt-2 mb-0" role="alert">@dateRangeError</p>
                    }
                </div>
                <div class="lab-filter-actions">
                    <button type="submit" class="btn btn-primary-drmc fw-semibold">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i> Apply
                    </button>
                    @if (Model.SelectedCategory.HasValue || !string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const filterForm = document.getElementById("labResultFilterForm");
            const categorySelect = document.getElementById("labCategoryFilter");
            const rangeSelect = document.getElementById("labDateFilter");
            const customRange = document.getElementById("customLabDateRange");
            const startDate = document.getElementById("labStartDate");
            const endDate = document.getElementById("labEndDate");
            const dateToggle = document.getElementById("labDateToggle");
            const datePanel = document.getElementById("labDatePanel");

            if (!rangeSelect || !customRange || !startDate || !endDate) return;

            const setDatePanelOpen = (open) => {
                datePanel?.classList.toggle("is-open", open);
                dateToggle?.setAttribute("aria-expanded", open ? "true" : "false");
            };

            const syncRangeVisibility = () => {
                const isCustom = rangeSelect.value === "custom";
                customRange.classList.toggle("d-none", !isCustom);
                startDate.required = isCustom;
                endDate.required = isCustom;
            };

            rangeSelect.addEventListener("change", syncRangeVisibility);
            startDate.addEventListener("change", () => {
                endDate.min = startDate.value;
                if (endDate.value && endDate.value < startDate.value) endDate.value = startDate.value;
            });
            endDate.addEventListener("change", () => {
                startDate.max = endDate.value || "@DateTime.Today.ToString("yyyy-MM-dd")";
            });

            dateToggle?.addEventListener("click", () => {
                setDatePanelOpen(dateToggle.getAttribute("aria-expanded") !== "true");
            });
            datePanel?.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && window.matchMedia("(max-width: 767.98px)").matches) {
                    setDatePanelOpen(false);
                    dateToggle?.focus();
                }
            });
            categorySelect?.addEventListener("change", () => {
                if (window.matchMedia("(max-width: 767.98px)").matches) filterForm?.requestSubmit();
            });

            syncRangeVisibility();
        })();
    </script>
}

<section class="section py-5 bg-light">
    <div class="container">
        @if (Model.LabResults.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                <i class="bi bi-file-earmark-x fs-1 text-muted mb-2"></i>
                <h3 class="h5 fw-bold text-dark">No laboratory results found</h3>
                <p class="text-muted small mb-3">No diagnostic records matched your selected criteria.</p>
                <a asp-action="Index" class="btn btn-primary-drmc btn-sm rounded-pill px-4 fw-semibold mx-auto">
                    View All Results
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var lab in Model.LabResults)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow-sm transition">
                        <div class="row align-items-center g-3">
                            <div class="col-md-7">
                                <div class="record-metadata d-flex flex-wrap align-items-center gap-2 mb-1">
                                    @if (lab.Status == "Available")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i> Ready for Claiming
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill small">
                                            <i class="bi bi-hourglass-split me-1"></i> Processing in Laboratory
                                        </span>
                                    }
                                    <span class="badge bg-light text-secondary border rounded-pill small">
                                        @lab.Category
                                    </span>
                                    <span class="record-reference small text-muted" style="font-size: 0.75rem;">
                                        Accession: <strong>@lab.AccessionNumber</strong>
                                    </span>
                                </div>

                                <h2 class="h5 fw-bold text-primary-drmc mb-1">@lab.TestName</h2>
                                
                                <div class="p-2 bg-light rounded-3 border-start border-3 border-primary-subtle my-2">
                                    <div class="small text-dark">
                                        <i class="bi bi-geo-alt-fill text-primary-drmc me-1"></i>
                                        Claiming Unit: <strong>@(string.IsNullOrEmpty(lab.PerformingUnit) ? "DRMC Central Clinical Diagnostic Laboratory" : lab.PerformingUnit)</strong>
                                    </div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">
                                        Releasing Window &middot; Ground Floor Laboratory Building
                                    </div>
                                </div>

                                <div class="small text-muted d-flex flex-wrap gap-3" style="font-size: 0.8rem;">
                                    <span><i class="bi bi-calendar3 me-1"></i> Collected: @lab.CollectedAt.ToString("MMM d, yyyy")</span>
                                    @if (lab.ReleasedAt.HasValue)
                                    {
                                        <span><i class="bi bi-check2-circle me-1"></i> Released: @lab.ReleasedAt.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    @if (!string.IsNullOrEmpty(lab.OrderingPhysician))
                                    {
                                        <span><i class="bi bi-person-badge me-1"></i> Ordered by: @lab.OrderingPhysician</span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-5 text-md-end">
                                <div class="d-flex gap-2 justify-content-md-end">
                                    @if (lab.Status == "Available")
                                    {
                                        <a asp-action="Details" asp-route-id="@lab.Id" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                                            <i class="bi bi-file-earmark-check me-1"></i> Claiming Details &amp; Location
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@lab.Id" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold small">
                                            <i class="bi bi-info-circle me-1"></i> Check Status &amp; Location
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
