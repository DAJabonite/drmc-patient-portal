@model LabResultsIndexViewModel
@{
    ViewData["Title"] = Loc["PatientUX_ResultsTitle"];
}

<section class="patient-record-header bg-white">
    <div class="container">
        <div>
            <h1 class="h2 fw-bold mb-0">@Loc["PatientUX_ResultsTitle"]</h1>
        </div>
    </div>
</section>

<!-- Result filters -->
<section class="py-3 bg-white border-bottom">
    <div class="container">
        <details class="patient-report-filter-disclosure" open="@(Model.HasFilters || ViewData["DateRangeError"] is not null)">
            <summary class="patient-report-filter-summary"><i class="bi bi-funnel" aria-hidden="true"></i> @Loc["PatientUX_FilterResults"]</summary>
        <form asp-action="Index" method="get" data-live-filter class="lab-filter-form has-search" id="labResultFilterForm" role="search" aria-label="@Loc["PatientUX_ResultsTitle"]">
            <div class="radiology-search-field">
                <label for="labSearch" class="form-label small fw-semibold">@Loc["PatientUX_Search"]</label>
                <input id="labSearch" name="search" type="search" class="form-control" value="@Model.SearchTerm" maxlength="200" placeholder="@Loc["PatientUX_ReportSearchHint"]" />
            </div>
            <div class="lab-request-status-field">
                <label for="requestStatus" class="form-label small fw-semibold">@Loc["PatientUX_RequestStatus"]</label>
                <select id="requestStatus" name="status" class="form-select">
                    <option value="" selected="@(Model.SelectedStatus == null)">@Loc["PatientUX_AllRequests"]</option>
                    <option value="pending" selected="@(Model.SelectedStatus == "pending")">@Loc["PatientUX_PendingRequests"]</option>
                    <option value="released" selected="@(Model.SelectedStatus == "released")">@Loc["PatientUX_ReleasedReports"]</option>
                </select>
            </div>
            <div class="lab-filter-toolbar">
                <div class="lab-category-field">
                    <label for="labCategoryFilter" class="form-label small fw-semibold text-dark mb-1 lab-filter-label">@Loc["PatientUX_TestCategory"]</label>
                    <select id="labCategoryFilter" name="category" class="form-select">
                        <option value="" selected="@(!Model.SelectedCategory.HasValue)">@Loc["PatientUX_AllTests", Model.TotalCount]</option>
                        @foreach (var category in Enum.GetValues<LabCategory>())
                        {
                            <option value="@category" selected="@(Model.SelectedCategory == category)">@category.DisplayName()</option>
                        }
                    </select>
                </div>
            </div>

            <div id="labDatePanel" class="lab-date-panel @(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "is-open" : null)">
                <div class="lab-date-field">
                    <label for="labDateFilter" class="form-label small fw-semibold text-dark mb-1">@Loc["PatientUX_VisitDate"]</label>
                    <select id="labDateFilter" name="dateRange" class="form-select" aria-controls="customLabDateRange">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">@Loc["Report_AnyDate"]</option>
                        <option value="30d" selected="@(Model.SelectedDateRange == "30d")">@Loc["Report_Last30Days"]</option>
                        <option value="6m" selected="@(Model.SelectedDateRange == "6m")">@Loc["Report_Last6Months"]</option>
                        <option value="year" selected="@(Model.SelectedDateRange == "year")">@Loc["Report_ThisYear"]</option>
                        <option value="custom" selected="@(Model.SelectedDateRange == "custom")">@Loc["Report_CustomRange"]</option>
                    </select>
                </div>
                <div id="customLabDateRange" class="lab-custom-date @(Model.SelectedDateRange == "custom" ? null : "d-none")">
                    <fieldset class="custom-date-range">
                        <legend class="visually-hidden">@Loc["PatientUX_CustomVisitDate"]</legend>
                        <div>
                            <label for="labStartDate" class="form-label small fw-semibold text-dark mb-1">@Loc["Report_From"]</label>
                            <input id="labStartDate"
                                   name="startDate"
                                   type="date"
                                   value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@(Model.SelectedEndDate?.ToString("yyyy-MM-dd") ?? DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div>
                            <label for="labEndDate" class="form-label small fw-semibold text-dark mb-1">@Loc["Report_To"]</label>
                            <input id="labEndDate"
                                   name="endDate"
                                   type="date"
                                   value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")"
                                   min="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                        </div>
                    </fieldset>
                    @if (ViewData["DateRangeError"] is string dateRangeError)
                    {
                        <p class="small text-danger mt-2 mb-0" role="alert">@dateRangeError</p>
                    }
                </div>
                <div class="lab-filter-actions">
                    <button type="submit" class="btn btn-primary-drmc fw-semibold">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i> @Loc["Report_Apply"]
                    </button>
                    @if (Model.HasFilters)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">@Loc["PatientUX_Clear"]</a>
                    }
                </div>
            </div>
        </form>
        </details>
    </div>
</section>

@section Scripts {
    <script src="~/js/date-range-filter.js" asp-append-version="true"
            data-form="labResultFilterForm"
            data-mobile-submit="labCategoryFilter"
            data-status="requestStatus"
            data-range="labDateFilter"
            data-custom-range="customLabDateRange"
            data-start="labStartDate"
            data-end="labEndDate"
            data-today="@DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd")"></script>
}

<section class="section patient-report-section">
    <div class="container">
        @{ ViewData["ReportKind"] = "lab"; }
        <partial name="_EncounterReportGroups" model="Model.Results" />
    </div>
</section>
