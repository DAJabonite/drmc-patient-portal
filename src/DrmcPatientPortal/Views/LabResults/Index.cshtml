@model LabResultsIndexViewModel
@{
    ViewData["Title"] = "Diagnostic & Laboratory Results";
}

<section class="page-header">
    <div class="container">
        <div>
            <p class="small text-white text-opacity-75 mb-1">Central Diagnostic Laboratory</p>
            <h1 class="display-6 fw-bold mb-0">Laboratory &amp; Diagnostic Results</h1>
        </div>
    </div>
</section>

<!-- Filter & Search Bar -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2 overflow-x-auto pb-1" style="max-width: 100%;">
                <a asp-action="Index" asp-route-search="@Model.SearchTerm"
                   class="btn btn-sm @(!Model.SelectedCategory.HasValue ? "btn-primary-drmc shadow-xs" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                    All Tests (@Model.TotalCount)
                </a>
                <a asp-action="Index" asp-route-category="@LabCategory.Hematology" asp-route-search="@Model.SearchTerm"
                   class="btn btn-sm @(Model.SelectedCategory == LabCategory.Hematology ? "btn-primary-drmc shadow-xs" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                    Hematology
                </a>
                <a asp-action="Index" asp-route-category="@LabCategory.ClinicalChemistry" asp-route-search="@Model.SearchTerm"
                   class="btn btn-sm @(Model.SelectedCategory == LabCategory.ClinicalChemistry ? "btn-primary-drmc shadow-xs" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                    Clinical Chemistry
                </a>
                <a asp-action="Index" asp-route-category="@LabCategory.SpecialDiagnostics" asp-route-search="@Model.SearchTerm"
                   class="btn btn-sm @(Model.SelectedCategory == LabCategory.SpecialDiagnostics ? "btn-primary-drmc shadow-xs" : "btn-outline-secondary") rounded-pill px-3 fw-semibold text-nowrap">
                    Special Diagnostics
                </a>
            </div>

            <form asp-action="Index" method="get" class="record-search d-flex gap-2" role="search">
                @if (Model.SelectedCategory.HasValue)
                {
                    <input type="hidden" name="category" value="@Model.SelectedCategory.Value" />
                }
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm"
                       placeholder="Search test name or accession..." aria-label="Search test name or accession" />
                <button type="submit" class="btn btn-sm btn-primary-drmc px-3 fw-semibold" aria-label="Search results">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container">
        <!-- Patient Privacy & RA 10173 Notice -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white" role="note">
            <div class="d-flex align-items-start gap-3">
                <div class="p-2 rounded-circle bg-primary-subtle text-primary-drmc d-inline-flex" style="flex-shrink:0;">
                    <i class="bi bi-shield-lock-fill fs-4" aria-hidden="true"></i>
                </div>
                <div>
                    <h2 class="h6 fw-bold text-dark mb-1">Patient Health Data Privacy Notice</h2>
                    <p class="text-muted small mb-0">
                        In compliance with the <strong>Data Privacy Act of 2012 (RA 10173)</strong> and DRMC health confidentiality regulations, numerical laboratory values, clinical analyte measurements, and diagnostic impressions are not displayed online. This portal tracks the availability of your orders and guides you on claiming your official, sealed physical reports.
                    </p>
                </div>
            </div>
        </div>

        @if (Model.LabResults.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                <i class="bi bi-file-earmark-x fs-1 text-muted mb-2"></i>
                <h3 class="h5 fw-bold text-dark">No laboratory results found</h3>
                <p class="text-muted small mb-3">No diagnostic records matched your selected criteria.</p>
                <a asp-action="Index" class="btn btn-primary-drmc btn-sm rounded-pill px-4 fw-semibold mx-auto">
                    View All Results
                </a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var lab in Model.LabResults)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white hover-shadow-sm transition">
                        <div class="row align-items-center g-3">
                            <div class="col-md-7">
                                <div class="record-metadata d-flex flex-wrap align-items-center gap-2 mb-1">
                                    @if (lab.Status == "Available")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill small">
                                            <i class="bi bi-check-circle-fill me-1"></i> Ready for Claiming
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill small">
                                            <i class="bi bi-hourglass-split me-1"></i> Processing in Laboratory
                                        </span>
                                    }
                                    <span class="badge bg-light text-secondary border rounded-pill small">
                                        @lab.Category
                                    </span>
                                    <span class="record-reference small text-muted" style="font-size: 0.75rem;">
                                        Accession: <strong>@lab.AccessionNumber</strong>
                                    </span>
                                </div>

                                <h2 class="h5 fw-bold text-primary-drmc mb-1">@lab.TestName</h2>
                                
                                <div class="p-2 bg-light rounded-3 border-start border-3 border-primary-subtle my-2">
                                    <div class="small text-dark">
                                        <i class="bi bi-geo-alt-fill text-primary-drmc me-1"></i>
                                        Claiming Unit: <strong>@(string.IsNullOrEmpty(lab.PerformingUnit) ? "DRMC Central Clinical Diagnostic Laboratory" : lab.PerformingUnit)</strong>
                                    </div>
                                    <div class="small text-muted" style="font-size: 0.75rem;">
                                        Releasing Window &middot; Ground Floor Laboratory Building
                                    </div>
                                </div>

                                <div class="small text-muted d-flex flex-wrap gap-3" style="font-size: 0.8rem;">
                                    <span><i class="bi bi-calendar3 me-1"></i> Collected: @lab.CollectedAt.ToString("MMM d, yyyy")</span>
                                    @if (lab.ReleasedAt.HasValue)
                                    {
                                        <span><i class="bi bi-check2-circle me-1"></i> Released: @lab.ReleasedAt.Value.ToString("MMM d, yyyy")</span>
                                    }
                                    @if (!string.IsNullOrEmpty(lab.OrderingPhysician))
                                    {
                                        <span><i class="bi bi-person-badge me-1"></i> Ordered by: @lab.OrderingPhysician</span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-5 text-md-end">
                                <div class="d-flex gap-2 justify-content-md-end">
                                    @if (lab.Status == "Available")
                                    {
                                        <a asp-action="Details" asp-route-id="@lab.Id" class="btn btn-primary-drmc rounded-pill px-4 fw-semibold shadow-xs">
                                            <i class="bi bi-file-earmark-check me-1"></i> Claiming Details &amp; Location
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@lab.Id" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold small">
                                            <i class="bi bi-info-circle me-1"></i> Check Status &amp; Location
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
