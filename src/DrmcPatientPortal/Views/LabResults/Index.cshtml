@model LabResultsIndexViewModel
@{
    ViewData["Title"] = "Diagnostic & Laboratory Results";
}

<section class="page-header">
    <div class="container">
        <div>
            <h1 class="display-6 fw-bold mb-0">Laboratory &amp; Diagnostic Results</h1>
        </div>
    </div>
</section>

<!-- Result filters -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <form asp-action="Index" method="get" class="lab-filter-form" id="labResultFilterForm">
            <div class="lab-filter-toolbar">
                <div class="lab-category-field">
                    <label for="labCategoryFilter" class="form-label small fw-semibold text-dark mb-1 lab-filter-label">Test category</label>
                    <select id="labCategoryFilter" name="category" class="form-select" aria-label="Filter by test category">
                        <option value="" selected="@(!Model.SelectedCategory.HasValue)">All Tests (@Model.TotalCount)</option>
                        @foreach (var category in Enum.GetValues<LabCategory>())
                        {
                            <option value="@category" selected="@(Model.SelectedCategory == category)">@category.DisplayName()</option>
                        }
                    </select>
                </div>
                <button type="button"
                        class="btn btn-outline-drmc lab-date-toggle d-md-none"
                        id="labDateToggle"
                        aria-expanded="@(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "true" : "false")"
                        aria-controls="labDatePanel">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span>Date</span>
                    @if (!string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <span class="filter-active-dot" aria-label="Date filter active"></span>
                    }
                </button>
            </div>

            <div id="labDatePanel" class="lab-date-panel @(Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null ? "is-open" : null)">
                <div class="lab-date-field">
                    <label for="labDateFilter" class="form-label small fw-semibold text-dark mb-1">Date</label>
                    <select id="labDateFilter" name="dateRange" class="form-select" aria-controls="customLabDateRange">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">Any date</option>
                        <option value="30d" selected="@(Model.SelectedDateRange == "30d")">Last 30 days</option>
                        <option value="6m" selected="@(Model.SelectedDateRange == "6m")">Last 6 months</option>
                        <option value="year" selected="@(Model.SelectedDateRange == "year")">This year</option>
                        <option value="custom" selected="@(Model.SelectedDateRange == "custom")">Custom date range</option>
                    </select>
                </div>
                <div id="customLabDateRange" class="lab-custom-date @(Model.SelectedDateRange == "custom" ? null : "d-none")">
                    <fieldset class="custom-date-range">
                        <legend class="visually-hidden">Custom laboratory result date range</legend>
                        <div>
                            <label for="labStartDate" class="form-label small fw-semibold text-dark mb-1">From</label>
                            <input id="labStartDate"
                                   name="startDate"
                                   type="date"
                                   value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@(Model.SelectedEndDate?.ToString("yyyy-MM-dd") ?? DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd"))"
                                   class="form-control" />
                        </div>
                        <div>
                            <label for="labEndDate" class="form-label small fw-semibold text-dark mb-1">To</label>
                            <input id="labEndDate"
                                   name="endDate"
                                   type="date"
                                   value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")"
                                   min="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                        </div>
                    </fieldset>
                    @if (ViewData["DateRangeError"] is string dateRangeError)
                    {
                        <p class="small text-danger mt-2 mb-0" role="alert">@dateRangeError</p>
                    }
                </div>
                <div class="lab-filter-actions">
                    <button type="submit" class="btn btn-primary-drmc fw-semibold">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i> Apply
                    </button>
                    @if (Model.SelectedCategory.HasValue || !string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/date-range-filter.js" asp-append-version="true"
            data-form="labResultFilterForm"
            data-mobile-submit="labCategoryFilter"
            data-range="labDateFilter"
            data-custom-range="customLabDateRange"
            data-start="labStartDate"
            data-end="labEndDate"
            data-toggle="labDateToggle"
            data-panel="labDatePanel"
            data-today="@DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd")"></script>
}

<section class="section py-5 bg-light">
    <div class="container">
        @if (Model.DateGroups.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                <i class="bi bi-file-earmark-x fs-1 text-muted mb-2" aria-hidden="true"></i>
                <h2 class="h5 fw-bold text-dark">No laboratory PDFs found</h2>
                <p class="text-muted small mb-3">No released PDF reports matched your selected criteria.</p>
                <a asp-action="Index" class="btn btn-primary-drmc btn-sm rounded-pill px-4 fw-semibold mx-auto">View all results</a>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @for (var groupIndex = 0; groupIndex < Model.DateGroups.Count; groupIndex++)
                {
                    var group = Model.DateGroups[groupIndex];
                    <details class="card border-0 shadow-sm rounded-4 bg-white"
                             data-testid="lab-date-group" data-date="@group.Date.ToString("yyyy-MM-dd")" open="@(groupIndex == 0)">
                        <summary class="p-4 fw-bold text-primary-drmc">
                            Test date: <time datetime="@group.Date.ToString("yyyy-MM-dd")">@group.Date.ToString("MMM d, yyyy")</time>
                            <span class="badge bg-light text-secondary border ms-2">@group.Reports.Count @(group.Reports.Count == 1 ? "PDF" : "PDFs")</span>
                        </summary>
                        <div class="px-4 pb-4">
                            @for (var reportIndex = 0; reportIndex < group.Reports.Count; reportIndex++)
                            {
                                var report = group.Reports[reportIndex];
                                var description = $"{report.TestName} on {group.Date:MMM d, yyyy}, PDF {reportIndex + 1}";
                                <article class="py-3 border-top" data-report-id="@report.Id">
                                    <h2 class="h6 fw-bold text-dark">@report.TestName</h2>
                                    <partial name="_PdfReportActions" model='new PdfReportActionsViewModel("LabResults", report.Id, description)' />
                                </article>
                            }
                        </div>
                    </details>
                }
            </div>
        }
    </div>
</section>
