@model RadiologyIndexViewModel
@{
    ViewData["Title"] = Loc["Nav_Radiology"];
    var today = DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd");
    var dateOpen = Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null;
    var dept = Model.Department;
}

<section class="patient-record-header bg-white">
    <div class="container">
        <div>
            <h1 class="h2 fw-bold mb-0">@Loc["Nav_Radiology"]</h1>
        </div>
    </div>
</section>

<!-- Study filters -->
<section class="py-3 bg-white border-bottom">
    <div class="container">
        <details class="patient-report-filter-disclosure" open="@(Model.HasFilters || ViewData["DateRangeError"] is not null)">
            <summary class="patient-report-filter-summary"><i class="bi bi-funnel" aria-hidden="true"></i> @Loc["PatientUX_FilterResults"]</summary>
        <form asp-action="Index" method="get" data-live-filter class="lab-filter-form has-search" id="radiologyFilterForm" role="search" aria-label="@Loc["Nav_Radiology"]">
            <div class="radiology-search-field">
                <label for="radiologySearch" class="form-label small fw-semibold text-dark mb-1">@Loc["PatientUX_Search"]</label>
                <input id="radiologySearch" name="search" type="search" class="form-control"
                       value="@Model.SearchTerm" maxlength="200" placeholder="@Loc["PatientUX_ReportSearchHint"]" />
            </div>
            <div class="lab-request-status-field">
                <label for="requestStatus" class="form-label small fw-semibold">@Loc["PatientUX_RequestStatus"]</label>
                <select id="requestStatus" name="status" class="form-select">
                    <option value="" selected="@(Model.SelectedStatus == null)">@Loc["PatientUX_AllRequests"]</option>
                    <option value="pending" selected="@(Model.SelectedStatus == "pending")">@Loc["PatientUX_PendingRequests"]</option>
                    <option value="released" selected="@(Model.SelectedStatus == "released")">@Loc["PatientUX_ReleasedReports"]</option>
                </select>
            </div>
            <div class="lab-filter-toolbar">
                <div class="lab-category-field">
                    <label for="radiologyModalityFilter" class="form-label small fw-semibold text-dark mb-1 lab-filter-label">@Loc["PatientUX_ImagingType"]</label>
                    <select id="radiologyModalityFilter" name="modality" class="form-select">
                        <option value="" selected="@(!Model.SelectedModality.HasValue)">@Loc["PatientUX_AllImaging", Model.TotalCount]</option>
                        @foreach (var modality in Enum.GetValues<RadiologyModality>())
                        {
                            <option value="@modality" selected="@(Model.SelectedModality == modality)">@modality.PdfDisplayName()</option>
                        }
                    </select>
                </div>
            </div>

            <div id="radiologyDatePanel" class="lab-date-panel @(dateOpen ? "is-open" : null)">
                <div class="lab-date-field">
                    <label for="radiologyDateFilter" class="form-label small fw-semibold text-dark mb-1">@Loc["PatientUX_VisitDate"]</label>
                    <select id="radiologyDateFilter" name="dateRange" class="form-select" aria-controls="customRadiologyDateRange">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">@Loc["Report_AnyDate"]</option>
                        <option value="30d" selected="@(Model.SelectedDateRange == "30d")">@Loc["Report_Last30Days"]</option>
                        <option value="6m" selected="@(Model.SelectedDateRange == "6m")">@Loc["Report_Last6Months"]</option>
                        <option value="year" selected="@(Model.SelectedDateRange == "year")">@Loc["Report_ThisYear"]</option>
                        <option value="custom" selected="@(Model.SelectedDateRange == "custom")">@Loc["Report_CustomRange"]</option>
                    </select>
                </div>
                <div id="customRadiologyDateRange" class="lab-custom-date @(Model.SelectedDateRange == "custom" ? null : "d-none")">
                    <fieldset class="custom-date-range">
                        <legend class="visually-hidden">@Loc["PatientUX_CustomVisitDate"]</legend>
                        <div>
                            <label for="radiologyStartDate" class="form-label small fw-semibold text-dark mb-1">@Loc["Report_From"]</label>
                            <input id="radiologyStartDate" name="startDate" type="date"
                                   value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@(Model.SelectedEndDate?.ToString("yyyy-MM-dd") ?? today)"
                                   class="form-control" />
                        </div>
                        <div>
                            <label for="radiologyEndDate" class="form-label small fw-semibold text-dark mb-1">@Loc["Report_To"]</label>
                            <input id="radiologyEndDate" name="endDate" type="date"
                                   value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")"
                                   min="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@today"
                                   class="form-control" />
                        </div>
                    </fieldset>
                    @if (ViewData["DateRangeError"] is string dateRangeError)
                    {
                        <p class="small text-danger mt-2 mb-0" role="alert">@dateRangeError</p>
                    }
                </div>
                <div class="lab-filter-actions">
                    <button type="submit" class="btn btn-primary-drmc fw-semibold">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i> @Loc["Report_Apply"]
                    </button>
                    @if (Model.HasFilters)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">@Loc["PatientUX_Clear"]</a>
                    }
                </div>
            </div>
        </form>
        </details>
    </div>
</section>

@section Scripts {
    <script src="~/js/date-range-filter.js" asp-append-version="true"
            data-form="radiologyFilterForm"
            data-mobile-submit="radiologyModalityFilter"
            data-status="requestStatus"
            data-range="radiologyDateFilter"
            data-custom-range="customRadiologyDateRange"
            data-start="radiologyStartDate"
            data-end="radiologyEndDate"
            data-today="@today"></script>
}

<section class="section patient-report-section">
    <div class="container">
        @{ ViewData["ReportKind"] = "radiology"; }
        <partial name="_EncounterReportGroups" model="Model.Results" />

        <partial name="_PreparationGuide" model="new RadiologyPreparationViewModel(Model.PreparationGuide, dept)" />

        <!-- Services overview -->
        <section class="card border-0 shadow-sm rounded-4 p-4 bg-white" aria-labelledby="radiologyServicesHeading">
            <h2 id="radiologyServicesHeading" class="h5 fw-bold text-dark mb-2">@Loc["PatientUX_ImagingServices"]</h2>
            <p class="small text-muted mb-3">@dept.Description</p>
            @if (dept.ServicesOffered is { Count: > 0 })
            {
                <ul class="small text-dark mb-3">
                    @foreach (var service in dept.ServicesOffered)
                    {
                        <li>@service</li>
                    }
                </ul>
            }
            <p class="small text-muted mb-3">
                <i class="bi bi-geo-alt-fill text-primary-drmc me-1" aria-hidden="true"></i>@dept.Location &middot;
                <i class="bi bi-telephone ms-1 me-1 text-primary-drmc" aria-hidden="true"></i>@dept.LocalExtension
            </p>
            <a asp-controller="Directory" asp-action="Department" asp-route-id="@dept.Name" class="btn btn-outline-drmc fw-semibold align-self-start">
                <i class="bi bi-building me-1" aria-hidden="true"></i> @Loc["PatientUX_ImagingDepartment"]
            </a>
        </section>
    </div>
</section>
