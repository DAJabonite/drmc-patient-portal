@model RadiologyIndexViewModel
@{
    ViewData["Title"] = "Radiology & Imaging";
    var today = DrmcPatientPortal.Services.ClinicalClock.Today.ToString("yyyy-MM-dd");
    var dateOpen = Model.SelectedDateRange is not null || ViewData["DateRangeError"] is not null;
    var dept = Model.Department;
}

<section class="page-header">
    <div class="container">
        <div>
            <h1 class="display-6 fw-bold mb-0">Radiology &amp; Imaging</h1>
        </div>
    </div>
</section>

<!-- Study filters -->
<section class="py-3 bg-white border-bottom sticky-top shadow-xs" style="z-index: 1020;">
    <div class="container">
        <form asp-action="Index" method="get" class="lab-filter-form has-search" id="radiologyFilterForm" role="search" aria-label="Filter imaging studies">
            <div class="radiology-search-field">
                <label for="radiologySearch" class="form-label small fw-semibold text-dark mb-1">Search</label>
                <input id="radiologySearch" name="search" type="search" class="form-control"
                       value="@Model.SearchTerm" maxlength="200" placeholder="Study, body part or accession" />
            </div>
            <div class="lab-filter-toolbar">
                <div class="lab-category-field">
                    <label for="radiologyModalityFilter" class="form-label small fw-semibold text-dark mb-1 lab-filter-label">Imaging type</label>
                    <select id="radiologyModalityFilter" name="modality" class="form-select" aria-label="Filter by imaging type">
                        <option value="" selected="@(!Model.SelectedModality.HasValue)">All imaging (@Model.TotalCount)</option>
                        @foreach (var modality in Enum.GetValues<RadiologyModality>())
                        {
                            <option value="@modality" selected="@(Model.SelectedModality == modality)">@modality.PdfDisplayName()</option>
                        }
                    </select>
                </div>
                <button type="button"
                        class="btn btn-outline-drmc lab-date-toggle d-md-none"
                        id="radiologyDateToggle"
                        aria-expanded="@(dateOpen ? "true" : "false")"
                        aria-controls="radiologyDatePanel">
                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                    <span>Date</span>
                    @if (!string.IsNullOrEmpty(Model.SelectedDateRange))
                    {
                        <span class="filter-active-dot" aria-label="Date filter active"></span>
                    }
                </button>
            </div>

            <div id="radiologyDatePanel" class="lab-date-panel @(dateOpen ? "is-open" : null)">
                <div class="lab-date-field">
                    <label for="radiologyDateFilter" class="form-label small fw-semibold text-dark mb-1">Date performed</label>
                    <select id="radiologyDateFilter" name="dateRange" class="form-select" aria-controls="customRadiologyDateRange">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedDateRange))">Any date</option>
                        <option value="30d" selected="@(Model.SelectedDateRange == "30d")">Last 30 days</option>
                        <option value="6m" selected="@(Model.SelectedDateRange == "6m")">Last 6 months</option>
                        <option value="year" selected="@(Model.SelectedDateRange == "year")">This year</option>
                        <option value="custom" selected="@(Model.SelectedDateRange == "custom")">Custom date range</option>
                    </select>
                </div>
                <div id="customRadiologyDateRange" class="lab-custom-date @(Model.SelectedDateRange == "custom" ? null : "d-none")">
                    <fieldset class="custom-date-range">
                        <legend class="visually-hidden">Custom imaging study date range</legend>
                        <div>
                            <label for="radiologyStartDate" class="form-label small fw-semibold text-dark mb-1">From</label>
                            <input id="radiologyStartDate" name="startDate" type="date"
                                   value="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@(Model.SelectedEndDate?.ToString("yyyy-MM-dd") ?? today)"
                                   class="form-control" />
                        </div>
                        <div>
                            <label for="radiologyEndDate" class="form-label small fw-semibold text-dark mb-1">To</label>
                            <input id="radiologyEndDate" name="endDate" type="date"
                                   value="@Model.SelectedEndDate?.ToString("yyyy-MM-dd")"
                                   min="@Model.SelectedStartDate?.ToString("yyyy-MM-dd")"
                                   max="@today"
                                   class="form-control" />
                        </div>
                    </fieldset>
                    @if (ViewData["DateRangeError"] is string dateRangeError)
                    {
                        <p class="small text-danger mt-2 mb-0" role="alert">@dateRangeError</p>
                    }
                </div>
                <div class="lab-filter-actions">
                    <button type="submit" class="btn btn-primary-drmc fw-semibold">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i> Apply
                    </button>
                    @if (Model.HasFilters)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">Clear</a>
                    }
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/date-range-filter.js" asp-append-version="true"
            data-form="radiologyFilterForm"
            data-mobile-submit="radiologyModalityFilter"
            data-range="radiologyDateFilter"
            data-custom-range="customRadiologyDateRange"
            data-start="radiologyStartDate"
            data-end="radiologyEndDate"
            data-toggle="radiologyDateToggle"
            data-panel="radiologyDatePanel"
            data-today="@today"></script>
}

<section class="section py-5 bg-light">
    <div class="container">
        <h2 class="h5 fw-bold text-dark mb-3">Your radiology PDFs</h2>
        @if (Model.DateGroups.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-5"
                 data-testid="@(Model.TotalCount == 0 ? "radiology-empty" : "radiology-no-match")">
                <i class="bi bi-file-earmark-pdf fs-1 text-muted mb-2" aria-hidden="true"></i>
                <h3 class="h5 fw-bold text-dark">No radiology PDFs found</h3>
                <p class="text-muted small mb-3">No released PDF reports matched your selected criteria.</p>
                @if (Model.HasFilters)
                {
                    <a asp-action="Index" class="btn btn-primary-drmc btn-sm rounded-pill px-4 fw-semibold mx-auto">View all results</a>
                }
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-5">
                @for (var groupIndex = 0; groupIndex < Model.DateGroups.Count; groupIndex++)
                {
                    var group = Model.DateGroups[groupIndex];
                    <details class="card border-0 shadow-sm rounded-4 bg-white"
                             data-testid="radiology-date-group" data-date="@group.Date.ToString("yyyy-MM-dd")" open="@(groupIndex == 0)">
                        <summary class="p-4 fw-bold text-primary-drmc">
                            Study date: <time datetime="@group.Date.ToString("yyyy-MM-dd")">@group.Date.ToString("MMM d, yyyy")</time>
                            <span class="badge bg-light text-secondary border ms-2">@group.Studies.Count @(group.Studies.Count == 1 ? "PDF" : "PDFs")</span>
                        </summary>
                        <div class="px-4 pb-4">
                            @for (var reportIndex = 0; reportIndex < group.Studies.Count; reportIndex++)
                            {
                                var study = group.Studies[reportIndex];
                                var description = $"{study.ModalityLabel} on {group.Date:MMM d, yyyy}, PDF {reportIndex + 1}";
                                <article class="py-3 border-top" data-report-id="@study.Id">
                                    <h3 class="h6 fw-bold text-dark">@study.ModalityLabel</h3>
                                    <partial name="_PdfReportActions" model='new PdfReportActionsViewModel("Radiology", study.Id, description)' />
                                </article>
                            }
                        </div>
                    </details>
                }
            </div>
        }

        <partial name="_PreparationGuide" model="new RadiologyPreparationViewModel(Model.PreparationGuide, dept)" />

        <!-- Services overview -->
        <section class="card border-0 shadow-sm rounded-4 p-4 bg-white" aria-labelledby="radiologyServicesHeading">
            <h2 id="radiologyServicesHeading" class="h5 fw-bold text-dark mb-2">Imaging services at DRMC</h2>
            <p class="small text-muted mb-3">@dept.Description</p>
            @if (dept.ServicesOffered is { Count: > 0 })
            {
                <ul class="small text-dark mb-3">
                    @foreach (var service in dept.ServicesOffered)
                    {
                        <li>@service</li>
                    }
                </ul>
            }
            <p class="small text-muted mb-3">
                <i class="bi bi-geo-alt-fill text-primary-drmc me-1" aria-hidden="true"></i>@dept.Location &middot;
                <i class="bi bi-telephone ms-1 me-1 text-primary-drmc" aria-hidden="true"></i>@dept.LocalExtension
            </p>
            <a asp-controller="Directory" asp-action="Department" asp-route-id="@dept.Name" class="btn btn-outline-drmc fw-semibold align-self-start">
                <i class="bi bi-building me-1" aria-hidden="true"></i> Radiology department and doctors
            </a>
        </section>
    </div>
</section>
