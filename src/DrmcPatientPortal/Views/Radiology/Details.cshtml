@model RadiologyDetailsViewModel
@{
    ViewData["Title"] = $"{Model.StudyName} — Imaging Study";
    var dept = Model.Department;
    var report = Model.Report;
}

<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> All imaging studies
            </a>
            <span class="text-white text-opacity-50">/</span>
            <span class="small text-white text-opacity-75">@Model.Modality.DisplayName()</span>
        </div>
        <h1 class="display-6 fw-bold mb-1">@Model.StudyName</h1>
        <p class="text-white text-opacity-90 mb-0">Accession Number: <strong>@Model.AccessionNumber</strong> &middot; Davao Regional Medical Center</p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 920px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">

            @if (Model.IsReady)
            {
                <div class="alert alert-success d-flex align-items-start gap-3 rounded-4 border-0 p-3 p-md-4 mb-4" role="status" data-testid="radiology-status-ready">
                    <div class="p-2 rounded-circle bg-success text-white d-inline-flex fs-4" style="flex-shrink:0;">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold text-success-emphasis mb-1">Ready for claiming</h2>
                        <p class="mb-0 small text-success-emphasis">
                            Your imaging report has been finalised and released by the radiologist. You can claim the official report at DRMC Radiology.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-start gap-3 rounded-4 border-0 p-3 p-md-4 mb-4" role="status" data-testid="radiology-status-pending">
                    <div class="p-2 rounded-circle bg-warning text-dark d-inline-flex fs-4" style="flex-shrink:0;">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                    </div>
                    <div>
                        <h2 class="h5 fw-bold text-warning-emphasis mb-1">Report in progress</h2>
                        <p class="mb-0 small text-warning-emphasis">
                            Your study is being read and reported by the radiologist. This page will show "Ready for claiming" once the report is released.
                        </p>
                    </div>
                </div>
            }

            @if (Model.IsAmended)
            {
                <div class="alert alert-info border-0 rounded-3 small mb-4" role="note" data-testid="radiology-amended">
                    <strong><i class="bi bi-pencil-square me-1" aria-hidden="true"></i> This report was amended.</strong>
                    The radiologist updated this report after it was first released. The official report you claim is the amended version.
                    @if (!string.IsNullOrWhiteSpace(report?.AmendmentNote))
                    {
                        <span class="d-block mt-1">Reason: @report.AmendmentNote</span>
                    }
                </div>
            }

            <!-- Study header -->
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 pb-3 mb-4 border-bottom">
                <div>
                    <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill small fw-semibold mb-2">@Model.Modality.DisplayName()</span>
                    <h2 class="h4 fw-bold text-dark mb-1">@Model.StudyName</h2>
                    <p class="text-muted small mb-0">
                        Accession Code: <strong class="text-dark font-monospace">@Model.AccessionNumber</strong>
                        @if (!string.IsNullOrEmpty(Model.BodyRegion))
                        {
                            <span> &middot; Body part: <strong class="text-dark">@Model.BodyRegion</strong></span>
                        }
                    </p>
                </div>
                <div class="text-md-end">
                    <div class="small text-muted" style="font-size: 0.85rem;">
                        <i class="bi bi-calendar3 me-1" aria-hidden="true"></i> Performed: <strong>@Model.PerformedAt.ToString("MMM d, yyyy h:mm tt")</strong>
                    </div>
                    @if (Model.ReleasedAt.HasValue)
                    {
                        <div class="small text-muted mt-1" style="font-size: 0.85rem;">
                            <i class="bi bi-check2-circle me-1 text-success" aria-hidden="true"></i> Released: <strong>@Model.ReleasedAt.Value.ToString("MMM d, yyyy h:mm tt")</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Attribution -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Requesting doctor</span>
                        <strong class="small text-dark">@(string.IsNullOrEmpty(Model.OrderingPhysician) ? "Attending physician" : Model.OrderingPhysician)</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Reporting radiologist</span>
                        <strong class="small text-dark">@(string.IsNullOrEmpty(Model.RadiologistName) ? "Shown once the report is released" : Model.RadiologistName)</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block" style="font-size: 0.75rem;">Performing unit</span>
                        <strong class="small text-dark">@(string.IsNullOrEmpty(Model.PerformingUnit) ? dept.Location : Model.PerformingUnit)</strong>
                    </div>
                </div>
            </div>

            @if (report is not null)
            {
                <section class="mb-4" aria-labelledby="radiologyReportHeading" data-testid="radiology-report">
                    <h3 id="radiologyReportHeading" class="h6 fw-bold text-primary-drmc mb-2">
                        <i class="bi bi-file-earmark-medical me-1" aria-hidden="true"></i> Radiology report
                    </h3>
                    <p class="small text-muted mb-3">This report is written for your doctor and uses medical terms. Please discuss it with your doctor.</p>
                    <div class="border rounded-3 p-3">
                        @foreach (var (heading, text) in new[]
                        {
                            ("Clinical indication", report.ClinicalIndication),
                            ("Technique", report.Technique),
                            ("Comparison", report.Comparison),
                            ("Findings", report.Findings),
                            ("Impression", report.Impression)
                        })
                        {
                            @if (!string.IsNullOrWhiteSpace(text))
                            {
                                <div class="radiology-report-section">
                                    <h4 class="small fw-bold text-dark text-uppercase mb-1">@heading</h4>
                                    <p class="small text-dark mb-0 radiology-report-text">@text</p>
                                </div>
                            }
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(report.PlainLanguageSummary))
                    {
                        <div class="p-3 mt-3 bg-light rounded-3 border-start border-3 border-primary-subtle" data-testid="radiology-plain-summary">
                            <h4 class="small fw-bold text-dark mb-1">Summary in plain language</h4>
                            <p class="small text-dark mb-0 radiology-report-text">@report.PlainLanguageSummary</p>
                        </div>
                    }
                </section>
            }

            <!-- Questions -->
            <section class="mb-4" aria-labelledby="radiologyQuestionsHeading">
                <h3 id="radiologyQuestionsHeading" class="h6 fw-bold text-primary-drmc mb-2">
                    <i class="bi bi-chat-dots me-1" aria-hidden="true"></i> Questions about your report
                </h3>
                <p class="small text-muted mb-2">
                    Your requesting doctor will explain what the result means for you. For questions about the study itself or claiming your report, contact DRMC Radiology.
                </p>
                <ul class="list-unstyled small text-dark mb-0 d-flex flex-column gap-1">
                    <li><i class="bi bi-geo-alt-fill text-primary-drmc me-1" aria-hidden="true"></i> @dept.Location</li>
                    <li><i class="bi bi-telephone text-primary-drmc me-1" aria-hidden="true"></i> @dept.LocalExtension</li>
                </ul>
            </section>

            <!-- Images and claiming. [UNVERIFIED: DRMC Radiology to confirm releasing window, hours and procedure.] -->
            <section class="mb-4" aria-labelledby="radiologyImagesHeading">
                <h3 id="radiologyImagesHeading" class="h6 fw-bold text-primary-drmc mb-2">
                    <i class="bi bi-images me-1" aria-hidden="true"></i> Images, films and CDs
                </h3>
                <div class="p-3 bg-light rounded-3 border small text-dark">
                    <p class="mb-2">The patient portal does not show imaging pictures.</p>
                    <p class="mb-2">Films, CDs and the official printed report are released by DRMC Radiology. Bring a valid ID and your accession number <code>@Model.AccessionNumber</code>.</p>
                    <p class="mb-0 text-muted">The releasing window, hours and claiming procedure are still to be confirmed by DRMC Radiology. Please call @dept.LocalExtension before you go.</p>
                </div>
            </section>

            <nav class="lab-result-actions pt-3 border-top" aria-label="Study actions">
                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Back to studies
                </a>
                <a asp-action="Index" fragment="radiologyPrepHeading" class="btn btn-outline-drmc fw-semibold">
                    <i class="bi bi-list-check me-1" aria-hidden="true"></i> Preparation guide
                </a>
                <a asp-controller="Directory" asp-action="Department" asp-route-id="@dept.Name" class="btn btn-outline-drmc fw-semibold">
                    <i class="bi bi-building me-1" aria-hidden="true"></i> Radiology department
                </a>
            </nav>
        </div>
    </div>
</section>
