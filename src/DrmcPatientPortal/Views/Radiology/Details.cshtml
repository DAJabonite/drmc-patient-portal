@model RadiologyDetailsViewModel
@{
    ViewData["Title"] = "Radiology report PDF";
}

<section class="page-header">
    <div class="container">
        <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>All radiology PDFs
        </a>
        <h1 class="display-6 fw-bold mt-2 mb-0">Radiology report PDF</h1>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 720px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <p class="small text-muted mb-1">
                Study date: <time datetime="@Model.PerformedAt.ToString("yyyy-MM-dd")">@Model.PerformedAt.ToString("MMM d, yyyy")</time>
            </p>
            <h2 class="h5 fw-bold text-primary-drmc">@Model.ModalityLabel</h2>
            <partial name="_PdfReportActions" model='new PdfReportActionsViewModel("Radiology", Model.Id, Model.ModalityLabel)' />
            <nav class="pt-3 mt-3 border-top" aria-label="Report actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to results</a>
            </nav>
        </div>
    </div>
</section>
