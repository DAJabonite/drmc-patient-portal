@model RadiologyPreparationViewModel
@{
    var preparation = Model.Guide.Content.Radiology!;
}
@* General guidance only. [UNVERIFIED: DRMC Radiology to confirm wording; no fasting hours, fees or schedules are stated on purpose.] *@
<section class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4" aria-labelledby="radiologyPrepHeading" data-testid="radiology-prep-guide">
    <h2 id="radiologyPrepHeading" class="h5 fw-bold text-dark mb-1">@Model.Guide.Content.Heading</h2>
    <p class="small text-muted mb-3">
        @preparation.IntroText
        @preparation.ContactPrefix <strong>@Model.Department.LocalExtension</strong>@preparation.ContactSuffix
    </p>

    <h3 class="h6 fw-bold text-primary-drmc">@preparation.GeneralHeading</h3>
    <ul class="small text-dark mb-3">
        @foreach (var item in preparation.GeneralItems)
        {
            <li>@item</li>
        }
    </ul>

    <div class="alert alert-warning border-0 rounded-3 small mb-3" role="note">
        <h3 class="h6 fw-bold mb-2"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i> @preparation.SafetyHeading</h3>
        <ul class="mb-0">
            @foreach (var notice in preparation.SafetyNotices)
            {
                <li>@notice</li>
            }
        </ul>
    </div>

    <h3 class="h6 fw-bold text-primary-drmc">@preparation.ModalityHeading</h3>
    <div class="d-flex flex-column gap-2">
        @foreach (var guide in preparation.Guides)
        {
            var icon = RadiologyPreparation.IconFor(guide.Key);
            <details class="border rounded-3 px-3 py-2 bg-light" id="prep-@guide.Key">
                <summary class="fw-semibold small text-dark py-1">
                    <i class="bi @icon me-1 text-primary-drmc" aria-hidden="true"></i> @guide.Title
                </summary>
                <ul class="small text-dark mt-2 mb-1">
                    @foreach (var item in guide.Items)
                    {
                        <li>@item</li>
                    }
                </ul>
            </details>
        }
    </div>
    <partial name="_GuideReview" model="Model.Guide" />
</section>
