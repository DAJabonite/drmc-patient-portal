@model TicketStatusViewModel
@{
    ViewData["Title"] = $"Queue Status — {Model.Ticket.TicketNumber}";
}

<section class="py-4 bg-primary-drmc text-white shadow-sm">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <a asp-action="Index" class="text-white text-opacity-75 text-decoration-none small">
                <i class="bi bi-arrow-left"></i> Back to Queue Board
            </a>
        </div>
        <h1 class="display-6 fw-bold mb-1">Ticket Tracker</h1>
        <p class="text-white text-opacity-90 mb-0">Live status for Ticket Number: <strong>@Model.Ticket.TicketNumber</strong></p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 680px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
            
            <div class="mb-3">
                <span class="badge bg-primary-subtle text-primary-drmc px-3 py-1 rounded-pill fw-semibold">
                    @Model.Ticket.Department
                </span>
            </div>

            <div class="display-3 fw-bolder text-primary-drmc mb-2">
                @Model.Ticket.TicketNumber
            </div>

            <div class="mb-4">
                @if (Model.Ticket.Status == QueueTicketStatus.Serving)
                {
                    <span class="badge bg-success px-4 py-2 fs-6 rounded-pill">
                        <i class="bi bi-person-check-fill me-1"></i> Currently Serving in @Model.Ticket.ClinicRoom
                    </span>
                }
                else if (Model.Ticket.Status == QueueTicketStatus.Called)
                {
                    <span class="badge bg-warning text-dark px-4 py-2 fs-6 rounded-pill">
                        <i class="bi bi-megaphone-fill me-1"></i> Number Called — Proceed to @Model.Ticket.ClinicRoom
                    </span>
                }
                else if (Model.Ticket.Status == QueueTicketStatus.Waiting)
                {
                    <span class="badge bg-info-subtle text-info-emphasis px-4 py-2 fs-6 rounded-pill">
                        <i class="bi bi-clock-history me-1"></i> In Waiting Queue
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary px-4 py-2 fs-6 rounded-pill">
                        Completed
                    </span>
                }
            </div>

            <!-- Estimated Wait & Position -->
            <div class="row g-3 mb-4 text-start">
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block mb-1">Patients Ahead</span>
                        <strong class="h4 fw-bold text-dark mb-0">@Model.PeopleAhead</strong>
                        <span class="small text-muted d-block" style="font-size:0.8rem;">in this clinic</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-light rounded-3 border h-100">
                        <span class="small text-muted d-block mb-1">Estimated Wait</span>
                        <strong class="h4 fw-bold text-primary-drmc mb-0">~@Model.EstimatedWaitMinutes mins</strong>
                        <span class="small text-muted d-block" style="font-size:0.8rem;">approximate</span>
                    </div>
                </div>
            </div>

            <!-- Details List -->
            <div class="p-3 bg-light rounded-3 text-start mb-4 border">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Assigned Clinic:</span>
                    <strong class="text-dark small">@Model.Ticket.Department (@Model.Ticket.ClinicRoom)</strong>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Issued Time:</span>
                    <strong class="text-dark small">@Model.Ticket.IssuedAt.ToLocalTime().ToString("h:mm tt")</strong>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Priority Classification:</span>
                    <strong class="small @(Model.Ticket.IsPriority ? "text-warning-emphasis" : "text-dark")">
                        @(Model.Ticket.IsPriority ? "Priority Lane (Senior/PWD/Pregnant)" : "Regular OPD Lane")
                    </strong>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-center">
                <button onclick="window.location.reload();" class="btn btn-primary-drmc fw-semibold px-4 rounded-pill">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh Status
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4 rounded-pill">
                    All Clinics
                </a>
            </div>

        </div>
    </div>
</section>
