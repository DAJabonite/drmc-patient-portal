@model BookingFormViewModel
@{
    ViewData["Title"] = Loc["Appt_Book"];
    var signedIn = User.Identity?.IsAuthenticated ?? false;
}

<!-- Hero Banner -->
<section class="page-header">
    <div class="container">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                <i class="bi bi-calendar-check-fill me-1"></i> @Loc["Appt_SelfService"]
            </span>
            <span class="small text-white text-opacity-75">@Loc["Appt_OutpatientModes"]</span>
        </div>
        <h1 class="display-6 fw-bold mb-0">@Loc["Appt_Schedule"]</h1>
    </div>
</section>

<!-- Main Booking Form -->
<section class="section py-5 bg-light">
    <div class="container content-narrow">
        
        @if (!signedIn)
        {
            <div class="alert alert-info booking-signin mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-person-check fs-4 text-primary-drmc"></i>
                    <span class="small text-dark">
                        @Loc["Appt_SignInHint"]
                    </span>
                </div>
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-primary-drmc rounded-pill px-3 fw-semibold">
                    @Loc["Appt_SignIn"]
                </a>
            </div>
        }

        <div class="card booking-card p-4 p-md-5 bg-white">
            <form asp-action="Book" method="post" id="bookingForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-4" role="alert"></div>

                <!-- Step 1: Service & Department -->
                <div class="booking-section">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width:28px;height:28px;">1</span>
                        <h2 class="h5 fw-bold text-primary-drmc mb-0">@Loc["Appt_SelectService"]</h2>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc["Appt_Mode"] <span class="text-danger">*</span></label>
                            <div class="consultation-mode-grid">
                                <div class="form-check custom-radio-card flex-fill p-3 rounded-3 border @(Model.AppointmentType == "In-Person OPD" ? "border-primary bg-primary-subtle bg-opacity-25" : "")">
                                    <input class="form-check-input" type="radio" asp-for="AppointmentType" value="In-Person OPD" id="typeInPerson" checked />
                                    <label class="form-check-label fw-bold text-dark d-block" for="typeInPerson">
                                        <i class="bi bi-hospital text-primary-drmc me-1"></i> @Loc["Appt_InPerson"]
                                        <span class="small text-muted fw-normal d-block" style="font-size:0.75rem;">@Loc["Appt_VisitClinic"]</span>
                                    </label>
                                </div>
                                <div class="form-check custom-radio-card flex-fill p-3 rounded-3 border @(Model.AppointmentType == "Teleconsultation" ? "border-primary bg-primary-subtle bg-opacity-25" : "")">
                                    <input class="form-check-input" type="radio" asp-for="AppointmentType" value="Teleconsultation" id="typeTeleconsult" />
                                    <label class="form-check-label fw-bold text-dark d-block" for="typeTeleconsult">
                                        <i class="bi bi-camera-video text-success me-1"></i> @Loc["Appt_Teleconsult"]
                                        <span class="small text-muted fw-normal d-block" style="font-size:0.75rem;">@Loc["Appt_OnlineVideo"]</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" for="departmentSelect" class="form-label fw-semibold text-dark small">@Loc["Appt_Department"] <span class="text-danger">*</span></label>
                            <select asp-for="Department" asp-items="Model.DepartmentList" class="form-select rounded-3 py-2" id="departmentSelect">
                            </select>
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DoctorId" class="form-label fw-semibold text-dark small">@Loc["Appt_Doctor"]</label>
                        <select asp-for="DoctorId" asp-items="Model.DoctorList" class="form-select rounded-3 py-2">
                            <option value="">-- @Loc["Appt_AnyDoctor"] --</option>
                        </select>
                        <span class="small text-muted" style="font-size:0.75rem;">
                            <i class="bi bi-info-circle me-1"></i> @Loc["Appt_DoctorHint"]
                        </span>
                    </div>
                </div>

                <!-- Step 2: Date & Time Selection -->
                <div class="booking-section">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width:28px;height:28px;">2</span>
                        <h2 class="h5 fw-bold text-primary-drmc mb-0">@Loc["Appt_ChooseSchedule"]</h2>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label asp-for="AppointmentDate" class="form-label fw-semibold text-dark small">@Loc["Appt_Date"] <span class="text-danger">*</span></label>
                            <input asp-for="AppointmentDate" type="date" class="form-control rounded-3 py-2"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.AddMonths(2).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="TimeSlot" class="form-label fw-semibold text-dark small">@Loc["Appt_Time"] <span class="text-danger">*</span></label>
                            <select asp-for="TimeSlot" class="form-select rounded-3 py-2">
                                @foreach (var slot in BookingFormViewModel.TimeSlots)
                                {
                                    <option value="@slot">@slot</option>
                                }
                            </select>
                            <span asp-validation-for="TimeSlot" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Step 3: Patient Information -->
                <div class="booking-section">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width:28px;height:28px;">3</span>
                        <h2 class="h5 fw-bold text-primary-drmc mb-0">@Loc["Appt_Contact"]</h2>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PatientName" class="form-label fw-semibold text-dark small">@Loc["Appt_FullName"] <span class="text-danger">*</span></label>
                            <input asp-for="PatientName" class="form-control rounded-3 py-2" autocomplete="name" placeholder="e.g. Maria Clara Santos" />
                            <span asp-validation-for="PatientName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactNumber" class="form-label fw-semibold text-dark small">@Loc["Appt_Mobile"] <span class="text-danger">*</span></label>
                            <input asp-for="ContactNumber" class="form-control rounded-3 py-2" inputmode="tel" autocomplete="tel" placeholder="0917 123 4567" />
                            <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                            <span class="small text-muted" style="font-size:0.75rem;">@Loc["Appt_SmsHint"]</span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold text-dark small">@Loc["Appt_Email"] <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control rounded-3 py-2" autocomplete="email" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhilHealthNumber" class="form-label fw-semibold text-dark small">@Loc["Appt_PhilHealth"]</label>
                            <input asp-for="PhilHealthNumber" class="form-control rounded-3 py-2" inputmode="numeric" placeholder="12-345678901-2" />
                            <span class="small text-muted" style="font-size:0.75rem;">For automatic PhilHealth Konsulta package coverage.</span>
                        </div>
                    </div>
                </div>

                <!-- Step 4: Medical Concern / Reason -->
                <div class="booking-section">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary-drmc text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width:28px;height:28px;">4</span>
                        <h2 class="h5 fw-bold text-primary-drmc mb-0">@Loc["Appt_Reason"]</h2>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ChiefComplaint" class="form-label fw-semibold text-dark small">@Loc["Appt_Describe"] <span class="text-danger">*</span></label>
                        <textarea asp-for="ChiefComplaint" rows="3" class="form-control rounded-3"
                                  placeholder="e.g. Follow-up consultation for high blood pressure; experiencing mild headaches and dizziness for 3 days."></textarea>
                        <span asp-validation-for="ChiefComplaint" class="text-danger small"></span>
                    </div>

                    <!-- Privacy & DOH Notice -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="privacyAgree" required checked />
                            <label class="form-check-label small text-muted" for="privacyAgree">
                                @Loc["Appt_PrivacyConsent"]
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-actions d-flex flex-wrap gap-3 align-items-center justify-content-between pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                        @Loc["Action_Cancel"]
                    </a>
                    <button type="submit" class="btn btn-primary-drmc btn-lg px-5 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> @Loc["Appt_Confirm"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
