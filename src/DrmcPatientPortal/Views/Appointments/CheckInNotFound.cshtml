@{
    ViewData["Title"] = "Invalid Check-In Pass";
}

<section class="page-header">
    <div class="container">
        <h1 class="display-6 fw-bold mb-0">Check-In Verification</h1>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 580px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white">
            <div class="p-3 rounded-circle bg-danger-subtle text-danger d-inline-flex mx-auto mb-3">
                <i class="bi bi-x-circle fs-1"></i>
            </div>
            <h2 class="h5 fw-bold text-dark mb-2">@Loc["Appt_UnavailableTitle"]</h2>
            <p class="text-muted small mb-4">
                @Loc["Appt_UnavailableBody"]
            </p>

            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a asp-action="Book" class="btn btn-primary-drmc fw-semibold rounded-pill px-4">
                    <i class="bi bi-calendar-plus me-1"></i> Book Appointment
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary fw-semibold rounded-pill px-3">
                    Return to Home
                </a>
            </div>
        </div>
    </div>
</section>
