@{
    ViewData["Title"] = "Emergency Medical Alert — DRMC";
}

<section class="py-5 bg-danger text-white shadow-sm">
    <div class="container text-center" style="max-width: 720px;">
        <div class="p-3 rounded-circle bg-white text-danger d-inline-flex mx-auto mb-3">
            <i class="bi bi-exclamation-triangle-fill display-4"></i>
        </div>
        <h1 class="display-5 fw-bold mb-2">Immediate Emergency Care Required</h1>
        <p class="lead text-white text-opacity-95 mb-0 fs-6">
            Based on your reported symptoms, you require immediate in-person emergency medical evaluation.
        </p>
    </div>
</section>

<section class="section py-5 bg-light">
    <div class="container" style="max-width: 680px;">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white text-center">
            
            <h2 class="h5 fw-bold text-danger mb-3">What You Must Do Immediately:</h2>

            <div class="p-4 bg-danger-subtle border border-danger border-opacity-25 rounded-4 text-start mb-4">
                <ol class="small text-dark mb-0 ps-3 leading-relaxed d-flex flex-column gap-2">
                    <li>
                        <strong>Proceed immediately to the DRMC Emergency Department (ED):</strong><br />
                        <span class="text-muted">DRMC Main Hospital Complex, Apokon, Tagum City, Davao del Norte (Open 24/7).</span>
                    </li>
                    <li>
                        <strong>Call the Emergency Helpline:</strong><br />
                        <span class="text-muted">Dial <strong>1555</strong> (National Emergency / DOH Hotline) or contact local emergency dispatch (911).</span>
                    </li>
                    <li>
                        <strong>Do not drive yourself:</strong><br />
                        <span class="text-muted">Have a family member, neighbor, or emergency ambulance transport you to the nearest hospital triage immediately.</span>
                    </li>
                </ol>
            </div>

            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a href="tel:1555" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow">
                    <i class="bi bi-telephone-fill me-2"></i> Call DOH Hotline: 1555
                </a>
                <a asp-controller="Patient" asp-action="Home" class="btn btn-outline-secondary rounded-pill px-4">
                    Return to Dashboard
                </a>
            </div>

        </div>
    </div>
</section>
