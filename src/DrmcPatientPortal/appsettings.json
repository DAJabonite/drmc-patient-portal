{
  "ConnectionStrings": {
    "DefaultConnection": "Server=CONFIGURE_VIA_ENVIRONMENT;Database=CONFIGURE_VIA_ENVIRONMENT;Integrated Security=True;Encrypt=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Portal": { "PublicOrigin": "" },
  "WebsiteUsage": { "Enabled": false, "RetentionMonths": 13 },
  "RedStar": { "WorkerEnabled": false, "RemindersEnabled": false, "MaximumAttempts": 5 },
  "Proxy": { "KnownProxies": [] },
  "AccountPrivacy": { "MinimumResponseMilliseconds": 250 },
  "AccountEmail": { "MaximumAttempts": 5, "LifetimeMinutes": 60, "RetentionDays": 7, "WorkerEnabled": true },
  "RateLimits": { "AuthenticationPerIp": 60, "AuthenticationPerAccount": 10, "EmailPerIp": 20, "EmailPerAccount": 3, "ScansPerIp": 5, "ScansPerUser": 5, "ConcurrentScans": 2, "PdfPerUser": 10 },
  "Ocr": { "NativeLibraryPath": "", "TessDataPath": "", "MaxConcurrency": 2, "MaxQueuedJobs": 2, "QueueWaitTimeout": "00:00:05", "ExtractionTimeout": "00:00:10" },
  "Identity": {
    "RequireConfirmedAccount": true
  },
  "PatientResults": {
    "ShowFullResults": false
  },
  "LabReports": { "RootPath": "App_Data/LabReports" },
  "PatientDocuments": {
    "RootPath": "App_Data/PatientIdDocuments",
    "TemporaryPath": "App_Data/TempUploads",
    "MaximumFileSizeMb": 5,
    "TemporaryFileLifetimeMinutes": 30
  },
  "DataProtection": {
    "KeyRingPath": "App_Data/DataProtectionKeys",
    "ProtectKeysWithDpapi": false
  },
  "Notifications": {
    "Email": { "Host": "", "Port": 587, "UseSsl": true, "Username": "", "Password": "", "FromAddress": "" },
    "Sms": { "Endpoint": "", "ApiKey": "", "SenderId": "DRMC" }
  }
}
